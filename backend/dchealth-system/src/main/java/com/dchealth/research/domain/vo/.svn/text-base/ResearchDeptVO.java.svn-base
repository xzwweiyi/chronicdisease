package com.dchealth.research.domain.vo;

import lombok.Data;

import java.util.List;

/**
 * 队列科室
 */
@Data
public class ResearchDeptVO {

    /**
     * 科室id
     */
    private Long deptId;

    /**
     * 父科室id
     */
    private Long parentDeptId;

    /**
     * 科室名称
     */
    private String deptName;

    /**
     * 是否勾选
     */
    private boolean check;

    /**
     * 子科室
     */
    private List<ResearchDeptVO> children;

    /**
     * 操作权限标识
     */
    private List<String> opers;


}
