package com.dchealth.system.domain.vo;

import lombok.Data;

/**
 * 医护工作实体
 * 
 */
@Data
public class MedicalWorkloadVo{
    /**
     * 用户ID
     */
    private Long userId;

    /**
     * 用户名称
     */
    private String nickName;

    /** 手机号码 */
    private String phonenumber;

    private String deptName;

    private String roleName;

    //管理队列数
    private Integer researchNums=0;

    //随访患者数
    private Integer patientNums=0;

    //入组审批量
    private Integer enrollmentHandleNums=0;

    //处理随访量
    private Integer setOpinionHandleNums=0;

    //处理预警量
    private Integer warnGuideNums=0;

    //处理超窗量
    private Integer visitTimeHandleNums=0;

    //质效评价-回复速度均分
    private String prescriptionBackScore="0";

    //质效评价-回复质量均分
    private String qualityBackScore="0";

    //患者评价-回复速度均分
    private String prescriptionScore="0";

    //患者评价-回复质量均分
    private String qualityScore="0";


}
