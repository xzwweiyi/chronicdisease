package com.dchealth.msgTip.domain;

import java.io.Serializable;
import java.util.Date;
import java.util.List;

/**
 * 随访消息提醒配置表(MsgReminderTask)实体类
 *
 * @author makejava
 * @since 2023-06-06 10:04:53
 */
public class MsgReminderTaskVO implements Serializable {
    private static final long serialVersionUID = -23125351913964732L;
    /**
     * 队列ID
     */
    private Long researchId;
    private List<MsgReminderTask> msgReminderTasks;

    public Long getResearchId() {
        return researchId;
    }

    public void setResearchId(Long researchId) {
        this.researchId = researchId;
    }

    public List<MsgReminderTask> getMsgReminderTasks() {
        return msgReminderTasks;
    }

    public void setMsgReminderTasks(List<MsgReminderTask> msgReminderTasks) {
        this.msgReminderTasks = msgReminderTasks;
    }
}

