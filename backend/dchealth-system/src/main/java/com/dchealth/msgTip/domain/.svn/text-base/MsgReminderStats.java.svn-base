package com.dchealth.msgTip.domain;

import java.io.Serializable;
import java.util.Date;

/**
 * 消息提醒统计表(MsgReminderStats)实体类
 *
 * @author makejava
 * @since 2023-06-06 17:46:23
 */
public class MsgReminderStats implements Serializable {
    private static final long serialVersionUID = 101352919728596878L;
    /**
     * 消息提醒统计表主键
     */
    private Long id;

    /**
     * 随访记录编号
     */
    private Long recordId;
    /**
     * 用户唯一编号：医生取sys_user.user_id  患者取patient_base_info.id
     */
    private Long userId;
    /**
     * 用户名称
     */
    private String userName;
    /**
     * 用户类型： 1医生 2患者
     */
    private Integer userType;
    /**
     * 消息总数
     */
    private Integer totalCount;
    /**
     * 随访提示消息总数
     */
    private Integer followReminderCount;
    /**
     * 超窗提醒消息总数
     */
    private Integer overTimeCount;
    /**
     * 预警提醒消息总数
     */
    private Integer warnEarlyCount;
    /**
     * 随访意见提醒消息总数
     */
    private Integer followOpinionCount;
    /**
     * 质疑提醒消息总数
     */
    private Integer questioningCount;
    /**
     * 入组提醒消息总数
     */
    private Integer joinGroupCount;
    /**
     * 质疑未处理消息总数
     */
    private Integer questioningUnprocessedCount;
    /**
     * 预警未处理消息总数
     */
    private Integer warnEarlyUnprocessedCount;
    /**
     * 随访未提交消息总数
     */
    private Integer followUnsubmitCount;
    /**
     * 满意度评价提醒消息总数
     */
    private Integer satisfactionEvaluationCount;
    /**
     * 随访处理任务提醒消息总数
     */
    private Integer followProcessingTasksCount;
    /**
     * 超窗处理任务提醒消息总数
     */
    private Integer overTimeProcessingCount;
    /**
     * 预警处理任务提醒消息总数
     */
    private Integer warnEarlyProcessingCount;

    private Date createTime;

    private Date updateTime;


    public Long getId() {
        return id;
    }

    public void setId(Long id) {
        this.id = id;
    }

    public Long getUserId() {
        return userId;
    }

    public void setUserId(Long userId) {
        this.userId = userId;
    }

    public String getUserName() {
        return userName;
    }

    public void setUserName(String userName) {
        this.userName = userName;
    }

    public Integer getUserType() {
        return userType;
    }

    public void setUserType(Integer userType) {
        this.userType = userType;
    }

    public Integer getTotalCount() {
        return totalCount;
    }

    public void setTotalCount(Integer totalCount) {
        this.totalCount = totalCount;
    }

    public Integer getFollowReminderCount() {
        return followReminderCount;
    }

    public Long getRecordId() {
        return recordId;
    }

    public void setRecordId(Long recordId) {
        this.recordId = recordId;
    }

    public void setFollowReminderCount(Integer followReminderCount) {
        this.followReminderCount = followReminderCount;
    }

    public Integer getOverTimeCount() {
        return overTimeCount;
    }

    public void setOverTimeCount(Integer overTimeCount) {
        this.overTimeCount = overTimeCount;
    }

    public Integer getWarnEarlyCount() {
        return warnEarlyCount;
    }

    public void setWarnEarlyCount(Integer warnEarlyCount) {
        this.warnEarlyCount = warnEarlyCount;
    }

    public Integer getFollowOpinionCount() {
        return followOpinionCount;
    }

    public void setFollowOpinionCount(Integer followOpinionCount) {
        this.followOpinionCount = followOpinionCount;
    }

    public Integer getQuestioningCount() {
        return questioningCount;
    }

    public void setQuestioningCount(Integer questioningCount) {
        this.questioningCount = questioningCount;
    }

    public Integer getJoinGroupCount() {
        return joinGroupCount;
    }

    public void setJoinGroupCount(Integer joinGroupCount) {
        this.joinGroupCount = joinGroupCount;
    }

    public Integer getQuestioningUnprocessedCount() {
        return questioningUnprocessedCount;
    }

    public void setQuestioningUnprocessedCount(Integer questioningUnprocessedCount) {
        this.questioningUnprocessedCount = questioningUnprocessedCount;
    }

    public Integer getWarnEarlyUnprocessedCount() {
        return warnEarlyUnprocessedCount;
    }

    public void setWarnEarlyUnprocessedCount(Integer warnEarlyUnprocessedCount) {
        this.warnEarlyUnprocessedCount = warnEarlyUnprocessedCount;
    }

    public Integer getFollowUnsubmitCount() {
        return followUnsubmitCount;
    }

    public void setFollowUnsubmitCount(Integer followUnsubmitCount) {
        this.followUnsubmitCount = followUnsubmitCount;
    }

    public Integer getSatisfactionEvaluationCount() {
        return satisfactionEvaluationCount;
    }

    public void setSatisfactionEvaluationCount(Integer satisfactionEvaluationCount) {
        this.satisfactionEvaluationCount = satisfactionEvaluationCount;
    }

    public Integer getFollowProcessingTasksCount() {
        return followProcessingTasksCount;
    }

    public void setFollowProcessingTasksCount(Integer followProcessingTasksCount) {
        this.followProcessingTasksCount = followProcessingTasksCount;
    }

    public Integer getOverTimeProcessingCount() {
        return overTimeProcessingCount;
    }

    public void setOverTimeProcessingCount(Integer overTimeProcessingCount) {
        this.overTimeProcessingCount = overTimeProcessingCount;
    }

    public Integer getWarnEarlyProcessingCount() {
        return warnEarlyProcessingCount;
    }

    public void setWarnEarlyProcessingCount(Integer warnEarlyProcessingCount) {
        this.warnEarlyProcessingCount = warnEarlyProcessingCount;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

}

