<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cms.mapper.CmsCollectionMapper">
    
    <resultMap type="CmsCollection" id="CmsCollectionResult">
        <result property="id"    column="id"    />
        <result property="accountId"    column="account_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="articleId"    column="article_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectCmsCollectionVo">
        select id, account_id, tenant_id, article_id, create_time from cms_collection
    </sql>

    <select id="selectCmsCollectionList" parameterType="CmsCollection" resultMap="CmsCollectionResult">
        <include refid="selectCmsCollectionVo"/>
        <where>  
            <if test="accountId != null "> and account_id = #{accountId}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
            <if test="articleId != null "> and article_id = #{articleId}</if>
        </where>
    </select>
    
    <select id="selectCmsCollectionById" parameterType="Long" resultMap="CmsCollectionResult">
        <include refid="selectCmsCollectionVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCmsCollection" parameterType="CmsCollection" useGeneratedKeys="true" keyProperty="id">
        insert into cms_collection
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="accountId != null">account_id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="articleId != null">article_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="accountId != null">#{accountId},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="articleId != null">#{articleId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateCmsCollection" parameterType="CmsCollection">
        update cms_collection
        <trim prefix="SET" suffixOverrides=",">
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsCollectionById" parameterType="Long">
        delete from cms_collection where id = #{id}
    </delete>

    <delete id="deleteCmsCollectionByIds" parameterType="String">
        delete from cms_collection where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>