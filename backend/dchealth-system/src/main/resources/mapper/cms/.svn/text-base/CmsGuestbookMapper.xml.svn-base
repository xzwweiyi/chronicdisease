<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cms.mapper.CmsGuestbookMapper">
    
    <resultMap type="CmsGuestbook" id="CmsGuestbookResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="accountId"    column="account_id"    />
        <result property="userName"    column="user_name"    />
        <result property="mobile"    column="mobile"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectCmsGuestbookVo">
        select g.id, g.content, g.account_id, g.user_name, g.mobile, g.tenant_id, g.create_time, g.del_flag,mp.person_name real_name
        from cms_guestbook g
        LEFT JOIN mp_patient_account mpa on g.account_id=mpa.account_id
        LEFT JOIN mp_person mp on mpa.person_id=mp.person_id
    </sql>

    <select id="selectCmsGuestbookList" parameterType="CmsGuestbook" resultMap="CmsGuestbookResult">
        <include refid="selectCmsGuestbookVo"/>
        where 1=1
        <if test="content != null  and content != ''"> and g.content like concat('%', #{content}, '%')</if>
        <if test="accountId != null "> and g.account_id = #{accountId}</if>
        <if test="userName != null  and userName != ''"> and g.user_name like concat('%', #{userName}, '%')</if>
        <if test="mobile != null  and mobile != ''"> and g.mobile like concat('%', #{mobile}, '%')</if>
        <if test="tenantId != null  and tenantId != ''"> and g.tenant_id = #{tenantId}</if>
        <if test="positionType != null  and positionType != ''"> and a.position_type = #{positionType}</if>
        <if test="delFlag != null  and delFlag != ''"> and g.del_flag = #{delFlag}</if>
        ${params.dataScope}
        order by create_time desc
    </select>

    <select id="selectCmsGuestbookById" parameterType="Long" resultMap="CmsGuestbookResult">
        <include refid="selectCmsGuestbookVo"/>
        where g.id = #{id}
    </select>
        
    <insert id="insertCmsGuestbook" parameterType="CmsGuestbook" useGeneratedKeys="true" keyProperty="id">
        insert into cms_guestbook
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="content != null">content,</if>
            <if test="accountId != null">account_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="mobile != null">mobile,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="content != null">#{content},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="mobile != null">#{mobile},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateCmsGuestbook" parameterType="CmsGuestbook">
        update cms_guestbook
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null">content = #{content},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="mobile != null">mobile = #{mobile},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsGuestbookById" parameterType="Long">
        delete from cms_guestbook where id = #{id}
    </delete>

    <delete id="deleteCmsGuestbookByIds" parameterType="String">
        delete from cms_guestbook where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updateDeleteByIds" parameterType="String">
        update cms_guestbook set del_flag='Y' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>