<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cms.mapper.CmsCommentMapper">
    
    <resultMap type="CmsComment" id="CmsCommentResult">
        <result property="id"    column="id"    />
        <result property="articleId"    column="article_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="accountId"    column="account_id"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="realName"    column="real_name"    />
        <result property="title"    column="title"    />
    </resultMap>

    <sql id="selectCmsCommentVo">
        select cc.id, cc.article_id, cc.tenant_id, cc.account_id, cc.content, cc.create_time, cc.del_flag,ca.title,a.real_name from cms_comment  cc ,cms_article ca ,account a where  cc.article_id= ca.id and cc.account_id = a.id
    </sql>

    <select id="selectCmsCommentList" parameterType="CmsComment" resultMap="CmsCommentResult">
        <include refid="selectCmsCommentVo"/>
        <if test="articleId != null "> and cc.article_id = #{articleId}</if>
        <if test="tenantId != null  and tenantId != ''"> and cc.tenant_id = #{tenantId}</if>
        <if test="accountId != null "> and cc.account_id = #{accountId}</if>
        <if test="content != null  and content != ''"> and cc.content like concat('%', #{content}, '%') </if>
        <if test="title != null  and title != ''"> and ca.title  like concat('%', #{title}, '%') </if>
        <if test="realName != null  and realName != ''"> and a.real_name like concat('%', #{realName}, '%')</if>
        ${params.dataScope}
        order by cc.create_time desc
    </select>

    <select id="selectCmsCommentById" parameterType="Long" resultMap="CmsCommentResult">
        <include refid="selectCmsCommentVo"/>
        and  cc.id = #{id}
    </select>
        
    <insert id="insertCmsComment" parameterType="CmsComment" useGeneratedKeys="true" keyProperty="id">
        insert into cms_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="articleId != null">article_id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="accountId != null">account_id,</if>
            <if test="content != null">content,</if>
            <if test="createTime != null">create_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="articleId != null">#{articleId},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="content != null">#{content},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateCmsComment" parameterType="CmsComment">
        update cms_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsCommentById" parameterType="Long">
        delete from cms_comment where id = #{id}
    </delete>

    <delete id="deleteCmsCommentByIds" parameterType="String">
        delete from cms_comment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>