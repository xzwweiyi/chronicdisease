<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.base.mapper.AppResearchMapper">

    <resultMap type="AppResearch" id="AppResearchResult">
        <result property="id"    column="id"    />
        <result property="researchId"    column="research_id"    />
        <result property="appId"    column="app_id"    />
    </resultMap>

    <sql id="selectAppResearchVo">
        select id, research_id, app_id from app_research
    </sql>

    <select id="selectAppResearchList" parameterType="AppResearch" resultMap="AppResearchResult">
        <include refid="selectAppResearchVo"/>
        <where>
            <if test="researchId != null "> and research_id = #{researchId}</if>
            <if test="appId != null "> and app_id = #{appId}</if>
        </where>
    </select>

    <select id="selectAppResearchById" parameterType="Long" resultMap="AppResearchResult">
        <include refid="selectAppResearchVo"/>
        where id = #{id}
    </select>

    <insert id="insertAppResearch" parameterType="AppResearch" useGeneratedKeys="true" keyProperty="id">
        insert into app_research
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="researchId != null">research_id,</if>
            <if test="appId != null">app_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="researchId != null">#{researchId},</if>
            <if test="appId != null">#{appId},</if>
        </trim>
    </insert>

    <update id="updateAppResearch" parameterType="AppResearch">
        update app_research
        <trim prefix="SET" suffixOverrides=",">
            <if test="researchId != null">research_id = #{researchId},</if>
            <if test="appId != null">app_id = #{appId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppResearchById" parameterType="Long">
        delete from app_research where id = #{id}
    </delete>

    <delete id="deleteAppResearchByIds" parameterType="String">
        delete from app_research where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>