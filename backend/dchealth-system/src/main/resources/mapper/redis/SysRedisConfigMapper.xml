<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.redis.mapper.SysRedisConfigMapper">

    <resultMap type="SysRedisConfig" id="SysRedisConfigResult">
        <result property="id"    column="id"    />
        <result property="host"    column="host"   jdbcType="VARCHAR" />
        <result property="port"    column="port"   jdbcType="INTEGER" />
        <result property="password"    column="password"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectSysRedisConfigVo">
        select id, host, port, password, name, status, create_time, create_by, update_time, update_by from sys_redis_config
    </sql>

    <select id="selectSysRedisConfigList" parameterType="SysRedisConfig" resultMap="SysRedisConfigResult">
        <include refid="selectSysRedisConfigVo"/>
        <where>
            <if test="host != null  and host != ''"> and host = #{host}</if>
            <if test="port !=0"> and port = #{port}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="selectSysRedisConfigById" parameterType="Long" resultMap="SysRedisConfigResult">
        <include refid="selectSysRedisConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertSysRedisConfig" parameterType="SysRedisConfig">
        insert into sys_redis_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="host != null and host != ''">host,</if>
            <if test="port != null">port,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="host != null and host != ''">#{host},</if>
            <if test="port != null">#{port},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <update id="updateSysRedisConfig" parameterType="SysRedisConfig">
        update sys_redis_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="host != null and host != ''">host = #{host},</if>
            <if test="port != null">port = #{port},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>


    <update id="updateSysRedisConfigPassword" parameterType="SysRedisConfig">
        update sys_redis_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="password != null and password != ''">password = #{password}</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysRedisConfigById" parameterType="Long">
        delete from sys_redis_config where id = #{id}
    </delete>

    <delete id="deleteSysRedisConfigByIds" parameterType="String">
        delete from sys_redis_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>