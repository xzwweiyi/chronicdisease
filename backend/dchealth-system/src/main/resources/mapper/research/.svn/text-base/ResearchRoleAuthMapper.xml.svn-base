<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.research.mapper.ResearchRoleAuthMapper">


    <resultMap type="ResearchRoleAuth" id="ResearchRoleAuthResult">
        <result property="roleId"     column="role_id"      />
        <result property="deptId"   column="dept_id"    />
        <result property="authType"   column="auth_type"    />
    </resultMap>

    <sql id="selectResearchRoleAuthVo">
        select id, role_id, dept_id ,auth_type from research_role_auth
    </sql>

    <delete id="deleteRoleDeptAuTh" parameterType="Long">
		delete from research_role_auth where role_id = #{roleId}
	</delete>

    <insert id="batchRoleAuth">
        insert into research_role_auth(role_id, dept_id, auth_type) values
        <foreach item="item" index="index" collection="auths" separator=",">
            (#{item.roleId},#{item.deptId},#{item.authType})
        </foreach>
    </insert>

    <select id="findRoleAuthByRoleIdAndDeptId" parameterType="Long" resultMap="ResearchRoleAuthResult">
        <include refid="selectResearchRoleAuthVo"/>
        where role_id = #{roleId} and dept_id = #{deptId}
    </select>

    <select id="findRoleAuthByRoleId" parameterType="Long" resultMap="ResearchRoleAuthResult">
        <include refid="selectResearchRoleAuthVo"/>
        where role_id = #{roleId}
    </select>

    <delete id="deleteRoleDeptAuthByRoleIdAndDeptIds" parameterType="Long">
        delete from research_role_auth where role_id = #{roleId} and  dept_id in
        <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
            #{deptId}
        </foreach>
    </delete>

    <delete id="deleteRoleDeptAuthByRoleIdAndDeptId" parameterType="Long">
        delete from research_role_auth where role_id = #{roleId} and  dept_id = #{deptId}
    </delete>

    <delete id="deleteRoleDeptAuThByRoleIds" parameterType="Long">
        delete from research_role_auth where role_id in
        <foreach collection="array" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

</mapper>
