<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.research.mapper.ResearchSourceMapper">

    <resultMap type="ResearchSource" id="ResearchSourceResult">
        <result property="sourceId"    column="source_id"                />
        <result property="sourceName"    column="source_name"          />
        <result property="parentId"    column="parent_id"          />
        <result property="component"    column="component"       />
        <result property="status"    column="status"        />
        <result property="perms"    column="perms"      />
        <result property="createBy"    column="create_by"  />
        <result property="createTime"    column="create_time"   />
        <result property="updateBy"    column="update_by"      />
        <result property="updateTime"    column="update_time"      />
        <result property="remark"    column="remark"          />
    </resultMap>


    <sql id="selectResearchSourceVo">
        select source_id, source_name, parent_id, component, status, perms, create_by, create_time, update_by, update_time, remark from research_source
    </sql>

    <select id="selectResearchSourceList" parameterType="ResearchSource" resultMap="ResearchSourceResult">
        <include refid="selectResearchSourceVo"/>
        <where>
            <if test="sourceName != null  and sourceName != ''"> and source_name like concat ('%', #{sourceName}, '%')</if>
            <if test="parentId != null  and parentId != ''"> and parent_id = #{parentId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="perms != null  and perms != ''"> and perms = #{perms}</if>
        </where>
    </select>

    <insert id="insertResearchSource" parameterType="ResearchSource" useGeneratedKeys="true" keyProperty="sourceId">
        insert into research_source
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sourceName != null">source_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="component != null">component,</if>
            <if test="status != null">status,</if>
            <if test="perms != null">perms,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sourceName != null">#{sourceName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="component != null">#{component},</if>
            <if test="status != null">#{status},</if>
            <if test="perms != null">#{perms},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateResearchSource" parameterType="ResearchSource">
        update research_source
        <trim prefix="SET" suffixOverrides=",">
            <if test="sourceName != null and sourceName !='' ">source_name = #{sourceName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="component != null and component !='' ">component = #{component},</if>
            <if test="status != null and status !=''">status = #{status},</if>
            <if test="perms != null and perms !='' ">perms = #{perms},</if>
            <if test="createBy != null and createBy !='' ">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null and createBy !='' ">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where source_id = #{sourceId}
    </update>

    <select id="findOneResearchSource" parameterType="Long" resultMap="ResearchSourceResult">
        <include refid="selectResearchSourceVo"/>
        where source_id = #{sourceId}
    </select>

    <select id="findResearchSourceBySourceIds" parameterType="Long" resultMap="ResearchSourceResult">
        <include refid="selectResearchSourceVo"/>
        where source_id in
        <foreach collection="sources" item="sourceId" open="(" separator="," close=")">
            #{sourceId}
        </foreach>
    </select>


    <select id="isHaveChildResearchSource" parameterType="Long" resultType="Integer">
	    select count(1) from research_source where parent_id = #{sourceId}
	</select>

    <delete id="deleteResearchSource" parameterType="Long">
	    delete from research_source where source_id = #{sourceId}
	</delete>

    <select id="findAllResearchSource"  resultMap="ResearchSourceResult">
        <include refid="selectResearchSourceVo"/>
	</select>

</mapper>