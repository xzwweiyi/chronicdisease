<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.template.mapper.FTemplatePropertyMapper">
    
    <resultMap type="FTemplateProperty" id="FTemplatePropertyResult">
        <result property="id"    column="id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="templateFormId"    column="template_form_id"    />
        <result property="attribute"    column="attribute"    />
        <result property="openProperty"    column="open_property"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="templateId"    column="template_id"    />
        <result property="sortNum"    column="sort_num"    />
    </resultMap>

    <sql id="selectFTemplatePropertyVo">
        select id, property_code, property_name, parent_id, property_type, dict_type, template_form_id, attribute, open_property, create_by, create_time,template_id,sort_num from f_template_property
    </sql>

    <select id="selectFTemplatePropertyList" parameterType="FTemplateProperty" resultMap="FTemplatePropertyResult">
        <include refid="selectFTemplatePropertyVo"/>
        <where>  
            <if test="propertyCode != null  and propertyCode != ''"> and property_code = #{propertyCode}</if>
            <if test="propertyName != null  and propertyName != ''"> and property_name like concat('%', #{propertyName}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="propertyType != null  and propertyType != ''"> and property_type = #{propertyType}</if>
            <if test="dictType != null  and dictType != ''"> and dict_type = #{dictType}</if>
            <if test="templateFormId != null "> and template_form_id = #{templateFormId}</if>
            <if test="templateId != null "> and template_id = #{templateId}</if>
            <if test="attribute != null  and attribute != ''"> and attribute = #{attribute}</if>
            <if test="openProperty != null  and openProperty != ''"> and open_property = #{openProperty}</if>
        </where>
    </select>
    
    <select id="selectFTemplatePropertyById" parameterType="Long" resultMap="FTemplatePropertyResult">
        <include refid="selectFTemplatePropertyVo"/>
        where id = #{id}
    </select>

    <select id="selectFTemplatePropertyByTemplateId" parameterType="Long" resultMap="FTemplatePropertyResult">
        <include refid="selectFTemplatePropertyVo"/>
        where template_id = #{templateId}
    </select>
        
    <insert id="insertFTemplateProperty" parameterType="FTemplateProperty" useGeneratedKeys="true" keyProperty="id">
        insert into f_template_property
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code,</if>
            <if test="propertyName != null and propertyName != ''">property_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="propertyType != null">property_type,</if>
            <if test="dictType != null">dict_type,</if>
            <if test="templateFormId != null">template_form_id,</if>
            <if test="attribute != null">attribute,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="templateId != null">template_id,</if>
            <if test="sortNum != null">sort_num,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">#{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">#{propertyName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="propertyType != null">#{propertyType},</if>
            <if test="dictType != null">#{dictType},</if>
            <if test="templateFormId != null">#{templateFormId},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="templateId != null">#{templateId},</if>
            <if test="sortNum != null">#{sortNum},</if>
         </trim>
    </insert>

    <update id="updateFTemplateProperty" parameterType="FTemplateProperty">
        update f_template_property
        <trim prefix="SET" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code = #{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">property_name = #{propertyName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="propertyType != null">property_type = #{propertyType},</if>
            <if test="dictType != null">dict_type = #{dictType},</if>
            <if test="templateFormId != null">template_form_id = #{templateFormId},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFTemplatePropertyById" parameterType="Long">
        delete from f_template_property where id = #{id}
    </delete>

    <delete id="deleteFTemplatePropertyByTemplateId" parameterType="Long">
        delete from f_template_property where template_id = #{id}
    </delete>

    <delete id="deleteFTemplatePropertyByFormId" parameterType="Long">
        delete from f_template_property where template_form_id = #{id}
    </delete>

    <delete id="deleteFTemplatePropertyByIds" parameterType="String">
        delete from f_template_property where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectFTemplatePropertyByTemFromId" parameterType="Long" resultMap="FTemplatePropertyResult">
        <include refid="selectFTemplatePropertyVo"/>
        where template_form_id = #{templateFormId}
    </select>


    <select id="selectPropertyNumsList" parameterType="FTemplateProperty" resultMap="FTemplatePropertyResult">
        select g.id, g.property_code, g.property_name, g.template_form_id,g.template_id,ftf.parent_id
        from f_template_property g
        inner join  f_template_form ftf on g.template_form_id=ftf.template_form_id
        <where>
            ftf.parent_id>0 and ftf.form_type!='2'
            <if test="templateId != null "> and g.template_id = #{templateId}</if>
        </where>
    </select>

</mapper>