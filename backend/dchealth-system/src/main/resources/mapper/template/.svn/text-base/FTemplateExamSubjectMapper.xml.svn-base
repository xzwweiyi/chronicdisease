<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.template.mapper.FTemplateExamSubjectMapper">

    <resultMap type="FTemplateExamSubject" id="FTemplateExamSubjectResult">
        <result property="id"    column="id"    />
        <result property="templateId"    column="template_id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="templateFormId"    column="template_form_id"    />
        <result property="attribute"    column="attribute"    />
        <result property="openProperty"    column="open_property"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="sortNum"    column="sort_num"    />
    </resultMap>

    <sql id="selectFTemplateExamSubjectVo">
        select id, template_id, property_code, property_name, parent_id, property_type, dict_type, template_form_id, attribute, open_property, create_by, create_time, sort_num from f_template_exam_subject
    </sql>

    <select id="selectFTemplateExamSubjectList" parameterType="FTemplateExamSubject" resultMap="FTemplateExamSubjectResult">
        <include refid="selectFTemplateExamSubjectVo"/>
        <where>
            <if test="templateId != null "> and template_id = #{templateId}</if>
            <if test="propertyCode != null  and propertyCode != ''"> and property_code = #{propertyCode}</if>
            <if test="propertyName != null  and propertyName != ''"> and property_name like concat('%', #{propertyName}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="propertyType != null  and propertyType != ''"> and property_type = #{propertyType}</if>
            <if test="dictType != null  and dictType != ''"> and dict_type = #{dictType}</if>
            <if test="templateFormId != null "> and template_form_id = #{templateFormId}</if>
            <if test="attribute != null  and attribute != ''"> and attribute = #{attribute}</if>
            <if test="openProperty != null  and openProperty != ''"> and open_property = #{openProperty}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
        </where>
    </select>

    <select id="selectFTemplateExamSubjectById" parameterType="Long" resultMap="FTemplateExamSubjectResult">
        <include refid="selectFTemplateExamSubjectVo"/>
        where id = #{id}
    </select>

    <insert id="insertFTemplateExamSubject" parameterType="FTemplateExamSubject" useGeneratedKeys="true" keyProperty="id">
        insert into f_template_exam_subject
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateId != null">template_id,</if>
            <if test="propertyCode != null and propertyCode != ''">property_code,</if>
            <if test="propertyName != null and propertyName != ''">property_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="propertyType != null">property_type,</if>
            <if test="dictType != null">dict_type,</if>
            <if test="templateFormId != null">template_form_id,</if>
            <if test="attribute != null">attribute,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="sortNum != null">sort_num,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateId != null">#{templateId},</if>
            <if test="propertyCode != null and propertyCode != ''">#{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">#{propertyName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="propertyType != null">#{propertyType},</if>
            <if test="dictType != null">#{dictType},</if>
            <if test="templateFormId != null">#{templateFormId},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="sortNum != null">#{sortNum},</if>
         </trim>
    </insert>

    <update id="updateFTemplateExamSubject" parameterType="FTemplateExamSubject">
        update f_template_exam_subject
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="propertyCode != null and propertyCode != ''">property_code = #{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">property_name = #{propertyName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="propertyType != null">property_type = #{propertyType},</if>
            <if test="dictType != null">dict_type = #{dictType},</if>
            <if test="templateFormId != null">template_form_id = #{templateFormId},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFTemplateExamSubjectById" parameterType="Long">
        delete from f_template_exam_subject where id = #{id}
    </delete>

    <delete id="deleteFTemplateExamSubjectByIds" parameterType="String">
        delete from f_template_exam_subject where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteFTemplateExamSubjectByTemplateFormId" parameterType="Long">
        delete from f_template_exam_subject where template_form_id = #{templateFormId}
    </delete>

    <select id="selectExamSubjectMaxSortNumByTemplateFormId" resultType="Integer" parameterType="Long">
        select max(sort_num) from f_template_exam_subject where template_form_id = #{templateFormId}
    </select>

    <select id="selectFTemplateExamSubjectByTemFromId" parameterType="Long" resultMap="FTemplateExamSubjectResult">
        <include refid="selectFTemplateExamSubjectVo"/>
        where template_form_id = #{templateFormId}
    </select>
</mapper>
