package com.dchealth.web.controller.redis;

import com.alibaba.fastjson2.JSON;
import com.dchealth.common.core.domain.AjaxResult;
import com.dchealth.common.core.redis.RedisCache;
import com.dchealth.common.utils.StringUtils;
import com.sun.org.apache.xpath.internal.operations.Bool;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

import javax.annotation.Resource;
import java.util.Map;
import java.util.Objects;

@RestController
@Slf4j
public class MiniProgramBannerShowController {

    @Resource
    private RedisTemplate<String, Object> redisTemplateSelect1;

    @RequestMapping(value = "settingIsShow",method = RequestMethod.POST)
    public AjaxResult setRedisCache(@RequestBody Map<String, Boolean> show) {
        log.info("入参 show={}", JSON.toJSONString(show));
        // 设置显示标志
        redisTemplateSelect1.opsForValue().set("isShow",show.get("show").toString());
        return AjaxResult.success();
    }

    @RequestMapping("getIsShow")
    public AjaxResult getIsShow() {
        AjaxResult ajaxResult = new AjaxResult();
        // 设置显示标志
        Object isShow = redisTemplateSelect1.opsForValue().get("isShow");
        log.info("获取开关缓存值isShow={}",isShow);
        if (Objects.isNull(isShow)) {
            isShow = "false";
        }
        ajaxResult.put("isShow", isShow);
        return ajaxResult;
    }
}
