<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.check.ViewPacsMapper">

    <resultMap type="com.dchealth.etl.domain.check.ViewPacs" id="ViewPacsMap">
        <result property="studyid" column="studyid" jdbcType="VARCHAR"/>
        <result property="checkdate" column="checkdate" jdbcType="TIMESTAMP"/>
        <result property="resultdate" column="resultdate" jdbcType="TIMESTAMP"/>
        <result property="deptname" column="deptname" jdbcType="VARCHAR"/>
        <result property="xxdm" column="xxdm" jdbcType="VARCHAR"/>
        <result property="xxmc" column="xxmc" jdbcType="VARCHAR"/>
        <result property="doctor" column="doctor" jdbcType="VARCHAR"/>
        <result property="desc" column="desc" jdbcType="VARCHAR"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="bgys" column="bgys" jdbcType="VARCHAR"/>
        <result property="bgsj" column="bgsj" jdbcType="VARCHAR"/>
        <result property="shdoctor" column="shdoctor" jdbcType="VARCHAR"/>
        <result property="shsj" column="shsj" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="ViewPacsMap">
        select
          studyid, checkdate, resultdate, deptname, xxdm, xxmc, doctor, desc, result, bgys, bgsj, shdoctor, shsj
        from view_pacs
        where  studyid = #{studyid}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="ViewPacsMap">
        select
          studyid, checkdate, resultdate, deptname, xxdm, xxmc, doctor, desc, result, bgys, bgsj, shdoctor, shsj
        from view_pacs
        <where>
            <if test="studyid != null and studyid != ''">
                and studyid = #{studyid}
            </if>
            <if test="checkdate != null">
                and checkdate = #{checkdate}
            </if>
            <if test="resultdate != null">
                and resultdate = #{resultdate}
            </if>
            <if test="deptname != null and deptname != ''">
                and deptname = #{deptname}
            </if>
            <if test="xxdm != null and xxdm != ''">
                and xxdm = #{xxdm}
            </if>
            <if test="xxmc != null and xxmc != ''">
                and xxmc = #{xxmc}
            </if>
            <if test="doctor != null and doctor != ''">
                and doctor = #{doctor}
            </if>
            <if test="desc != null and desc != ''">
                and desc = #{desc}
            </if>
            <if test="result != null and result != ''">
                and result = #{result}
            </if>
            <if test="bgys != null and bgys != ''">
                and bgys = #{bgys}
            </if>
            <if test="bgsj != null and bgsj != ''">
                and bgsj = #{bgsj}
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                and shdoctor = #{shdoctor}
            </if>
            <if test="shsj != null">
                and shsj = #{shsj}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from view_pacs
        <where>
            <if test="studyid != null and studyid != ''">
                and studyid = #{studyid}
            </if>
            <if test="checkdate != null">
                and checkdate = #{checkdate}
            </if>
            <if test="resultdate != null">
                and resultdate = #{resultdate}
            </if>
            <if test="deptname != null and deptname != ''">
                and deptname = #{deptname}
            </if>
            <if test="xxdm != null and xxdm != ''">
                and xxdm = #{xxdm}
            </if>
            <if test="xxmc != null and xxmc != ''">
                and xxmc = #{xxmc}
            </if>
            <if test="doctor != null and doctor != ''">
                and doctor = #{doctor}
            </if>
            <if test="desc != null and desc != ''">
                and desc = #{desc}
            </if>
            <if test="result != null and result != ''">
                and result = #{result}
            </if>
            <if test="bgys != null and bgys != ''">
                and bgys = #{bgys}
            </if>
            <if test="bgsj != null and bgsj != ''">
                and bgsj = #{bgsj}
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                and shdoctor = #{shdoctor}
            </if>
            <if test="shsj != null">
                and shsj = #{shsj}
            </if>
        </where>
    </select>

    <select id="querySyncInfoCount" resultType="java.lang.Long">
        select count(*)
        from 影像类结果
        <where>
            <if test="params.recordingDate != null and params.recordingDate != ''">
                and date_format(结论日期,'%Y-%m-%d') = #{params.recordingDate}
            </if>
        </where>
    </select>

    <select id="querySyncInfoByPage" resultMap="ViewPacsMap">
        select
        预约id studyid,检查日期 checkdate,结论日期 resultdate,科室名称 deptname,诊疗项目代码 xxdm,诊疗项目名称 xxmc,检查医生 doctor,检查所见 `desc`,诊断结论 result,报告医生 bgys,报告时间 bgsj,审核医生 shdoctor,审核时间 shsj
        from 影像类结果
        <where>
            <if test="viewPacs.params.recordingDate != null and viewPacs.params.recordingDate != ''">
                and date_format(结论日期,'%Y-%m-%d') = #{viewPacs.params.recordingDate}
            </if>
        </where>
        order by 结论日期
        limit #{pageable.offset}, #{pageable.pageSize}

    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="" useGeneratedKeys="true">
        insert into view_pacs(studyid, checkdate, resultdate, deptname, xxdm, xxmc, doctor, desc, result, bgys, bgsj, shdoctor, shsj)
        values (#{studyid}, #{checkdate}, #{resultdate}, #{deptname}, #{xxdm}, #{xxmc}, #{doctor}, #{desc}, #{result}, #{bgys}, #{bgsj}, #{shdoctor}, #{shsj})
    </insert>

    <insert id="insertBatch" keyProperty="" useGeneratedKeys="true">
        insert into view_pacs(studyid, checkdate, resultdate, deptname, xxdm, xxmc, doctor, desc, result, bgys, bgsj, shdoctor, shsj)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyid}, #{entity.checkdate}, #{entity.resultdate}, #{entity.deptname}, #{entity.xxdm}, #{entity.xxmc}, #{entity.doctor}, #{entity.desc}, #{entity.result}, #{entity.bgys}, #{entity.bgsj}, #{entity.shdoctor}, #{entity.shsj})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="" useGeneratedKeys="true">
        insert into view_pacs(studyid, checkdate, resultdate, deptname, xxdm, xxmc, doctor, desc, result, bgys, bgsj, shdoctor, shsj)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.studyid}, #{entity.checkdate}, #{entity.resultdate}, #{entity.deptname}, #{entity.xxdm}, #{entity.xxmc}, #{entity.doctor}, #{entity.desc}, #{entity.result}, #{entity.bgys}, #{entity.bgsj}, #{entity.shdoctor}, #{entity.shsj})
        </foreach>
        on duplicate key update
        studyid = values(studyid),
        checkdate = values(checkdate),
        resultdate = values(resultdate),
        deptname = values(deptname),
        xxdm = values(xxdm),
        xxmc = values(xxmc),
        doctor = values(doctor),
        desc = values(desc),
        result = values(result),
        bgys = values(bgys),
        bgsj = values(bgsj),
        shdoctor = values(shdoctor),
        shsj = values(shsj)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update view_pacs
        <set>
            <if test="studyid != null and studyid != ''">
                studyid = #{studyid},
            </if>
            <if test="checkdate != null">
                checkdate = #{checkdate},
            </if>
            <if test="resultdate != null">
                resultdate = #{resultdate},
            </if>
            <if test="deptname != null and deptname != ''">
                deptname = #{deptname},
            </if>
            <if test="xxdm != null and xxdm != ''">
                xxdm = #{xxdm},
            </if>
            <if test="xxmc != null and xxmc != ''">
                xxmc = #{xxmc},
            </if>
            <if test="doctor != null and doctor != ''">
                doctor = #{doctor},
            </if>
            <if test="desc != null and desc != ''">
                desc = #{desc},
            </if>
            <if test="result != null and result != ''">
                result = #{result},
            </if>
            <if test="bgys != null and bgys != ''">
                bgys = #{bgys},
            </if>
            <if test="bgsj != null and bgsj != ''">
                bgsj = #{bgsj},
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                shdoctor = #{shdoctor},
            </if>
            <if test="shsj != null">
                shsj = #{shsj},
            </if>
        </set>
        where  studyid = #{studyid}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from view_pacs where studyid = #{studyid}
    </delete>

</mapper>

