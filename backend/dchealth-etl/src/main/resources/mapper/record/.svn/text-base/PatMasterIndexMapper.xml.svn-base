    <select id="querySyncInfoByPage" resultMap="PatMasterIndexMap">
        select
        patient_id, inp_no, name, name_phonetic, sex, date_of_birth, birth_place, nation, id_no, identity, charge_type, unit_in_contract, mailing_address, zip_code, phone_number_home, phone_number_business, next_of_kin, relationship, next_of_kin_addr, next_of_kin_zip_code, next_of_kin_phone, last_visit_date, vip_indicator, create_date, operator, card_status, rundcode, bankflag, bankcard_no, secret_level, citizenship, Column1
        from pat_master_index
        <where>
            <if test="patMasterIndex.patientId != null and patMasterIndex.patientId != ''">
                and patient_id > #{patMasterIndex.patientId}
            </if>

        </where>
        order by patient_id
        limit #{pageable.pageSize}
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="" useGeneratedKeys="true">
        insert into pat_master_index(patient_id, inp_no, name, name_phonetic, sex, date_of_birth, birth_place, nation, id_no, identity, charge_type, unit_in_contract, mailing_address, zip_code, phone_number_home, phone_number_business, next_of_kin, relationship, next_of_kin_addr, next_of_kin_zip_code, next_of_kin_phone, last_visit_date, vip_indicator, create_date, operator, card_status, rundcode, bankflag, bankcard_no, secret_level, citizenship, Column1)
        values (#{patientId}, #{inpNo}, #{name}, #{namePhonetic}, #{sex}, #{dateOfBirth}, #{birthPlace}, #{nation}, #{idNo}, #{identity}, #{chargeType}, #{unitInContract}, #{mailingAddress}, #{zipCode}, #{phoneNumberHome}, #{phoneNumberBusiness}, #{nextOfKin}, #{relationship}, #{nextOfKinAddr}, #{nextOfKinZipCode}, #{nextOfKinPhone}, #{lastVisitDate}, #{vipIndicator}, #{createDate}, #{operator}, #{cardStatus}, #{rundcode}, #{bankflag}, #{bankcardNo}, #{secretLevel}, #{citizenship}, #{column1})
    </insert>

    <insert id="insertBatch" keyProperty="" useGeneratedKeys="true">
        insert into pat_master_index(patient_id, inp_no, name, name_phonetic, sex, date_of_birth, birth_place, nation, id_no, identity, charge_type, unit_in_contract, mailing_address, zip_code, phone_number_home, phone_number_business, next_of_kin, relationship, next_of_kin_addr, next_of_kin_zip_code, next_of_kin_phone, last_visit_date, vip_indicator, create_date, operator, card_status, rundcode, bankflag, bankcard_no, secret_level, citizenship, Column1)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.patientId}, #{entity.inpNo}, #{entity.name}, #{entity.namePhonetic}, #{entity.sex}, #{entity.dateOfBirth}, #{entity.birthPlace}, #{entity.nation}, #{entity.idNo}, #{entity.identity}, #{entity.chargeType}, #{entity.unitInContract}, #{entity.mailingAddress}, #{entity.zipCode}, #{entity.phoneNumberHome}, #{entity.phoneNumberBusiness}, #{entity.nextOfKin}, #{entity.relationship}, #{entity.nextOfKinAddr}, #{entity.nextOfKinZipCode}, #{entity.nextOfKinPhone}, #{entity.lastVisitDate}, #{entity.vipIndicator}, #{entity.createDate}, #{entity.operator}, #{entity.cardStatus}, #{entity.rundcode}, #{entity.bankflag}, #{entity.bankcardNo}, #{entity.secretLevel}, #{entity.citizenship}, #{entity.column1})
        </foreach>
    </insert>

