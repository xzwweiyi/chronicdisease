    <!--查询单个-->
    <select id="queryById" resultMap="PatMasterIndexMap">
        select
          patient_id, inp_no, name, name_phonetic, sex, date_of_birth, birth_place, nation, id_no, identity, charge_type, unit_in_contract, mailing_address, zip_code, phone_number_home, phone_number_business, next_of_kin, relationship, next_of_kin_addr, next_of_kin_zip_code, next_of_kin_phone, last_visit_date, vip_indicator, create_date, operator, card_status, rundcode, bankflag, bankcard_no, secret_level, citizenship, Column1
        from pat_master_index
        where patient_id = #{patientId}
    </select>

