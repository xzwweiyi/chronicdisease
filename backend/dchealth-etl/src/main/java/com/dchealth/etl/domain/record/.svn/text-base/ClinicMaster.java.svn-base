package com.dchealth.etl.domain.record;

import com.dchealth.etl.domain.BaseEntity;

import java.util.Date;
import java.io.Serializable;

/**
 * 就诊记录(ClinicMaster)实体类
 *
 * @author makejava
 * @since 2023-05-18 15:34:47
 */
public class ClinicMaster extends BaseEntity implements Serializable {
    private static final long serialVersionUID = 214422934552797880L;
    /**
     * 就诊日期
     */
    private Date visitDate;
    /**
     * 就诊序号
     */
    private Integer visitNo;
    /**
     * 病人标识	号
     */
    private String patientId;


    public Date getVisitDate() {
        return visitDate;
    }

    public void setVisitDate(Date visitDate) {
        this.visitDate = visitDate;
    }

    public Integer getVisitNo() {
        return visitNo;
    }

    public void setVisitNo(Integer visitNo) {
        this.visitNo = visitNo;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

}

