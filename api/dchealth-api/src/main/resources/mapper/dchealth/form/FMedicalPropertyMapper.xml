<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.form.mapper.FMedicalPropertyMapper">
    
    <resultMap type="com.dchealth.cro.form.domain.FMedicalProperty" id="FMedicalPropertyResult">
        <result property="id"    column="id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="medicalFormId"    column="medical_form_id"    />
        <result property="openProperty"    column="open_property"    />
        <result property="attribute"    column="attribute"    />
        <result property="followId"    column="follow_id"    />
        <result property="sortNum"    column="sort_num"    />
    </resultMap>

    <sql id="selectFMedicalPropertyVo">
        select id, property_code, property_name, parent_id, property_type, dict_type, medical_form_id, open_property, attribute, create_by, create_time, follow_id, sort_num from f_medical_property
    </sql>

    <select id="selectFMedicalPropertyList" parameterType="com.dchealth.cro.form.domain.FMedicalProperty" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        <where>  
            <if test="propertyCode != null  and propertyCode != ''"> and property_code = #{propertyCode}</if>
            <if test="propertyName != null  and propertyName != ''"> and property_name like concat('%', #{propertyName}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="propertyType != null  and propertyType != ''"> and property_type = #{propertyType}</if>
            <if test="dictType != null  and dictType != ''"> and dict_type = #{dictType}</if>
            <if test="medicalFormId != null "> and medical_form_id = #{medicalFormId}</if>
            <if test="openProperty != null  and openProperty != ''"> and open_property = #{openProperty}</if>
            <if test="attribute != null  and attribute != ''"> and attribute = #{attribute}</if>
            <if test="followId != null "> and follow_id = #{followId}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
             and is_deleted = 0
        </where>
    </select>
    
    <select id="selectFMedicalPropertyById" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where id = #{id}
    </select>

    <select id="selectFMedicalPropertyByFollowId" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where follow_id = #{followId} and is_deleted = 0 order by sort_num asc
    </select>
        
    <insert id="insertFMedicalProperty" parameterType="com.dchealth.cro.form.domain.FMedicalProperty" useGeneratedKeys="true" keyProperty="id">
        insert into f_medical_property
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code,</if>
            <if test="propertyName != null and propertyName != ''">property_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="propertyType != null">property_type,</if>
            <if test="dictType != null">dict_type,</if>
            <if test="medicalFormId != null">medical_form_id,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="attribute != null">attribute,</if>
            <if test="followId != null">follow_id,</if>
            <if test="sortNum != null">sort_num,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">#{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">#{propertyName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="propertyType != null">#{propertyType},</if>
            <if test="dictType != null">#{dictType},</if>
            <if test="medicalFormId != null">#{medicalFormId},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="followId != null">#{followId},</if>
            <if test="sortNum != null">#{sortNum},</if>
         </trim>
    </insert>

    <update id="updateFMedicalProperty" parameterType="com.dchealth.cro.form.domain.FMedicalProperty">
        update f_medical_property
        <trim prefix="SET" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code = #{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">property_name = #{propertyName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="propertyType != null">property_type = #{propertyType},</if>
            <if test="dictType != null">dict_type = #{dictType},</if>
            <if test="medicalFormId != null">medical_form_id = #{medicalFormId},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="followId != null">follow_id = #{followId},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteFMedicalPropertyById" parameterType="Long">
        update f_medical_property set is_deleted = 1 where id = #{id}
    </update>

    <update id="deleteFMedicalPropertyByIds" parameterType="String">
        update f_medical_property set is_deleted = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>