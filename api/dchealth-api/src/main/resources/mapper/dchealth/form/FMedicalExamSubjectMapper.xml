<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.form.mapper.FMedicalExamSubjectMapper">
    
    <resultMap type="com.dchealth.cro.form.domain.FMedicalExamSubject" id="FMedicalExamSubjectResult">
        <result property="id"    column="id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="medicalFormId"    column="medical_form_id"    />
        <result property="openProperty"    column="open_property"    />
        <result property="attribute"    column="attribute"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="ifScore"    column="if_score"    />
        <result property="subjectScores"    column="subject_scores"    />
    </resultMap>
    <resultMap type="com.dchealth.cro.form.domain.FMedicalExamSubject" id="FMedicalExamSubjectAndItemResult">
        <result property="id"    column="id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="medicalFormId"    column="medical_form_id"    />
        <result property="openProperty"    column="open_property"    />
        <result property="attribute"    column="attribute"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="ifScore"    column="if_score"    />
        <result property="subjectScores"    column="subject_scores"    />
        <collection property="itemList" javaType="java.util.ArrayList" ofType="FMedicalExamItem"
                    column="id" select="selectFMedicalExamItemsByPropertyId"/>
    </resultMap>
    <resultMap type="com.dchealth.cro.form.domain.FMedicalExamItem" id="FMedicalExamItemResult">
        <result property="id" column="id"/>
        <result property="propertyId" column="property_id"/>
        <result property="itemValue" column="item_value"/>
        <result property="itemLabel" column="item_label"/>
        <result property="orderNum" column="order_num"/>
        <result property="createTime" column="create_time"/>
        <result property="itemScores" column="item_scores"/>
        <result property="medicalFormId" column="medical_form_id"/>
    </resultMap>
    <sql id="selectFMedicalExamSubjectVo">
        select id, property_code, property_name, parent_id, property_type, dict_type, medical_form_id, open_property, attribute, create_by, create_time, sort_num, if_score, subject_scores from f_medical_exam_subject
    </sql>
    <select id="selectFMedicalExamItemsByPropertyId" parameterType="Long" resultMap="FMedicalExamItemResult">
        select id,
               property_id,
               item_value,
               item_label,
               order_num,
               create_time,
               item_scores,
               medical_form_id
        from f_medical_exam_item  where property_id=#{id}
    </select>
    <select id="selectFMedicalExamSubjectList" parameterType="com.dchealth.cro.form.domain.FMedicalExamSubject" resultMap="FMedicalExamSubjectResult">
        <include refid="selectFMedicalExamSubjectVo"/>
        <where>  
            <if test="propertyCode != null  and propertyCode != ''"> and property_code = #{propertyCode}</if>
            <if test="propertyName != null  and propertyName != ''"> and property_name like concat('%', #{propertyName}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="propertyType != null  and propertyType != ''"> and property_type = #{propertyType}</if>
            <if test="dictType != null  and dictType != ''"> and dict_type = #{dictType}</if>
            <if test="medicalFormId != null "> and medical_form_id = #{medicalFormId}</if>
            <if test="openProperty != null  and openProperty != ''"> and open_property = #{openProperty}</if>
            <if test="attribute != null  and attribute != ''"> and attribute = #{attribute}</if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>
            <if test="ifScore != null  and ifScore != ''"> and if_score = #{ifScore}</if>
        </where>
    </select>

    <select id="selectFMedicalPropertyByFollowId" parameterType="Long" resultMap="FMedicalExamSubjectAndItemResult">
        SELECT
            fmes.id,
            fmes.property_code,
            fmes.property_name,
            fmes.parent_id,
            fmes.property_type,
            fmes.dict_type,
            fmes.medical_form_id,
            fmes.open_property,
            fmes.attribute,
            fmes.create_by,
            fmes.create_time,
            fmes.follow_id,
            fmes.sort_num,
            fmes.if_score,
            fmes.subject_scores
        FROM
            f_medical_exam_subject AS fmes
        WHERE
            fmes.follow_id =#{followId}
    </select>

    <select id="selectFMedicalExamSubjectById" parameterType="Long" resultMap="FMedicalExamSubjectResult">
        <include refid="selectFMedicalExamSubjectVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertFMedicalExamSubject" parameterType="com.dchealth.cro.form.domain.FMedicalExamSubject" useGeneratedKeys="true" keyProperty="id">
        insert into f_medical_exam_subject
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code,</if>
            <if test="propertyName != null and propertyName != ''">property_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="propertyType != null">property_type,</if>
            <if test="dictType != null">dict_type,</if>
            <if test="medicalFormId != null">medical_form_id,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="attribute != null">attribute,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="ifScore != null">if_score,</if>
            <if test="subjectScores != null">subject_scores,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">#{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">#{propertyName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="propertyType != null">#{propertyType},</if>
            <if test="dictType != null">#{dictType},</if>
            <if test="medicalFormId != null">#{medicalFormId},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="ifScore != null">#{ifScore},</if>
            <if test="subjectScores != null">#{subjectScores},</if>
         </trim>
    </insert>

    <update id="updateFMedicalExamSubject" parameterType="com.dchealth.cro.form.domain.FMedicalExamSubject">
        update f_medical_exam_subject
        <trim prefix="SET" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code = #{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">property_name = #{propertyName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="propertyType != null">property_type = #{propertyType},</if>
            <if test="dictType != null">dict_type = #{dictType},</if>
            <if test="medicalFormId != null">medical_form_id = #{medicalFormId},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="ifScore != null">if_score = #{ifScore},</if>
            <if test="subjectScores != null">subject_scores = #{subjectScores},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFMedicalExamSubjectById" parameterType="Long">
        delete from f_medical_exam_subject where id = #{id}
    </delete>

    <delete id="deleteFMedicalExamSubjectByIds" parameterType="String">
        delete from f_medical_exam_subject where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectFMedicalExamSubjectByFromId" parameterType="Long" resultMap="FMedicalExamSubjectResult">
        <include refid="selectFMedicalExamSubjectVo"/>
        where medical_form_id = #{medicalFormId}
    </select>

    <select id="selectExamSubjectMaxSortNumByFromId" resultType="Integer" parameterType="Long">
        select max(sort_num) from f_medical_exam_subject where medical_form_id = #{medicalFormId}
    </select>

    <select id="queryStatisticalData" resultType="com.dchealth.cro.form.domain.FMedicalExamSubject">
            SELECT s.property_name  as propertyName,
                   s.property_code  as propertyCode,
                   s.dict_type      as dictType,
                   s.medical_form_id as medicalFormId,
                   a.property_id as propertyId,
                   a.property_value as name,
                   s.id,
                   count(*) AS value
            FROM
                f_medical_exam_subject s left join
                ${tableName} a
            on a.property_id = s.id
            where
                s.medical_form_id = #{medicalFormId}
            GROUP BY
                s.property_name,
                a.property_value
    </select>

    <delete id="deleteFMedicalExamSubjectByMedicalFormId" parameterType="Long">
        delete from f_medical_exam_subject where medical_form_id = #{medicalFormId}
    </delete>

</mapper>