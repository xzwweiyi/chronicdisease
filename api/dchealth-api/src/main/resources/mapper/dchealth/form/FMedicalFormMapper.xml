<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.form.mapper.FMedicalFormMapper">

    <resultMap type="com.dchealth.cro.form.domain.FMedicalForm" id="FMedicalFormResult">
        <result property="medicalFormId" column="medical_form_id"/>
        <result property="followId" column="follow_id"/>
        <result property="medicalCode" column="medical_code"/>
        <result property="medicalName" column="medical_name"/>
        <result property="parentId" column="parent_id"/>
        <result property="openImage" column="open_image"/>
        <result property="openProperty" column="open_property"/>
        <result property="openMultiple" column="open_multiple"/>
        <result property="attribute" column="attribute"/>
        <result property="versionCode" column="version_code"/>
        <result property="formType" column="form_type"/>
        <result property="articleId" column="article_id"/>
        <result property="formSource" column="form_source"/>
        <result property="dynamic" column="dynamic"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="checked" column="checked"/>
        <result property="openCollapse" column="open_collapse"/>
        <result property="selfEvaluationType" column="self_evaluation_type"/>
        <result property="healthManageType" column="health_manage_type"/>
    </resultMap>

    <sql id="selectFMedicalFormVo">
        select medical_form_id,
               follow_id,
               medical_code,
               medical_name,
               parent_id,
               open_image,
               open_property,
               open_multiple,
               attribute,
               version_code,
               form_type,
               article_id,
               form_source,
               dynamic,
               create_time,
               update_time,
               create_by,
               update_by,
               health_manage_type,
               open_collapse
        from f_medical_form
    </sql>

    <select id="selectFMedicalFormList" parameterType="com.dchealth.cro.form.domain.FMedicalForm"
            resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        <where>
            <if test="followId != null ">and follow_id = #{followId}</if>
            <if test="medicalCode != null  and medicalCode != ''">and medical_code = #{medicalCode}</if>
            <if test="medicalName != null  and medicalName != ''">and medical_name like concat('%', #{medicalName},
                '%')
            </if>
            <if test="parentId != null ">and parent_id = #{parentId}</if>
            <if test="openImage != null  and openImage != ''">and open_image = #{openImage}</if>
            <if test="openProperty != null  and openProperty != ''">and open_property = #{openProperty}</if>
            <if test="openMultiple != null  and openMultiple != ''">and open_multiple = #{openMultiple}</if>
            <if test="attribute != null  and attribute != ''">and attribute = #{attribute}</if>
            <if test="versionCode != null  and versionCode != ''">and version_code = #{versionCode}</if>
            <if test="formType != null  and formType != ''">and form_type = #{formType}</if>
            <if test="articleId != null ">and article_id = #{articleId}</if>
            <if test="formSource != null  and formSource != ''">and form_source = #{formSource}</if>
            <if test="dynamic != null  and dynamic != ''">and dynamic = #{dynamic}</if>
        </where>
    </select>

    <select id="selectFMedicalFormByMedicalFormId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where medical_form_id = #{medicalFormId}
    </select>

    <select id="selectFMedicalFormByMedicalFollowId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId} and form_type != '5'
    </select>

    <select id="selectFMedicalFormJoinByMedicalFollowId" parameterType="Long" resultMap="FMedicalFormResult">
        select DISTINCT m.medical_form_id,
                        m.follow_id,
                        m.medical_code,
                        m.medical_name,
                        m.parent_id,
                        m.open_image,
                        m.open_property,
                        m.open_multiple,
                        m.attribute,
                        m.version_code,
                        m.form_type,
                        m.article_id,
                        m.form_source,
                        m.dynamic,
                        m.create_time,
                        m.update_time,
                        m.create_by,
                        m.update_by,
                        if(q.question_id, 1, 0) as checked,
                        open_collapse
        from f_medical_form m
                 left join question_record_form q on q.medical_form_id = m.medical_form_id and q.record_id = #{recordId}
        where m.follow_id = #{followId} and m.form_type != '5'
        ORDER BY m.sort_num, m.create_time asc
    </select>

    <select id="selectFMedicalHealthFormJoinByMedicalFollowId"
            resultType="com.dchealth.cro.form.domain.FMedicalForm">
            <include refid="selectFMedicalFormVo"/>
        <where>
            <if test="followId != null">and follow_id = #{followId}</if>
            <if test="healthManageType != null">and health_manage_type = #{healthManageType} </if>
            and form_type = '5'
        </where>
    </select>

    <insert id="insertFMedicalForm" parameterType="com.dchealth.cro.form.domain.FMedicalForm" useGeneratedKeys="true"
            keyProperty="medicalFormId">
        insert into f_medical_form
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="followId != null">follow_id,</if>
            <if test="medicalCode != null and medicalCode != ''">medical_code,</if>
            <if test="medicalName != null">medical_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="openImage != null">open_image,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="openMultiple != null">open_multiple,</if>
            <if test="attribute != null">attribute,</if>
            <if test="versionCode != null">version_code,</if>
            <if test="formType != null">form_type,</if>
            <if test="articleId != null">article_id,</if>
            <if test="formSource != null">form_source,</if>
            <if test="dynamic != null">dynamic,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="followId != null">#{followId},</if>
            <if test="medicalCode != null and medicalCode != ''">#{medicalCode},</if>
            <if test="medicalName != null">#{medicalName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="openImage != null">#{openImage},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="openMultiple != null">#{openMultiple},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="versionCode != null">#{versionCode},</if>
            <if test="formType != null">#{formType},</if>
            <if test="articleId != null">#{articleId},</if>
            <if test="formSource != null">#{formSource},</if>
            <if test="dynamic != null">#{dynamic},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <update id="updateFMedicalForm" parameterType="com.dchealth.cro.form.domain.FMedicalForm">
        update f_medical_form
        <trim prefix="SET" suffixOverrides=",">
            <if test="followId != null">follow_id = #{followId},</if>
            <if test="medicalCode != null and medicalCode != ''">medical_code = #{medicalCode},</if>
            <if test="medicalName != null">medical_name = #{medicalName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="openImage != null">open_image = #{openImage},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="openMultiple != null">open_multiple = #{openMultiple},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="versionCode != null">version_code = #{versionCode},</if>
            <if test="formType != null">form_type = #{formType},</if>
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="formSource != null">form_source = #{formSource},</if>
            <if test="dynamic != null">dynamic = #{dynamic},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where medical_form_id = #{medicalFormId}
    </update>

    <delete id="deleteFMedicalFormByMedicalFormId" parameterType="Long">
        delete
        from f_medical_form
        where medical_form_id = #{medicalFormId}
    </delete>

    <delete id="deleteFMedicalFormByMedicalFormIds" parameterType="String">
        delete from f_medical_form where medical_form_id in
        <foreach item="medicalFormId" collection="array" open="(" separator="," close=")">
            #{medicalFormId}
        </foreach>
    </delete>
</mapper>