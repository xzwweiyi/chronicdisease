<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.cms.mapper.CmsArticleDataMapper">
    
    <resultMap type="com.dchealth.cro.cms.domain.CmsArticleData" id="CmsArticleDataResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="copyFrom"    column="copy_from"    />
        <result property="relation"    column="relation"    />
        <result property="allowComment"    column="allow_comment"    />
    </resultMap>

    <sql id="selectCmsArticleDataVo">
        select id, content, copy_from, relation, allow_comment from cms_article_data
    </sql>

    <select id="selectCmsArticleDataList" parameterType="com.dchealth.cro.cms.domain.CmsArticleData" resultMap="CmsArticleDataResult">
        <include refid="selectCmsArticleDataVo"/>
        <where>  
            <if test="copyFrom != null  and copyFrom != ''"> and copy_from = #{copyFrom}</if>
        </where>
    </select>
    
    <select id="selectCmsArticleDataById" parameterType="Long" resultMap="CmsArticleDataResult">
        <include refid="selectCmsArticleDataVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCmsArticleData" parameterType="com.dchealth.cro.cms.domain.CmsArticleData">
        insert into cms_article_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="content != null  and content != ''">content,</if>
            <if test="copyFrom != null  and copyFrom != ''">copy_from,</if>
            <if test="relation != null  and relation != ''">relation,</if>
            <if test="allowComment != null  and allowComment != ''">allow_comment,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null ">#{id},</if>
            <if test="content != null  and content != ''">#{content},</if>
            <if test="copyFrom != null  and copyFrom != ''">#{copyFrom},</if>
            <if test="relation != null  and relation != ''">#{relation},</if>
            <if test="allowComment != null  and allowComment != ''">#{allowComment},</if>
         </trim>
    </insert>

    <update id="updateCmsArticleData" parameterType="com.dchealth.cro.cms.domain.CmsArticleData">
        update cms_article_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null  and content != ''">content = #{content},</if>
            <if test="copyFrom != null  and copyFrom != ''">copy_from = #{copyFrom},</if>
            <if test="relation != null  and relation != ''">relation = #{relation},</if>
            <if test="allowComment != null  and allowComment != ''">allow_comment = #{allowComment},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsArticleDataById" parameterType="Long">
        delete from cms_article_data where id = #{id}
    </delete>

    <delete id="deleteCmsArticleDataByIds" parameterType="String">
        delete from cms_article_data where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>