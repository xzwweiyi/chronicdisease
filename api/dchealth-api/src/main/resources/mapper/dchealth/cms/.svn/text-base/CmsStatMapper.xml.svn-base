<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.cms.mapper.CmsStatMapper">
    
    <resultMap type="com.dchealth.cro.cms.domain.CmsStat" id="CmsStatResult">
        <result property="id"    column="id"    />
        <result property="viewNum"    column="view_num"    />
        <result property="collectNum"    column="collect_num"    />
        <result property="commentNum"    column="comment_num"    />
    </resultMap>

    <sql id="selectCmsStatVo">
        select id, view_num, collect_num, comment_num from cms_stat
    </sql>

    <select id="selectCmsStatList" parameterType="com.dchealth.cro.cms.domain.CmsStat" resultMap="CmsStatResult">
        <include refid="selectCmsStatVo"/>
        <where>  
        </where>
    </select>
    
    <select id="selectCmsStatById" parameterType="Long" resultMap="CmsStatResult">
        <include refid="selectCmsStatVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCmsStat" parameterType="com.dchealth.cro.cms.domain.CmsStat">
        insert into cms_stat
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="viewNum != null ">view_num,</if>
            <if test="collectNum != null ">collect_num,</if>
            <if test="commentNum != null ">comment_num,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null ">#{id},</if>
            <if test="viewNum != null ">#{viewNum},</if>
            <if test="collectNum != null ">#{collectNum},</if>
            <if test="commentNum != null ">#{commentNum},</if>
         </trim>
    </insert>

    <update id="updateCmsStat" parameterType="com.dchealth.cro.cms.domain.CmsStat">
        update cms_stat
        <trim prefix="SET" suffixOverrides=",">
            <if test="viewNum != null ">view_num = #{viewNum},</if>
            <if test="collectNum != null ">collect_num = #{collectNum},</if>
            <if test="commentNum != null ">comment_num = #{commentNum},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsStatById" parameterType="Long">
        delete from cms_stat where id = #{id}
    </delete>

    <delete id="deleteCmsStatByIds" parameterType="String">
        delete from cms_stat where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>