<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.cms.mapper.CmsCommentMapper">
    
    <resultMap type="com.dchealth.cro.cms.domain.CmsComment" id="CmsCommentResult">
        <result property="id"    column="id"    />
        <result property="articleId"    column="article_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="accountId"    column="account_id"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="appType"    column="app_type"    />
    </resultMap>

    <sql id="selectCmsCommentVo">
        select id, article_id, tenant_id, account_id, content, create_time, del_flag, app_type from cms_comment
    </sql>

    <select id="selectCmsCommentList" parameterType="com.dchealth.cro.cms.domain.CmsComment" resultMap="CmsCommentResult">
        <include refid="selectCmsCommentVo"/>
        <where>  
            <if test="articleId != null "> and article_id = #{articleId}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
            <if test="accountId != null "> and account_id = #{accountId}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
        </where>
    </select>
    
    <select id="selectCmsCommentById" parameterType="Long" resultMap="CmsCommentResult">
        <include refid="selectCmsCommentVo"/>
        where id = #{id}  and del_flag = 'N'
    </select>
        
    <insert id="insertCmsComment" parameterType="com.dchealth.cro.cms.domain.CmsComment" useGeneratedKeys="true" keyProperty="id">
        insert into cms_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="articleId != null ">article_id,</if>
            <if test="tenantId != null  and tenantId != ''">tenant_id,</if>
            <if test="accountId != null ">account_id,</if>
            <if test="content != null  and content != ''">content,</if>
            <if test="createTime != null ">create_time,</if>
            <if test="delFlag != null  and delFlag != ''">del_flag,</if>
            <if test="appType != null  and appType != ''">app_type,</if>

         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="articleId != null ">#{articleId},</if>
            <if test="tenantId != null  and tenantId != ''">#{tenantId},</if>
            <if test="accountId != null ">#{accountId},</if>
            <if test="content != null  and content != ''">#{content},</if>
            <if test="createTime != null ">#{createTime},</if>
            <if test="delFlag != null  and delFlag != ''">#{delFlag},</if>
            <if test="appType != null  and appType != ''">#{appType},</if>

         </trim>
    </insert>

    <update id="updateCmsComment" parameterType="com.dchealth.cro.cms.domain.CmsComment">
        update cms_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="articleId != null ">article_id = #{articleId},</if>
            <if test="tenantId != null  and tenantId != ''">tenant_id = #{tenantId},</if>
            <if test="accountId != null ">account_id = #{accountId},</if>
            <if test="content != null  and content != ''">content = #{content},</if>
            <if test="createTime != null ">create_time = #{createTime},</if>
            <if test="delFlag != null  and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="appType != null  and appType != ''">app_type = #{appType},</if>

        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCmsCommentById" parameterType="Long">
        delete from cms_comment where id = #{id}
    </delete>

    <delete id="deleteCmsCommentByIds" parameterType="String">
        delete from cms_comment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <select id="selectCommentListByArticleId"  resultType="com.dchealth.cro.cms.vo.CommentListVO">
     select cc.account_id as accountId ,cc.content,cc.create_time as createTime ,cc.app_type as appType, cc.id as  commentId
     from  cms_comment cc where cc.article_id = #{articleId} order by cc.create_time desc  LIMIT ${(pageNo-1)*pageSize},${pageSize}
    </select>
    
</mapper>