<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.base.mapper.AppBannerMapper">
    
    <resultMap type="com.dchealth.cro.base.domain.AppBanner" id="AppBannerResult">
        <result property="id"    column="id"    />
        <result property="dataId"    column="data_id"    />
        <result property="type"    column="type"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="positionType"    column="position_type"    />
        <result property="bannerName"    column="banner_name"    />
        <result property="link"    column="link"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="orderNum"    column="order_num"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAppBannerVo">
        select id, data_id, type, tenant_id, position_type, banner_name, link, image_url, order_num, remark, create_time, update_time from app_banner
    </sql>

    <select id="selectAppBannerList" parameterType="com.dchealth.cro.base.domain.AppBanner" resultMap="AppBannerResult">
        <include refid="selectAppBannerVo"/>
        <where>  
            <if test="dataId != null  and dataId != ''"> and data_id = #{dataId}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
            <if test="positionType != null  and positionType != ''"> and position_type = #{positionType}</if>
            <if test="bannerName != null  and bannerName != ''"> and banner_name like concat('%', #{bannerName}, '%')</if>
        </where>
    </select>
    
    <select id="selectAppBannerById" parameterType="Integer" resultMap="AppBannerResult">
        <include refid="selectAppBannerVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAppBanner" parameterType="com.dchealth.cro.base.domain.AppBanner" useGeneratedKeys="true" keyProperty="id">
        insert into app_banner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dataId != null  and dataId != ''">data_id,</if>
            <if test="type != null ">type,</if>
            <if test="tenantId != null  and tenantId != ''">tenant_id,</if>
            <if test="positionType != null  and positionType != ''">position_type,</if>
            <if test="bannerName != null  and bannerName != ''">banner_name,</if>
            <if test="link != null  and link != ''">link,</if>
            <if test="imageUrl != null  and imageUrl != ''">image_url,</if>
            <if test="orderNum != null ">order_num,</if>
            <if test="remark != null  and remark != ''">remark,</if>
            <if test="createTime != null ">create_time,</if>
            <if test="updateTime != null ">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dataId != null  and dataId != ''">#{dataId},</if>
            <if test="type != null ">#{type},</if>
            <if test="tenantId != null  and tenantId != ''">#{tenantId},</if>
            <if test="positionType != null  and positionType != ''">#{positionType},</if>
            <if test="bannerName != null  and bannerName != ''">#{bannerName},</if>
            <if test="link != null  and link != ''">#{link},</if>
            <if test="imageUrl != null  and imageUrl != ''">#{imageUrl},</if>
            <if test="orderNum != null ">#{orderNum},</if>
            <if test="remark != null  and remark != ''">#{remark},</if>
            <if test="createTime != null ">#{createTime},</if>
            <if test="updateTime != null ">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAppBanner" parameterType="com.dchealth.cro.base.domain.AppBanner">
        update app_banner
        <trim prefix="SET" suffixOverrides=",">
            <if test="dataId != null  and dataId != ''">data_id = #{dataId},</if>
            <if test="type != null ">type = #{type},</if>
            <if test="tenantId != null  and tenantId != ''">tenant_id = #{tenantId},</if>
            <if test="positionType != null  and positionType != ''">position_type = #{positionType},</if>
            <if test="bannerName != null  and bannerName != ''">banner_name = #{bannerName},</if>
            <if test="link != null  and link != ''">link = #{link},</if>
            <if test="imageUrl != null  and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="orderNum != null ">order_num = #{orderNum},</if>
            <if test="remark != null  and remark != ''">remark = #{remark},</if>
            <if test="createTime != null ">create_time = #{createTime},</if>
            <if test="updateTime != null ">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppBannerById" parameterType="Integer">
        delete from app_banner where id = #{id}
    </delete>

    <delete id="deleteAppBannerByIds" parameterType="String">
        delete from app_banner where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectAppBanner" resultType="com.dchealth.cro.base.vo.AppBannerVO">
        select ab.data_id as dataId,ab.type,ab.image_url as imageUrl,ab.link,ab.order_num as orderNum,ab.banner_name as bannerName
        from app_banner ab  where position_type = #{positionType} ORDER BY order_num  LIMIT 0,${pageSize}
    </select>

    <select id="selectMobileBanner" resultType="com.dchealth.cro.base.vo.AppBannerVO">
    select ab.data_id as dataId,ab.type,ab.image_url as imageUrl,ab.link,ab.order_num as orderNum,ab.banner_name as bannerName from app_banner ab  where tenant_id=#{tenantId}  and position_type like concat('%', #{positionType}, '%') ORDER BY order_num  LIMIT 0,${pageSize}
    </select>
    <select id="selectAppBannerByDeptId" resultType="com.dchealth.cro.base.vo.AppBannerVO">
        select ab.data_id as dataId,ab.type,ab.image_url as imageUrl,ab.link,ab.order_num as orderNum,ab.banner_name as bannerName
        from app_banner ab
        INNER JOIN cms_article ca on  ab.data_id = ca.id
        <where>
            <if test="positionType != null  and positionType != ''"> and ab.position_type = #{positionType}</if>
           <!-- <if test="deptId != null and deptId!='100'.toString() "> and ab.dept_id = #{deptId}</if> -->
        </where>
        ORDER BY order_num  LIMIT 0,${pageSize}
    </select>
</mapper>