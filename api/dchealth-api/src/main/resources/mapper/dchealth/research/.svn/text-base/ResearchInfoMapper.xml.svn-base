<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.research.mapper.ResearchInfoMapper">
    
    <resultMap type="com.dchealth.cro.research.domain.ResearchInfo" id="ResearchInfoResult">
        <result property="id"    column="id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="projectName"    column="project_name"    />
        <result property="researchSynopsis"    column="research_synopsis"    />
        <result property="patientNum"    column="patient_num"    />
        <result property="hospitalNum"    column="hospital_num"    />
        <result property="researchStatus"    column="research_status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="diseaseTypeId"    column="disease_type_id"    />
        <result property="doctorId"    column="doctor_id"    />
        <result property="researchType"    column="research_type"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="stage"    column="stage"    />
        <result property="userId"    column="user_id"    />
    </resultMap>

    <resultMap type="com.dchealth.cro.medical.dto.DiseaseResearchPatientDto" id="DiseaseResearchPatientResult">
        <result property="researchId" column="research_id"/>
        <result property="researchName" column="research_name"/>
        <result property="diseaseId" column="disease_id"/>
        <result property="diseaseName" column="disease_name"/>
        <result property="patientId" column="patient_id"/>
        <result property="patientName" column="patient_name"/>
    </resultMap>

    <sql id="selectResearchInfoVo">
        select id, dept_id, image_url, project_name, research_synopsis, patient_num, hospital_num, research_status, create_time,
               update_time, create_by, update_by, disease_type_id, doctor_id, research_type, del_flag, stage
        from research_info
    </sql>

    <select id="selectResearchInfoList" parameterType="com.dchealth.cro.research.domain.ResearchInfo" resultMap="ResearchInfoResult">
        <include refid="selectResearchInfoVo"/>
        <where>  
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="projectName != null  and projectName != ''"> and project_name like concat('%', #{projectName}, '%')</if>
            <if test="researchSynopsis != null  and researchSynopsis != ''"> and research_synopsis = #{researchSynopsis}</if>
            <if test="patientNum != null "> and patient_num = #{patientNum}</if>
            <if test="hospitalNum != null "> and hospital_num = #{hospitalNum}</if>
            <if test="researchStatus != null  and researchStatus != ''"> and research_status = #{researchStatus}</if>
            <if test="diseaseTypeId != null "> and disease_type_id = #{diseaseTypeId}</if>
            <if test="doctorId != null "> and doctor_id = #{doctorId}</if>
            <if test="researchType != null  and researchType != ''"> and research_type = #{researchType}</if>
            <if test="stage != null  and stage != ''"> and stage = #{stage}</if>
        </where>
    </select>
    
    <select id="selectResearchInfoById" parameterType="Long" resultMap="ResearchInfoResult">
        <include refid="selectResearchInfoVo"/>
        where id = #{id}
    </select>
    <select id="selectByIdAndStatus" parameterType="com.dchealth.cro.research.domain.ResearchInfo"
            resultMap="ResearchInfoResult">
        <include refid="selectResearchInfoVo"/>
        <where>
            <if test="id != null ">and id = #{id}</if>
            <if test="researchStatus != null  and researchStatus != ''">and research_status = #{researchStatus}</if>
        </where>
    </select>
    <select id="selectDiseaseResearchPatientByPatientId" parameterType="java.lang.Long"
            resultMap="DiseaseResearchPatientResult">
        SELECT
            rd.disease_id,
            rd.disease_name,
            ri.id as research_id,
            ri.project_name as research_name,
            pi.patient_id,
            pi.patient_name
        FROM
            patient_info AS pi
                LEFT JOIN research_info AS ri ON pi.research_id = ri.id
                LEFT JOIN research_diseases AS rd ON rd.disease_id = ri.disease_type_id
        WHERE
            patient_id = #{patientId}
    </select>

    <select id="selectResearchInfoByDeptId" parameterType="Long" resultMap="ResearchInfoResult">
        <include refid="selectResearchInfoVo"/>
        where dept_id = #{deptId}
    </select>

    <select id="selectResearchInfoByAuth" resultMap="ResearchInfoResult">
        select r.disease_type_id,r.id,r.project_name ,r.dept_id from research_diseases d,
        research_info r
        where r.disease_type_id=d.disease_id and r.research_status='1' and r.del_flag = '0' and d.is_deleted='0'
    </select>


    <select id="selectResearchInfoByUserId" parameterType="Long" resultMap="ResearchInfoResult">
        select r.disease_type_id,r.id,r.project_name ,r.dept_id
        from research_diseases d
        INNER JOIN research_info r on r.disease_type_id=d.disease_id
        INNER JOIN sys_dept s on r.dept_id=s.dept_id and s.del_flag=0
        INNER JOIN (
            select user_id,research_id from research_user_role where user_id=#{userId} GROUP BY user_id,research_id
        ) ru on r.id=ru.research_id
        where  r.research_status='1' and r.del_flag = '0' and d.is_deleted='0'
    </select>

    <insert id="insertResearchInfo" parameterType="com.dchealth.cro.research.domain.ResearchInfo" useGeneratedKeys="true" keyProperty="id">
        insert into research_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="projectName != null">project_name,</if>
            <if test="researchSynopsis != null">research_synopsis,</if>
            <if test="patientNum != null">patient_num,</if>
            <if test="hospitalNum != null">hospital_num,</if>
            <if test="researchStatus != null">research_status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="diseaseTypeId != null">disease_type_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="researchType != null">research_type,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="stage != null">stage,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="projectName != null">#{projectName},</if>
            <if test="researchSynopsis != null">#{researchSynopsis},</if>
            <if test="patientNum != null">#{patientNum},</if>
            <if test="hospitalNum != null">#{hospitalNum},</if>
            <if test="researchStatus != null">#{researchStatus},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="diseaseTypeId != null">#{diseaseTypeId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="researchType != null">#{researchType},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="stage != null">#{stage},</if>
         </trim>
    </insert>

    <update id="updateResearchInfo" parameterType="com.dchealth.cro.research.domain.ResearchInfo">
        update research_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="projectName != null">project_name = #{projectName},</if>
            <if test="researchSynopsis != null">research_synopsis = #{researchSynopsis},</if>
            <if test="patientNum != null">patient_num = #{patientNum},</if>
            <if test="hospitalNum != null">hospital_num = #{hospitalNum},</if>
            <if test="researchStatus != null">research_status = #{researchStatus},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="diseaseTypeId != null">disease_type_id = #{diseaseTypeId},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="researchType != null">research_type = #{researchType},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="stage != null">stage = #{stage},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteResearchInfoById" parameterType="Long">
        delete from research_info where id = #{id}
    </delete>

    <delete id="deleteResearchInfoByIds" parameterType="String">
        delete from research_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectResearchInfoByDoctorId"   parameterType="Long" resultMap="ResearchInfoResult">
        select r.disease_type_id,r.id,r.project_name from research_diseases d,
                                                          research_info r,
                                                          research_user_role ur
        where r.disease_type_id=d.disease_id and ur.research_id = r.id
          and ur.user_id = #{doctorId}
          and r.research_status='1' and r.del_flag = '0' and d.is_deleted='0'
    </select>
    <select id="selectResearchOwnerById"   parameterType="Long" resultMap="ResearchInfoResult">
        select id, dept_id, image_url, project_name, research_synopsis, patient_num, hospital_num, research_status, create_time,
               update_time, create_by, update_by, disease_type_id, doctor_id, research_type, del_flag, stage, user_id
        from research_info a left join sys_user  b on a.create_by=b.user_name
        where id = #{id}
    </select>
</mapper>