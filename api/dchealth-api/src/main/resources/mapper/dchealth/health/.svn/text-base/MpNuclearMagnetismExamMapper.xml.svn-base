<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.health.mapper.MpNuclearMagnetismExamMapper">
    
    <resultMap type="com.dchealth.cro.health.domain.MpNuclearMagnetismExam" id="MpNuclearMagnetismExamResult">
        <result property="id"    column="id"    />
        <result property="careSiteId"    column="care_site_id"    />
        <result property="personId"    column="person_id"    />
        <result property="visitType"    column="visit_type"    />
        <result property="visitOccurrenceId"    column="visit_occurrence_id"    />
        <result property="technologyName"    column="TECHNOLOGY_NAME"    />
        <result property="sctPosition"    column="SCT_POSITION"    />
        <result property="level1Position"    column="level_1_POSITION"    />
        <result property="level2Position"    column="level_2_POSITION"    />
        <result property="technologyDate"    column="TECHNOLOGY_DATE"    />
        <result property="reportDate"    column="REPORT_DATE"    />
        <result property="objectiveView"    column="OBJECTIVE_VIEW"    />
        <result property="subjectiveHints"    column="SUBJECTIVE_HINTS"    />
        <result property="isAbnormal"    column="IS_ABNORMAL"    />
        <result property="relevantClinicDiagnosis"    column="RELEVANT_CLINIC_DIAGNOSIS"    />
        <result property="physSign"    column="PHYS_SIGN"    />
        <result property="exeDepartment"    column="EXE_DEPARTMENT"    />
        <result property="departmentName"    column="DEPARTMENT_NAME"    />
        <result property="testMethod"    column="TEST_METHOD"    />
    </resultMap>

    <sql id="selectMpNuclearMagnetismExamVo">
        select id, care_site_id, person_id, visit_type, visit_occurrence_id, TECHNOLOGY_NAME, SCT_POSITION, level_1_POSITION, level_2_POSITION, TECHNOLOGY_DATE, REPORT_DATE, OBJECTIVE_VIEW, SUBJECTIVE_HINTS, IS_ABNORMAL, RELEVANT_CLINIC_DIAGNOSIS, PHYS_SIGN, EXE_DEPARTMENT, DEPARTMENT_NAME, TEST_METHOD from mp_nuclear_magnetism_exam
    </sql>

    <select id="selectMpNuclearMagnetismExamList" resultMap="MpNuclearMagnetismExamResult">
        <include refid="selectMpNuclearMagnetismExamVo"/>
        <where>  
            <if test="personId != null  and personId != ''"> and person_id = #{personId}</if>
            <if test="visitType != null  and visitType != ''"> and visit_type = #{visitType}</if>
            <if test="visitOccurrenceId != null  and visitOccurrenceId != ''"> and visit_occurrence_id = #{visitOccurrenceId}</if>
        </where>
        order by REPORT_DATE desc
    </select>
    
    <select id="selectMpNuclearMagnetismExamById" parameterType="Long" resultMap="MpNuclearMagnetismExamResult">
        <include refid="selectMpNuclearMagnetismExamVo"/>
        where id = #{id}
    </select>
</mapper>