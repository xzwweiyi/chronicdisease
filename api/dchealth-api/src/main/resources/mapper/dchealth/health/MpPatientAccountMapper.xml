<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.health.mapper.MpPatientAccountMapper">
    
    <resultMap type="com.dchealth.cro.health.domain.MpPatientAccount" id="MpPatientAccountResult">
        <result property="personId"    column="person_id"    />
        <result property="accountId"    column="account_id"    />
    </resultMap>

    <sql id="selectMpPatientAccountVo">
        select person_id, account_id from mp_patient_account
    </sql>

    <select id="selectMpPatientAccountList" parameterType="com.dchealth.cro.health.domain.MpPatientAccount" resultMap="MpPatientAccountResult">
        <include refid="selectMpPatientAccountVo"/>
        <where>  
            <if test="accountId != null "> and account_id = #{accountId}</if>
        </where>
    </select>
    
    <select id="selectMpPatientAccountBypersonId" parameterType="String" resultMap="MpPatientAccountResult">
        <include refid="selectMpPatientAccountVo"/>
        where person_id = #{personId} limit 0,1
    </select>
    <select id="selectMpPatientAccountByAccountId" parameterType="Long" resultMap="MpPatientAccountResult">
        <include refid="selectMpPatientAccountVo"/>
        where account_id = #{accountId}
    </select>
        
    <insert id="insertMpPatientAccount" parameterType="com.dchealth.cro.health.domain.MpPatientAccount">
        insert into mp_patient_account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="personId != null">person_id,</if>
            <if test="accountId != null">account_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="personId != null">#{personId},</if>
            <if test="accountId != null">#{accountId},</if>
         </trim>
    </insert>

    <update id="updateMpPatientAccount" parameterType="com.dchealth.cro.health.domain.MpPatientAccount">
        update mp_patient_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="accountId != null">account_id = #{accountId},</if>
        </trim>
        where person_id = #{personId}
    </update>

    <update id="updateMpPatientAccountByAccountId" parameterType="com.dchealth.cro.health.domain.MpPatientAccount">
        update mp_patient_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="personId != null">person_id = #{personId},</if>
        </trim>
        where account_id = #{accountId}
    </update>

    <delete id="deleteMpPatientAccountByPatientId" parameterType="String">
        delete from mp_patient_account where person_id = #{personId}
    </delete>

    <delete id="deleteMpPatientAccountBypersonIds" parameterType="String">
        delete from mp_patient_account where person_id in 
        <foreach item="personId" collection="array" open="(" separator="," close=")">
            #{personId}
        </foreach>
    </delete>

</mapper>