<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.medical.mapper.PatientInfoLogsMapper">
    
    <resultMap type="com.dchealth.cro.medical.domain.PatientInfoLogs" id="PatientInfoLogsResult">
        <result property="logId"    column="log_id"    />
        <result property="patientId"    column="patient_id"    />
        <result property="patientName"    column="patient_name"    />
        <result property="patientCode"    column="patient_code"    />
        <result property="patientMobile"    column="patient_mobile"    />
        <result property="idCardNo"    column="id_card_no"    />
        <result property="researchId"    column="research_id"    />
        <result property="hospitalId"    column="hospital_id"    />
        <result property="doctorId"    column="doctor_id"    />
        <result property="userHead"    column="user_head"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="birthday"    column="birthday"    />
        <result property="sex"    column="sex"    />
        <result property="clinicNo"    column="clinic_no"    />
    </resultMap>

    <sql id="selectPatientInfoLogsVo">
        select log_id, patient_id, patient_name,clinic_no, patient_code,sex,birthday,patient_mobile,id_card_no, research_id, hospital_id, doctor_id,  create_by, update_by, create_time, update_time from patient_info_log
    </sql>

    <select id="selectPatientInfoLogsList" parameterType="com.dchealth.cro.medical.domain.PatientInfoLogs" resultMap="PatientInfoLogsResult">
        <include refid="selectPatientInfoLogsVo"/>
        <where>  
            <if test="patientId != null "> and patient_id = #{patientId}</if>
            <if test="patientName != null  and patientName != ''"> and patient_name like concat('%', #{patientName}, '%')</if>
            <if test="patientCode != null  and patientCode != ''"> and patient_code = #{patientCode}</if>
            <if test="researchId != null "> and research_id = #{researchId}</if>
            <if test="hospitalId != null "> and hospital_id = #{hospitalId}</if>
            <if test="doctorId != null "> and doctor_id = #{doctorId}</if>
            <if test="userHead != null  and userHead != ''"> and user_head = #{userHead}</if>
        </where>
    </select>
    
    <select id="selectPatientInfoLogsById" parameterType="Long" resultMap="PatientInfoLogsResult">
        <include refid="selectPatientInfoLogsVo"/>
        where log_id = #{logId}
    </select>
        
    <insert id="insertPatientInfoLogs" parameterType="com.dchealth.cro.medical.domain.PatientInfoLogs" useGeneratedKeys="true" keyProperty="logId">
        insert into patient_info_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientId != null ">patient_id,</if>
            <if test="patientName != null  and patientName != ''">patient_name,</if>
            <if test="patientCode != null  and patientCode != ''">patient_code,</if>
            <if test="patientMobile != null  and patientMobile != ''">patient_mobile,</if>
            <if test="researchId != null ">research_id,</if>
            <if test="hospitalId != null ">hospital_id,</if>
            <if test="doctorId != null ">doctor_id,</if>
            <if test="userHead != null  and userHead != ''">user_head,</if>
            <if test="createBy != null  and createBy != ''">create_by,</if>
            <if test="updateBy != null  and updateBy != ''">update_by,</if>
            <if test="createTime != null ">create_time,</if>
            <if test="updateTime != null ">update_time,</if>
            <if test="idCardNo != null  and idCardNo != ''">id_card_no,</if>
            <if test="birthday != null  and birthday != ''">birthday,</if>
            <if test="sex != null  and sex != ''">sex,</if>
            <if test="clinicNo != null  and clinicNo != ''">clinic_no,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientId != null ">#{patientId},</if>
            <if test="patientName != null  and patientName != ''">#{patientName},</if>
            <if test="patientCode != null  and patientCode != ''">#{patientCode},</if>
            <if test="patientMobile != null  and patientMobile != ''">#{patientMobile},</if>
            <if test="researchId != null ">#{researchId},</if>
            <if test="hospitalId != null ">#{hospitalId},</if>
            <if test="doctorId != null ">#{doctorId},</if>
            <if test="userHead != null  and userHead != ''">#{userHead},</if>
            <if test="createBy != null  and createBy != ''">#{createBy},</if>
            <if test="updateBy != null  and updateBy != ''">#{updateBy},</if>
            <if test="createTime != null ">#{createTime},</if>
            <if test="updateTime != null ">#{updateTime},</if>
            <if test="idCardNo != null  and idCardNo != ''">#{idCardNo},</if>
            <if test="birthday != null  and birthday != ''">#{birthday},</if>
            <if test="sex != null  and sex != ''">#{sex},</if>
            <if test="clinicNo != null  and clinicNo != ''">#{clinicNo},</if>
         </trim>
    </insert>

    <update id="updatePatientInfoLogs" parameterType="com.dchealth.cro.medical.domain.PatientInfoLogs">
        update patient_info_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientId != null ">patient_id = #{patientId},</if>
            <if test="patientName != null  and patientName != ''">patient_name = #{patientName},</if>
            <if test="patientCode != null  and patientCode != ''">patient_code = #{patientCode},</if>
            <if test="researchId != null ">research_id = #{researchId},</if>
            <if test="hospitalId != null ">hospital_id = #{hospitalId},</if>
            <if test="doctorId != null ">doctor_id = #{doctorId},</if>
            <if test="createBy != null  and createBy != ''">create_by = #{createBy},</if>
            <if test="updateBy != null  and updateBy != ''">update_by = #{updateBy},</if>
            <if test="createTime != null ">create_time = #{createTime},</if>
            <if test="updateTime != null ">update_time = #{updateTime},</if>
            <if test="patientMobile != null  and patientMobile != ''">patient_mobile = #{patientMobile},</if>
            <if test="birthday != null  ">birthday = #{birthday},</if>
            <if test="sex != null  and sex != ''">sex = #{sex},</if>
            <if test="clinicNo != null  and clinicNo != ''">clinic_no = #{clinicNo},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <delete id="deletePatientInfoLogsById" parameterType="Long">
        delete from patient_info_log where log_id = #{logId}
    </delete>

    <delete id="deletePatientInfoLogsByIds" parameterType="String">
        delete from patient_info_log where log_id in
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
    
</mapper>