<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.cro.account.mapper.MsgReminderTaskMapper">

    <resultMap type="com.dchealth.cro.account.domain.MsgReminderTask" id="MsgReminderTaskMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="researchId" column="research_id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="earlierTime" column="earlier_time" jdbcType="INTEGER"/>
        <result property="ultraWindowTime" column="ultra_window_time" jdbcType="INTEGER"/>
        <result property="reminderTime" column="reminder_time" jdbcType="TIMESTAMP"/>
        <result property="stationMessage" column="station_message" jdbcType="VARCHAR"/>
        <result property="followType" column="follow_type" jdbcType="INTEGER"/>
        <result property="tipType" column="tip_type" jdbcType="INTEGER"/>
        <result property="isDelete" column="is_delete" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="MsgReminderTaskMap">
        select
          id, research_id, name, earlier_time, ultra_window_time, reminder_time, station_message, follow_type, tip_type, is_delete, create_time, update_time
        from msg_reminder_task
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="MsgReminderTaskMap">
        select
          id, research_id, name, earlier_time, ultra_window_time, reminder_time, station_message, follow_type, tip_type, is_delete, create_time, update_time
        from msg_reminder_task
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="researchId != null">
                and research_id = #{researchId}
            </if>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="earlierTime != null">
                and earlier_time = #{earlierTime}
            </if>
            <if test="ultraWindowTime != null">
                and ultra_window_time = #{ultraWindowTime}
            </if>
            <if test="reminderTime != null">
                and reminder_time = #{reminderTime}
            </if>
            <if test="stationMessage != null and stationMessage != ''">
                and station_message = #{stationMessage}
            </if>
            <if test="followType != null">
                and follow_type = #{followType}
            </if>
            <if test="tipType != null">
                and tip_type = #{tipType}
            </if>
            <if test="isDelete != null">
                and is_delete = #{isDelete}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from msg_reminder_task
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="researchId != null">
                and research_id = #{researchId}
            </if>
            <if test="name != null and name != ''">
                and name = #{name}
            </if>
            <if test="earlierTime != null">
                and earlier_time = #{earlierTime}
            </if>
            <if test="ultraWindowTime != null">
                and ultra_window_time = #{ultraWindowTime}
            </if>
            <if test="reminderTime != null">
                and reminder_time = #{reminderTime}
            </if>
            <if test="stationMessage != null and stationMessage != ''">
                and station_message = #{stationMessage}
            </if>
            <if test="followType != null">
                and follow_type = #{followType}
            </if>
            <if test="tipType != null">
                and tip_type = #{tipType}
            </if>
            <if test="isDelete != null">
                and is_delete = #{isDelete}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into msg_reminder_task(research_id, name, earlier_time, ultra_window_time, reminder_time, station_message, follow_type, tip_type, is_delete, create_time, update_time)
        values (#{researchId}, #{name}, #{earlierTime}, #{ultraWindowTime}, #{reminderTime}, #{stationMessage}, #{followType}, #{tipType}, #{isDelete}, #{createTime}, #{updateTime})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into msg_reminder_task(research_id, name, earlier_time, ultra_window_time, reminder_time, station_message, follow_type, tip_type, is_delete, create_time, update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.researchId}, #{entity.name}, #{entity.earlierTime}, #{entity.ultraWindowTime}, #{entity.reminderTime}, #{entity.stationMessage}, #{entity.followType}, #{entity.tipType}, #{entity.isDelete}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into msg_reminder_task(research_id, name, earlier_time, ultra_window_time, reminder_time, station_message, follow_type, tip_type, is_delete, create_time, update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.researchId}, #{entity.name}, #{entity.earlierTime}, #{entity.ultraWindowTime}, #{entity.reminderTime}, #{entity.stationMessage}, #{entity.followType}, #{entity.tipType}, #{entity.isDelete}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
        on duplicate key update
        research_id = values(research_id),
        name = values(name),
        earlier_time = values(earlier_time),
        ultra_window_time = values(ultra_window_time),
        reminder_time = values(reminder_time),
        station_message = values(station_message),
        follow_type = values(follow_type),
        tip_type = values(tip_type),
        is_delete = values(is_delete),
        create_time = values(create_time),
        update_time = values(update_time)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update msg_reminder_task
        <set>
            <if test="researchId != null">
                research_id = #{researchId},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="earlierTime != null">
                earlier_time = #{earlierTime},
            </if>
            <if test="ultraWindowTime != null">
                ultra_window_time = #{ultraWindowTime},
            </if>
            <if test="reminderTime != null">
                reminder_time = #{reminderTime},
            </if>
            <if test="stationMessage != null and stationMessage != ''">
                station_message = #{stationMessage},
            </if>
            <if test="followType != null">
                follow_type = #{followType},
            </if>
            <if test="tipType != null">
                tip_type = #{tipType},
            </if>
            <if test="isDelete != null">
                is_delete = #{isDelete},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from msg_reminder_task where id = #{id}
    </delete>

</mapper>

