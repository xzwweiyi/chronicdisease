package com.dchealth.cro.health.domain;

import java.util.Date;

import lombok.Data;

/**
 * 血常规对象 mp_blood_routine
 * 
 * @author GeneMax
 * @date 2023-11-04
 */
@Data
public class MpBloodRoutine {
	  /** 创建者 */
    private String createBy;

    /** 创建时间 */
    private Date createTime;

    /** 更新者 */
    private String updateBy;

    /** 更新时间 */
    private Date updateTime;

    /** 自增主键 */
    private Long id;

    /** 医疗机构id */
    private String careSiteId;

    /** 患者id */
    private String personId;

    /** 就诊id */
    private String visitOccurrenceId;

    /** 就诊类型名称 */
    private String visitType;

    /** 报告时间 */
    private Date resultTime;

    /** 白细胞计数 */
    private String wbcCount;

    /** 红细胞计数 */
    private String rbcCount;

    /** 血红蛋白 */
    private String bloodHb;

    /** 红细胞压积 */
    private String bloodHct;

    /** 平均红细胞体积 */
    private String bloodMcv;

    /** 平均红细胞血红蛋白含量 */
    private String bloodMch;

    /** 平均红细胞血红蛋白浓度 */
    private String bloodMchc;

    /** 红细胞分布宽度-变异系数 */
    private String bloodRdwCv;

    /** 红细胞分布宽度-标准差 */
    private String bloodRdwSd;

    /** 血小板计数 */
    private String bloodPltCount;

    /** 平均血小板体积 */
    private String bloodMpv;

    /** 血小板压积 */
    private String bloodPct;

    /** 血小板分布宽度 */
    private String bloodPdw;

    /** 淋巴细胞绝对值 */
    private String bloodLyCount;

    /** 淋巴细胞百分比 */
    private String bloodLyPercentage;

    /** 中性粒细胞绝对值 */
    private String bloodNeCount;

    /** 中性粒细胞百分比 */
    private String bloodNePercentage;

    /** 单核细胞绝对值 */
    private String bloodMoCount;

    /** 单核细胞百分比 */
    private String bloodMoPercentage;

    /** 嗜酸性细胞绝对值 */
    private String bloodEoCount;

    /** 嗜酸性细胞百分比 */
    private String bloodEoPercentage;

    /** 嗜碱性细胞绝对值 */
    private String bloodBaCount;

    /** 嗜碱性细胞百分比 */
    private String bloodBaPercentage;

    /** 大血小板比率 */
    private String largePlateletRatio;

    
}
