    /**
     * 保存预警指导
     */
    @ResponseBody
    @RequestMapping(value = "savePatientWarnLeaveMessage", method = RequestMethod.POST)
    public String savePatientWarnLeaveMessage(@Validated WarnLeaveMessageForm infoForm,MultipartHttpServletRequest request) {
        try {
        	if("2" .equals(infoForm.getContentType())) {
            List<MultipartFile> imagesFiles = request.getFiles("imageFiles");
            if(imagesFiles!=null) {
                List<String> imagesArr = new ArrayList<String>();
                String httpUrl = croCoreConfig.getFastPath() + "ngupload/singleFiles";
                String result = HttpClientUtil.getInstance().sendHttpPost(httpUrl, imagesFiles);
                if (StringUtils.isNotEmpty(result) && StringUtils.isNotBlank(result)) {
                    JSONObject jsonObject = JSON.parseObject(result);
                    if (jsonObject != null && jsonObject.get("code") != null) {
                        int  code = jsonObject.getInteger("code");
                        if(code ==1000) {
                            JSONArray jsonArray = jsonObject.getJSONArray("data");
                            for (Object url : jsonArray) {
                                imagesArr.add(String.valueOf(url));
                            }
                            infoForm.setImageList(imagesArr);
                        }
                    }
                }
            }
            }
            return buildSuccessMView(followWorkService.savePatientWarnLeaveMessage(infoForm));
        } catch (Exception e) {
            L.info("保存预警指导异常{}", JSON.toJSONString(infoForm), e);
            return buildExceptionMView();
        }
    }

