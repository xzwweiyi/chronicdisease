    public String tree(String reqType,Long doctorId)
    {
        try {
            Boolean  b = notEmpty(reqType);
            if (!b) {
                return buildErrorParamMView();
            }
            return buildSuccessMView(followWorkService.tree(reqType,doctorId));
        } catch (Exception e) {
            L.info("任务树异常", e);
            return buildExceptionMView();
        }

    }

