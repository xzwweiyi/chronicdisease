package com.dchealth.cro.health.domain;

import java.util.Date;

import com.fasterxml.jackson.annotation.JsonFormat;

import lombok.Data;

/**
 * 肿瘤标志物对象 mp_tumor_screening_items
 * 
 * @author GeneMax
 * @date 2023-11-04
 */
@Data
public class MpTumorScreeningItems {
	  /** 创建者 */
    private String createBy;

    /** 创建时间 */
    private Date createTime;

    /** 更新者 */
    private String updateBy;

    /** 更新时间 */
    private Date updateTime;

    /** 自增主键 */
    private Long id;

    /** 医疗机构id */
    private String careSiteId;

    /** 患者id */
    private String personId;

    /** 就诊id */
    private String visitOccurrenceId;

    /** 就诊类型名称 */
    private String visitType;

    /** 报告时间 */
    @JsonFormat(pattern = "yyyy-MM-dd")
    private Date resultTime;

    /** 甲胎蛋白(afp) */
    private String tumorAfp;

    /** 癌胚抗原(cea) */
    private String tumorCea;

    /** 癌抗原199(ca199) */
    private String tumorCa199;

    /** 癌抗原125(ca125) */
    private String tumorCa125;

    /** 癌抗原242 */
    private String tumorCa242;

    /** 癌抗原153 */
    private String tumorCa153;

    /** 神经元特异性烯醇化酶nse */
    private String tumorNse;

    /** 癌抗原72-4 */
    private String tumorCa724;

    /** 细胞角蛋白19片段(cyfra21-2) */
    private String tumorCyfra21;

    /** 癌抗原50 */
    private String tumorCa50;

    /** 游离前列腺特异性抗原 */
    private String tumorFpsa;

    /** 前列腺特异性抗原 */
    private String tumorTpsa;

    /** 人附睾蛋白4 */
    private String tumorHe4;

    /** 鳞状细胞癌抗原（scc） */
    private String tumorScc;

   
}
