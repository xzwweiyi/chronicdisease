package com.dchealth.cro.common.enums;

/**
 * 用户状态
 * 
 * @author genemax
 */
public enum UserSex
{
    MAN("0", "男"), WOMAN("1", "女"), SECRET("2", "保密");

    private final String code;
    private final String info;

    UserSex(String code, String info)
    {
        this.code = code;
        this.info = info;
    }

    public String getCode()
    {
        return code;
    }

    public String getInfo()
    {
        return info;
    }
}
