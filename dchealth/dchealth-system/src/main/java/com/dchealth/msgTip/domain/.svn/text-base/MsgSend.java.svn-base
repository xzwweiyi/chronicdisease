import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

/**
 * @Auther: cuitao
 * @Date: 2023/6/6 - 06 - 06 - 11:01
 * @Description: com.dchealth.msgTip.domain
 */
@Data
@AllArgsConstructor
@NoArgsConstructor
public class MsgSend {
    private static final long serialVersionUID = 1L;
    /**
     * 病种id
     */
