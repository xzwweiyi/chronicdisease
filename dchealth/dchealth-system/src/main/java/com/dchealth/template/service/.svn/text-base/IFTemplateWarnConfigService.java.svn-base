package com.dchealth.template.service;

import java.util.List;
import com.dchealth.template.domain.FTemplateWarnConfig;

/**
 * 模板预警信息Service接口
 * 
 * @author lchbu
 * @date 2022-08-31
 */
public interface IFTemplateWarnConfigService 
{
    /**
     * 查询模板预警信息
     * 
     * @param id 模板预警信息主键
     * @return 模板预警信息
     */
    public FTemplateWarnConfig selectFTemplateWarnConfigById(Long id);

    /**
     * 查询模板预警信息列表
     * 
     * @param fTemplateWarnConfig 模板预警信息
     * @return 模板预警信息集合
     */
