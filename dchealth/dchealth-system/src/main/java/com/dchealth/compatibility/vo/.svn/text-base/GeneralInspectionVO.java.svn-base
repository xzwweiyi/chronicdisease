package com.dchealth.compatibility.vo;

import java.util.Date;

import lombok.Data;

@Data
public class GeneralInspectionVO {
		private String personId;//医院系统患者ID
		private String checkDate;//就诊日期
		private String visitId;//就诊ID
		private String sex;
		 /** 患者电话 */
	    private String phoneNumber;
	    /** 家庭住址 */
	    private String address;
	    /** 联系人 */
	    private String contactsName;
	
	    /** 联系人电话 */
	    private String contactsPhone;
	    
	    /** 婚姻状况名称 */
	    private String maritalStatus;
	    private String birthDay;
	
	    /** 文化程度名称 */
	    private String degreeOfEducation;
	    private String idCard;

	    /** 就诊类型名称 */
	    private String visitTypeName;

	    /** 报告时间 */
	    private String resultTime;

	    /** 身高(cm) */
	    private String height;

	    /** 体重(kg) */
	    private String weight;

	    /** 体温℃ */
	    private String bodyTemperature;

	    /** 呼吸（次/分） */
	    private String respiratoryRate;

	    /** 脉搏（次/分） */
	    private String pulseRate;

	    /** 收缩压（mmhg） */
	    private String systolicBloodPressure;

	    /** 舒张压（mmhg） */
	    private String diastolicBloodPressure;

	    /** 尿量(ml) */
	    private String urine;

	    /** 结果日期 */
	    private String resultDate;
	    private String age;
	    private String personName;
	    private String vision;//视力(体检)
	    private String waist;//腰围(体检)
	    
	    private String summaryDate;//结论日期
	    private String examSummary;//终检结论
	    private String healthGuide;//体检提示及建议

	   
}
