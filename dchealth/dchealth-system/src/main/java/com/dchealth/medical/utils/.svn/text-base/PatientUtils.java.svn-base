package com.dchealth.medical.utils;

/**
 * @Author jiaorui
 * @Date 2023/8/18
 * @Description:
 */
public class PatientUtils {

    /**
     * 获取性别
     *
     * @param sex
     * @return
     */
    public static String getSexName(String sex) {
        switch (sex){
            case "1": // 男
                return "男";
            case "2": // 女
                return "女";
            default :
                return "未知";
        }
    }
}
