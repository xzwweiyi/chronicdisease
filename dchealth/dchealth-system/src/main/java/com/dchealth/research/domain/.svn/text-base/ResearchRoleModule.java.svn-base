package com.dchealth.research.domain;

import lombok.Data;

@Data
public class ResearchRoleModule {
  private Long roleId;//角色id
  private Long  followId;//模块id

  public ResearchRoleModule(){}

  public ResearchRoleModule(Long roleId, Long followId){
    this.roleId = roleId;
    this.followId = followId;
  }
}
