    private List<Long> dealChild(List<ResearchSource> child, List<Long> longList) {
        if (child!= null && child.size()>0){
            for (ResearchSource researchSource : child) {
                Long sourceId = researchSource.getSourceId();
                longList.add(sourceId);
                List<ResearchSource> child1 = researchSource.getChild();
                if (child1 != null && child1.size()>0 ){
                    dealChild(child1, longList);
                }
            }
        }
        return longList;
    }

    /**
     * 修改队列基础信息
     * 
     * @param vo 队列基础信息
     * @return 结果
     */
    @Override
    public int updateResearchInfo(ResearchInfoVo vo)
    {
        //更新基础信息
        ResearchInfo researchInfo = new ResearchInfo();
        BeanUtils.copyBeanProp(researchInfo,vo);
        researchInfo.setUpdateTime(DateUtils.getNowDate());
        researchInfoMapper.updateResearchInfo(researchInfo);
        //更新详细信息
        ResearchDetail researchDetail = new ResearchDetail();
        researchDetail.setResearchId(researchInfo.getId());
        researchDetail.setResearchScheme(vo.getResearchScheme());
        researchDetail.setResearchStandard(vo.getResearchStandard());
        return researchDetailMapper.updateResearchDetail(researchDetail);
    }

