    /**
     * 根据id查询详细信息
     * @param id
     * @return
     */
    @Override
    public ResearchInfoVo selectResearchInfoDetailById(Long id) {
        ResearchInfoVo researchInfoVo = researchInfoMapper.selectResearchInfoDetailById(id);
        if (researchInfoVo != null){
            if (researchInfoVo.getDeptId() != null){
                SysDept sysDept = sysDeptMapper.selectDeptById(researchInfoVo.getDeptId());
                if (sysDept != null){
                    researchInfoVo.setDeptName(sysDept.getDeptName());
                }
            }
            if (researchInfoVo.getDiseaseTypeId() != null){
                ResearchDiseases researchDiseases = researchDiseasesMapper.selectResearchDiseasesByDiseaseId(researchInfoVo.getDiseaseTypeId());
                if (researchDiseases != null){
                    researchInfoVo.setDiseasesName(researchDiseases.getDiseaseName());
                }
            }

            if(researchInfoVo.getDoctorId()!=null){
                SysUser sysUser = sysUserMapper.selectUserById(researchInfoVo.getDoctorId());
                if(sysUser!=null){
                    researchInfoVo.setDoctorName(sysUser.getNickName());
                }
            }
        }
        return researchInfoVo;
    }

    /**
     * 更新删除状态
     * @param id
     * @return
     */
    @Override
    public int updateInfoDelFlagById(Long id) {
        int delResearchNum = researchInfoMapper.updateInfoDelFlagById(id);
        Long[] researchIds = {id};
        int delResearchArticleNum = researchInfoArticleMapper.deleteResearchInfoArticleByResearchIds(researchIds);
        if (delResearchNum > 0) {
            return 1;
        } else {
            L.info("队列删除失败： researchId:{} delResearchNum:{} delResearchArticleNum:{} ", id, delResearchNum,
                    delResearchArticleNum);
            return -1;
        }
    }

