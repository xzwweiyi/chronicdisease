<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.warn.mapper.WarnLeaveMessageMapper">
    
    <resultMap type="WarnLeaveMessage" id="WarnLeaveMessageResult">
        <result property="id"    column="id"    />
        <result property="recordId"    column="record_id"    />
        <result property="accountId"    column="account_id"    />
        <result property="userType"    column="user_type"    />
        <result property="contentType"    column="content_type"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectWarnLeaveMessageVo">
        select id, record_id, account_id, user_type, content_type, content, create_time from warn_leave_message
    </sql>

    <select id="selectWarnLeaveMessageList" parameterType="WarnLeaveMessage" resultMap="WarnLeaveMessageResult">
        <include refid="selectWarnLeaveMessageVo"/>
        <where>  
            <if test="recordId != null "> and record_id = #{recordId}</if>
            <if test="accountId != null "> and account_id = #{accountId}</if>
            <if test="userType != null  and userType != ''"> and user_type = #{userType}</if>
            <if test="contentType != null  and contentType != ''"> and content_type = #{contentType}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
        </where>
    </select>
    
    <select id="selectWarnLeaveMessageById" parameterType="Long" resultMap="WarnLeaveMessageResult">
        <include refid="selectWarnLeaveMessageVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWarnLeaveMessage" parameterType="WarnLeaveMessage" useGeneratedKeys="true" keyProperty="id">
        insert into warn_leave_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordId != null">record_id,</if>
            <if test="accountId != null">account_id,</if>
            <if test="userType != null">user_type,</if>
            <if test="contentType != null">content_type,</if>
            <if test="content != null">content,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recordId != null">#{recordId},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="userType != null">#{userType},</if>
            <if test="contentType != null">#{contentType},</if>
            <if test="content != null">#{content},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateWarnLeaveMessage" parameterType="WarnLeaveMessage">
        update warn_leave_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="recordId != null">record_id = #{recordId},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="contentType != null">content_type = #{contentType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWarnLeaveMessageById" parameterType="Long">
        delete from warn_leave_message where id = #{id}
    </delete>

    <delete id="deleteWarnLeaveMessageByIds" parameterType="String">
        delete from warn_leave_message where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>