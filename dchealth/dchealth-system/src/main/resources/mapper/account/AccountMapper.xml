<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.account.mapper.AccountMapper">
    
    <resultMap type="Account" id="AccountResult">
        <result property="id"    column="id"    />
        <result property="nickName"    column="nick_name"    />
        <result property="headImage"    column="head_image"    />
        <result property="accountNo"    column="account_no"    />
        <result property="accountName"    column="account_name"    />
        <result property="realName"    column="real_name"    />
        <result property="letterName"    column="letter_name"    />
        <result property="idCardNo"    column="id_card_no"    />
        <result property="mobile"    column="mobile"    />
        <result property="email"    column="email"    />
        <result property="sex"    column="sex"    />
        <result property="loginPasswd"    column="login_passwd"    />
        <result property="payPasswd"    column="pay_passwd"    />
        <result property="status"    column="status"    />
        <result property="saltVal"    column="salt_val"    />
        <result property="userUniqueCode"    column="user_unique_code"    />
        <result property="accountType"    column="account_type"    />
        <result property="showType"    column="show_type"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="openId"    column="open_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="dataSources"    column="data_sources"    />
        <result property="positionType"    column="position_type"    />
        <result property="nativePlace"    column="native_place"    />
        <result property="unionid"    column="unionid"    />
    </resultMap>

    <sql id="selectAccountVo">
        select id, nick_name, head_image, account_no, account_name, real_name, letter_name, id_card_no, mobile, email, sex, login_passwd, pay_passwd, status, salt_val, user_unique_code, account_type, show_type, tenant_id, open_id, create_time, update_time, data_sources, position_type, native_place, unionid from account
    </sql>

    <select id="selectAccountList" parameterType="Account" resultMap="AccountResult">
        <include refid="selectAccountVo"/>
        <where>  
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="headImage != null  and headImage != ''"> and head_image = #{headImage}</if>
            <if test="accountNo != null  and accountNo != ''"> and account_no = #{accountNo}</if>
            <if test="accountName != null  and accountName != ''"> and account_name like concat('%', #{accountName}, '%')</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="letterName != null  and letterName != ''"> and letter_name like concat('%', #{letterName}, '%')</if>
            <if test="idCardNo != null  and idCardNo != ''"> and id_card_no = #{idCardNo}</if>
            <if test="mobile != null  and mobile != ''"> and mobile = #{mobile}</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="sex != null  and sex != ''"> and sex = #{sex}</if>
            <if test="loginPasswd != null  and loginPasswd != ''"> and login_passwd = #{loginPasswd}</if>
            <if test="payPasswd != null  and payPasswd != ''"> and pay_passwd = #{payPasswd}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="saltVal != null  and saltVal != ''"> and salt_val = #{saltVal}</if>
            <if test="userUniqueCode != null  and userUniqueCode != ''"> and user_unique_code = #{userUniqueCode}</if>
            <if test="accountType != null  and accountType != ''"> and account_type = #{accountType}</if>
            <if test="showType != null  and showType != ''"> and show_type = #{showType}</if>
            <if test="tenantId != null  and tenantId != ''"> and tenant_id = #{tenantId}</if>
            <if test="openId != null  and openId != ''"> and open_id = #{openId}</if>
            <if test="dataSources != null  and dataSources != ''"> and data_sources = #{dataSources}</if>
            <if test="positionType != null  and positionType != ''"> and position_type = #{positionType}</if>
            <if test="nativePlace != null  and nativePlace != ''"> and native_place = #{nativePlace}</if>
            <if test="unionid != null  and unionid != ''"> and unionid = #{unionid}</if>
        </where>
    </select>
    
    <select id="selectAccountById" parameterType="String" resultMap="AccountResult">
        <include refid="selectAccountVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAccount" parameterType="Account">
        insert into account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="headImage != null">head_image,</if>
            <if test="accountNo != null">account_no,</if>
            <if test="accountName != null">account_name,</if>
            <if test="realName != null">real_name,</if>
            <if test="letterName != null">letter_name,</if>
            <if test="idCardNo != null">id_card_no,</if>
            <if test="mobile != null and mobile != ''">mobile,</if>
            <if test="email != null">email,</if>
            <if test="sex != null">sex,</if>
            <if test="loginPasswd != null">login_passwd,</if>
            <if test="payPasswd != null">pay_passwd,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="saltVal != null">salt_val,</if>
            <if test="userUniqueCode != null">user_unique_code,</if>
            <if test="accountType != null">account_type,</if>
            <if test="showType != null">show_type,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="openId != null">open_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="dataSources != null">data_sources,</if>
            <if test="positionType != null">position_type,</if>
            <if test="nativePlace != null">native_place,</if>
            <if test="unionid != null">unionid,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="headImage != null">#{headImage},</if>
            <if test="accountNo != null">#{accountNo},</if>
            <if test="accountName != null">#{accountName},</if>
            <if test="realName != null">#{realName},</if>
            <if test="letterName != null">#{letterName},</if>
            <if test="idCardNo != null">#{idCardNo},</if>
            <if test="mobile != null and mobile != ''">#{mobile},</if>
            <if test="email != null">#{email},</if>
            <if test="sex != null">#{sex},</if>
            <if test="loginPasswd != null">#{loginPasswd},</if>
            <if test="payPasswd != null">#{payPasswd},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="saltVal != null">#{saltVal},</if>
            <if test="userUniqueCode != null">#{userUniqueCode},</if>
            <if test="accountType != null">#{accountType},</if>
            <if test="showType != null">#{showType},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="openId != null">#{openId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="dataSources != null">#{dataSources},</if>
            <if test="positionType != null">#{positionType},</if>
            <if test="nativePlace != null">#{nativePlace},</if>
            <if test="unionid != null">#{unionid},</if>
         </trim>
    </insert>

    <update id="updateAccount" parameterType="Account">
        update account
        <trim prefix="SET" suffixOverrides=",">
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="headImage != null">head_image = #{headImage},</if>
            <if test="accountNo != null">account_no = #{accountNo},</if>
            <if test="accountName != null">account_name = #{accountName},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="letterName != null">letter_name = #{letterName},</if>
            <if test="idCardNo != null">id_card_no = #{idCardNo},</if>
            <if test="mobile != null and mobile != ''">mobile = #{mobile},</if>
            <if test="email != null">email = #{email},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="loginPasswd != null">login_passwd = #{loginPasswd},</if>
            <if test="payPasswd != null">pay_passwd = #{payPasswd},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="saltVal != null">salt_val = #{saltVal},</if>
            <if test="userUniqueCode != null">user_unique_code = #{userUniqueCode},</if>
            <if test="accountType != null">account_type = #{accountType},</if>
            <if test="showType != null">show_type = #{showType},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="openId != null">open_id = #{openId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="dataSources != null">data_sources = #{dataSources},</if>
            <if test="positionType != null">position_type = #{positionType},</if>
            <if test="nativePlace != null">native_place = #{nativePlace},</if>
            <if test="unionid != null">unionid = #{unionid},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAccountById" parameterType="String">
        delete from account where id = #{id}
    </delete>

    <delete id="deleteAccountByIds" parameterType="String">
        delete from account where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>