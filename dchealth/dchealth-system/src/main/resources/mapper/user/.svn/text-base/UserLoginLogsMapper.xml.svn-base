<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.user.mapper.UserLoginLogsMapper">

    <resultMap type="UserLoginLogs" id="UserLoginLogsResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="eventName"    column="event_name"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectUserLoginLogsVo">
        select id, user_id, event_name, remark, create_time from user_login_logs
    </sql>

    <select id="selectUserLoginLogsList" parameterType="UserLoginLogs" resultMap="UserLoginLogsResult">
        <include refid="selectUserLoginLogsVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="eventName != null  and eventName != ''"> and event_name like concat('%', #{eventName}, '%')</if>
        </where>
    </select>

    <select id="selectUserLoginLogsById" parameterType="Long" resultMap="UserLoginLogsResult">
        <include refid="selectUserLoginLogsVo"/>
        where id = #{id}
    </select>

    <insert id="insertUserLoginLogs" parameterType="UserLoginLogs" useGeneratedKeys="true" keyProperty="id">
        insert into user_login_logs
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="eventName != null">event_name,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="eventName != null">#{eventName},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateUserLoginLogs" parameterType="UserLoginLogs">
        update user_login_logs
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="eventName != null">event_name = #{eventName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUserLoginLogsById" parameterType="Long">
        delete from user_login_logs where id = #{id}
    </delete>

    <delete id="deleteUserLoginLogsByIds" parameterType="String">
        delete from user_login_logs where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>