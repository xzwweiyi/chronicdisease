<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.user.mapper.UserImagesMapper">

    <resultMap type="UserImages" id="UserImagesResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="type"    column="type"    />
        <result property="sort"    column="sort"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectUserImagesVo">
        select id, user_id, image_url, type, sort, create_time from user_images
    </sql>

    <select id="selectUserImagesList" parameterType="UserImages" resultMap="UserImagesResult">
        <include refid="selectUserImagesVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="sort != null "> and sort = #{sort}</if>
        </where>
    </select>

    <select id="selectUserImagesById" parameterType="Long" resultMap="UserImagesResult">
        <include refid="selectUserImagesVo"/>
        where id = #{id}
    </select>

    <insert id="insertUserImages" parameterType="UserImages" useGeneratedKeys="true" keyProperty="id">
        insert into user_images
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="type != null">type,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="type != null">#{type},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateUserImages" parameterType="UserImages">
        update user_images
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="type != null">type = #{type},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUserImagesById" parameterType="Long">
        delete from user_images where id = #{id}
    </delete>

    <delete id="deleteUserImagesByIds" parameterType="String">
        delete from user_images where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>