<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.template.mapper.FMedicalFormMapper">

    <resultMap type="FMedicalForm" id="FMedicalFormResult">
        <result property="medicalFormId"    column="medical_form_id"    />
        <result property="medicalCode"    column="medical_code"    />
        <result property="medicalName"    column="medical_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="openImage"    column="open_image"    />
        <result property="openProperty"    column="open_property"    />
        <result property="openMultiple"    column="open_multiple"    />
        <result property="attribute"    column="attribute"    />
        <result property="formType"    column="form_type"    />
        <result property="scoresTotalVal"    column="scores_total_val"    />
        <result property="followId"    column="follow_id"    />
        <result property="articleId"    column="article_id"    />
        <result property="formSource"    column="form_source"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="dynamic"    column="dynamic"    />
        <result property="propertyNum"    column="property_num"    />
        <result property="edcNum"    column="edc_num"    />
        <result property="lockFlag"    column="lock_flag"    />
        <result property="openCollapse"    column="open_collapse"    />
        <result property="selfEvaluationType" column="self_evaluation_type"/>
    </resultMap>

    <sql id="selectFMedicalFormVo">
        select medical_form_id, medical_code, medical_name, parent_id, open_image, open_property, open_multiple, attribute,article_id,form_source,form_type,scores_total_val,follow_id, create_time, update_time, create_by, update_by,dynamic, lock_flag, open_collapse, sort_num
        from f_medical_form
    </sql>

    <sql id="selectFMedicalFormOtherVo">
        select f.medical_form_id, f.medical_code, f.medical_name, f.parent_id, f.open_image, f.open_property, f.open_multiple, f.attribute,f.article_id,
        f.form_source,f.form_type,f.scores_total_val,f.follow_id, f.create_time, f.update_time, f.create_by, f.update_by,f.dynamic, f.open_collapse,f.sort_num,
        (select count(1) from f_medical_property where medical_form_id=f.medical_form_id) property_num,
        (select count(1) from f_medical_form where parent_id=f.medical_form_id and form_type='2') edc_num
        from f_medical_form f
    </sql>

    <select id="selectFMedicalFormList" parameterType="FMedicalForm" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormOtherVo"/>
        <where>
            <if test="medicalCode != null  and medicalCode != ''"> and f.medical_code = #{medicalCode}</if>
            <if test="medicalName != null  and medicalName != ''"> and f.medical_name like concat('%', #{medicalName}, '%')</if>
            <if test="parentId != null "> and f.parent_id = #{parentId}</if>
            <if test="openImage != null  and openImage != ''"> and f.open_image = #{openImage}</if>
            <if test="openProperty != null  and openProperty != ''"> and f.open_property = #{openProperty}</if>
            <if test="openMultiple != null  and openMultiple != ''"> and f.open_multiple = #{openMultiple}</if>
            <if test="attribute != null  and attribute != ''"> and f.attribute = #{attribute}</if>
            <if test="formType != null  and formType != ''"> and f.form_type = #{formType}</if>
            <if test="followId != null  and followId != ''"> and f.follow_id = #{followId}</if>
            <if test="articleId != null "> and f.article_id = #{articleId}</if>
            <if test="formSource != null  and formSource != ''"> and f.form_source = #{formSource}</if>
            <if test="dynamic != null  and dynamic != ''"> and f.dynamic = #{dynamic}</if>
        </where>
        order by sort_num,create_time asc
    </select>

    <select id="selectFMedicalFormByMedicalFormId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where medical_form_id = #{medicalFormId}
    </select>

    <select id="selectFMedicalFormByFollowId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId}
        order by sort_num,create_time asc
    </select>

    <insert id="insertFMedicalForm" parameterType="FMedicalForm" useGeneratedKeys="true" keyProperty="medicalFormId">
        insert into f_medical_form
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="medicalCode != null and medicalCode != ''">medical_code,</if>
            <if test="medicalName != null">medical_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="openImage != null">open_image,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="openMultiple != null">open_multiple,</if>
            <if test="attribute != null">attribute,</if>
            <if test="formType != null and formType != ''">form_type,</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">scores_total_val,</if>
            <if test="followId != null and followId != ''">follow_id,</if>
            <if test="formSource != null and formSource != ''">form_source,</if>
            <if test="articleId != null ">article_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="dynamic != null and dynamic != ''">dynamic,</if>
            <if test="lockFlag != null and lockFlag != ''">lock_flag,</if>
            <if test="openCollapse != null and openCollapse != ''">open_collapse,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="selfEvaluationType != null">self_evaluation_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="medicalCode != null and medicalCode != ''">#{medicalCode},</if>
            <if test="medicalName != null">#{medicalName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="openImage != null">#{openImage},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="openMultiple != null">#{openMultiple},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="formType != null and formType != ''">#{formType},</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">#{scoresTotalVal},</if>
            <if test="followId != null and followId != ''">#{followId},</if>
            <if test="formSource != null and formSource != ''">#{formSource},</if>
            <if test="articleId != null ">#{articleId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="dynamic != null and dynamic != ''">#{dynamic},</if>
            <if test="lockFlag != null and lockFlag != ''">#{lockFlag},</if>
            <if test="openCollapse != null and openCollapse != ''">#{openCollapse},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="selfEvaluationType != null">#{selfEvaluationType},</if>
        </trim>
    </insert>

    <update id="updateFMedicalForm" parameterType="FMedicalForm">
        update f_medical_form
        <trim prefix="SET" suffixOverrides=",">
            <if test="medicalCode != null and medicalCode != ''">medical_code = #{medicalCode},</if>
            <if test="medicalName != null">medical_name = #{medicalName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="openImage != null">open_image = #{openImage},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="openMultiple != null">open_multiple = #{openMultiple},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="formType != null and formType != ''">form_type = #{formType},</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">scores_total_val = #{scoresTotalVal},</if>
            <if test="followId != null and followId != ''">follow_id = #{followId},</if>
            <if test="formSource != null and formSource != ''">form_source = #{formSource},</if>
            <if test="articleId != null ">article_id = #{articleId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="dynamic != null and dynamic != ''">dynamic = #{dynamic},</if>
            <if test="lockFlag != null and lockFlag != ''">lock_flag = #{lockFlag},</if>
            <if test="openCollapse != null and openCollapse != ''">open_collapse = #{openCollapse},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="selfEvaluationType != null">self_evaluation_type = #{selfEvaluationType},</if>
        </trim>
        where medical_form_id = #{medicalFormId}
    </update>

    <update id="updateFMedicalFormParentSortNum" parameterType="FMedicalForm">
        update f_medical_form set sort_num = #{sortNum} where parent_id = #{parentId}
    </update>

    <delete id="deleteFMedicalFormByMedicalFormId" parameterType="Long">
        delete from f_medical_form where medical_form_id = #{medicalFormId}
    </delete>

    <delete id="deleteFMedicalFormByMedicalFollowId" parameterType="Long">
        delete from f_medical_form where follow_id = #{followId}
    </delete>

    <delete id="deleteFMedicalFormByMedicalFormIds" parameterType="String">
        delete from f_medical_form where medical_form_id in
        <foreach item="medicalFormId" collection="array" open="(" separator="," close=")">
            #{medicalFormId}
        </foreach>
    </delete>

    <select id="selectFMedicalFormByArticleId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where article_id = #{articleId}
    </select>

    <select id="selectFMedicalFormByFollowIdAndParentId" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId} and parent_id = #{parentId}
    </select>

    <select id="selectFMedicalFormByMedicalFollowId" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId}
    </select>

<!--    <select id="selectFMedicalFormByMedicalFollowId2" parameterType="Long" resultMap="FMedicalFormResult">-->
<!--        <include refid="selectFMedicalFormVo"/>-->
<!--        where follow_id = #{followId} and medical_form_id not in ( select parent_id from f_medical_form where follow_id=#{followId} and parent_id>0 )-->
<!--        order by sort_num,create_time asc-->
<!--    </select>-->

    <select id="selectFMedicalFormByMedicalFollowId2" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId}
        order by sort_num,create_time asc
    </select>

    <select id="selectFMedicalFormJoinByMedicalFollowId" parameterType="Long" resultMap="FMedicalFormResult">
        select m.medical_form_id, m.follow_id, m.medical_code, m.medical_name, m.parent_id, m.open_image, m.open_property,
        m.open_multiple, m.attribute, m.version_code, m.form_type, m.article_id, m.form_source, m.dynamic, m.create_time,
        m.update_time, m.create_by, m.update_by, if(q.question_id, 1, 0) as checked, m.open_collapse
        from f_medical_form m
        left join question_record_form q on q.medical_form_id=m.medical_form_id and q.record_id = #{recordId}
        where m.follow_id = #{followId}
    </select>

    <select id="selectFMedicalFormByFollowIds" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where parent_id = 0 and follow_id in
        <foreach collection="list" item="followId" open="(" separator="," close=")">
            #{followId}
        </foreach>
        order by create_time
    </select>

    <select id="queryFMedicalFormList" parameterType="Long" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where  follow_id in
        <foreach collection="followIds" item="followId" open="(" separator="," close=")">
            #{followId}
        </foreach> and parent_id=0
        order by create_time desc
    </select>

    <select id="selectFMedicalForm" resultMap="FMedicalFormResult">
        <include refid="selectFMedicalFormVo"/>
        where follow_id = #{followId} and medical_form_id=#{medicalFormId}
    </select>

    <update id="updateScoreByMedicalFormId">
        update f_medical_form set scores_total_val=#{scoresTotalVal} where medical_form_id=#{medicalFormId}
    </update>

    <select id="selectMinStatusByRecordIdAndMedicalFormId" resultType="Integer">
        select min(k.edc_status)
        from (
                 select pr.name,g.medical_form_id,IFNULL(pres.edc_status,1)  edc_status
                 from f_medical_form g
                          INNER JOIN patient_record pr on g.follow_id=pr.follow_id
                          left JOIN patient_record_edc_status pres on g.medical_form_id=pres.medical_form_id and pres.record_id=pr.record_id
                 where pr.record_id=#{recordId} and g.follow_id=#{followId} and g.parent_id=0
             ) k
    </select>

</mapper>
