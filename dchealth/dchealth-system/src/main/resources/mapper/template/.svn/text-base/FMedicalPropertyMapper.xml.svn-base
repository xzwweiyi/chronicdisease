<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.template.mapper.FMedicalPropertyMapper">

    <resultMap type="FMedicalProperty" id="FMedicalPropertyResult">
        <result property="id"    column="id"    />
        <result property="propertyCode"    column="property_code"    />
        <result property="propertyName"    column="property_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="propertyType"    column="property_type"    />
        <result property="dictType"    column="dict_type"    />
        <result property="medicalFormId"    column="medical_form_id"    />
        <result property="openProperty"    column="open_property"    />
        <result property="attribute"    column="attribute"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="followId"    column="follow_id"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="articleId"    column="article_id"    />
    </resultMap>

    <sql id="selectFMedicalPropertyVo">
        select id, property_code, property_name, parent_id, property_type, dict_type, medical_form_id, open_property, attribute, create_by, create_time,follow_id,sort_num, article_id from f_medical_property
    </sql>

    <select id="selectFMedicalPropertyList" parameterType="FMedicalProperty" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        <where>
            <if test="propertyCode != null  and propertyCode != ''"> and property_code = #{propertyCode}</if>
            <if test="propertyName != null  and propertyName != ''"> and property_name like concat('%', #{propertyName}, '%')</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="propertyType != null  and propertyType != ''"> and property_type = #{propertyType}</if>
            <if test="dictType != null  and dictType != ''"> and dict_type = #{dictType}</if>
            <if test="medicalFormId != null "> and medical_form_id = #{medicalFormId}</if>
            <if test="followId != null "> and follow_id = #{followId}</if>
            <if test="openProperty != null  and openProperty != ''"> and open_property = #{openProperty}</if>
            <if test="attribute != null  and attribute != ''"> and attribute = #{attribute}</if>
            <if test="articleId != null  and articleId != ''"> and article_id = #{articleId}</if>
        </where>
    </select>

    <select id="selectPropertyNumsList" parameterType="FMedicalProperty" resultMap="FMedicalPropertyResult">
        select g.id,g.property_name,fmf.parent_id
        from f_medical_property g
        LEFT JOIN f_medical_form fmf on g.medical_form_id=fmf.medical_form_id
        <where>
            fmf.parent_id>0 and fmf.form_type!='2'
            <if test="followId != null "> and fmf.follow_id = #{followId}</if>
        </where>
    </select>

    <select id="selectFMedicalPropertyById" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where id = #{id}
    </select>

    <select id="selectFMedicalPropertyByFollowId" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where follow_id = #{followId}
    </select>

    <select id="selectFMedicalPropertyByMedicalFormId" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where medical_form_id = #{medicalFormId}
        order by sort_num
    </select>

    <insert id="insertFMedicalProperty" parameterType="FMedicalProperty" useGeneratedKeys="true" keyProperty="id">
        insert into f_medical_property
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code,</if>
            <if test="propertyName != null and propertyName != ''">property_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="propertyType != null">property_type,</if>
            <if test="dictType != null">dict_type,</if>
            <if test="medicalFormId != null">medical_form_id,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="attribute != null">attribute,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="followId != null">follow_id,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="articleId != null">article_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">#{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">#{propertyName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="propertyType != null">#{propertyType},</if>
            <if test="dictType != null">#{dictType},</if>
            <if test="medicalFormId != null">#{medicalFormId},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="followId != null">#{followId},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="articleId != null">#{articleId},</if>
         </trim>
    </insert>

    <insert id="batchInsertFMedicalProperty">
        insert into f_medical_property(property_code, property_name,parent_id,property_type,dict_type,medical_form_id,open_property,attribute,create_by,create_time,follow_id,sort_num,article_id) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.propertyCode},#{item.propertyName},#{item.parentId},#{item.propertyType},#{item.dictType},#{item.medicalFormId},#{item.openProperty},#{item.attribute},#{item.createBy},#{item.createTime},#{item.followId},#{item.sortNum},#{item.articleId})
        </foreach>
    </insert>

    <update id="updateFMedicalProperty" parameterType="FMedicalProperty">
        update f_medical_property
        <trim prefix="SET" suffixOverrides=",">
            <if test="propertyCode != null and propertyCode != ''">property_code = #{propertyCode},</if>
            <if test="propertyName != null and propertyName != ''">property_name = #{propertyName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="propertyType != null">property_type = #{propertyType},</if>
            <if test="dictType != null">dict_type = #{dictType},</if>
            <if test="medicalFormId != null">medical_form_id = #{medicalFormId},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="followId != null">follow_id = #{followId},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="articleId != null">article_id = #{articleId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFMedicalPropertyById" parameterType="Long">
        delete from f_medical_property where id = #{id}
    </delete>

    <delete id="deleteFMedicalPropertyByMedicalFormId" parameterType="Long">
        delete from f_medical_property where medical_form_id = #{id}
    </delete>

    <delete id="deleteFMedicalPropertyByMedicalFollowId" parameterType="Long">
        delete from f_medical_property where follow_id = #{followId}
    </delete>

    <delete id="deleteFMedicalPropertyByIds" parameterType="String">
        delete from f_medical_property where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectFMedicalPropertyByMedicalFormIds" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where medical_form_id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectFMedicalValues" resultType="com.dchealth.template.domain.vo.FMedicalValueVo">
        ${sql}
    </select>

    <select id="selectFMedicalPropertyByArticleId" parameterType="Long" resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where article_id = #{articleId}
    </select>

    <insert id="runInsertSql">
        ${sql}
    </insert>

    <insert id="runInsertLogSql">
        ${sqlLog}
    </insert>

    <select id="runSelectSql" resultType="java.util.Map" >
        ${selectSql}
    </select>
    <delete id="runDelSql">
        ${delSql}
    </delete>


    <select id="selectFMedicalProperty"  resultMap="FMedicalPropertyResult">
        <include refid="selectFMedicalPropertyVo"/>
        where follow_id = #{followId} and medical_form_id=#{medicalFormId}
    </select>
</mapper>
