<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.template.mapper.FTemplateFormMapper">
    
    <resultMap type="FTemplateForm" id="FTemplateFormResult">
        <result property="templateFormId"    column="template_form_id"    />
        <result property="templateId"    column="template_id"    />
        <result property="templateCode"    column="template_code"    />
        <result property="templateName"    column="template_name"    />
        <result property="parentId"    column="parent_id"    />
        <result property="openImage"    column="open_image"    />
        <result property="openProperty"    column="open_property"    />
        <result property="openMultiple"    column="open_multiple"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="attribute"    column="attribute"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="formType"    column="form_type"    />
        <result property="scoresTotalVal"    column="scores_total_val"    />
        <result property="dynamic"    column="dynamic"    />
        <result property="propertyNum"    column="property_num"    />
        <result property="edcNum"    column="edc_num"    />
    </resultMap>

    <sql id="selectFTemplateFormVo">
        select template_form_id, template_id, template_code, template_name, parent_id, open_image, open_property, open_multiple, create_time, update_time,
               create_by, update_by, attribute,sort_num,form_type,scores_total_val,dynamic
        from f_template_form
    </sql>

    <sql id="selectFTemplateFormOtherVo">
        select t.template_form_id, t.template_id, t.template_code, t.template_name, t.parent_id, t.open_image, t.open_property, t.open_multiple, t.create_time, t.update_time, t.create_by, t.update_by, t.attribute
        ,t.sort_num,t.form_type,t.scores_total_val,t.dynamic,
        (select count(1) from f_template_property where template_form_id=t.template_form_id) property_num,
        (select count(1) from f_template_form where parent_id=t.template_form_id and form_type='2') edc_num
        from f_template_form t
    </sql>

    <select id="selectFTemplateFormList" parameterType="FTemplateForm" resultMap="FTemplateFormResult">
        <include refid="selectFTemplateFormOtherVo"/>
        <where>  
            <if test="templateId != null "> and t.template_id = #{templateId}</if>
            <if test="templateCode != null  and templateCode != ''"> and t.template_code = #{templateCode}</if>
            <if test="templateName != null  and templateName != ''"> and t.template_name like concat('%', #{templateName}, '%')</if>
            <if test="parentId != null "> and t.parent_id = #{parentId}</if>
            <if test="openImage != null  and openImage != ''"> and t.open_image = #{openImage}</if>
            <if test="openProperty != null  and openProperty != ''"> and t.open_property = #{openProperty}</if>
            <if test="openMultiple != null  and openMultiple != ''"> and t.open_multiple = #{openMultiple}</if>
            <if test="attribute != null  and attribute != ''"> and t.attribute = #{attribute}</if>
            <if test="formType != null  and formType != ''"> and t.form_type = #{formType}</if>
            <if test="dynamic != null  and dynamic != ''"> and t.dynamic = #{dynamic}</if>
        </where>
    </select>
    
    <select id="selectFTemplateFormByTemplateFormId" parameterType="Long" resultMap="FTemplateFormResult">
        <include refid="selectFTemplateFormVo"/>
        where template_form_id = #{templateFormId}
    </select>

    <select id="selectFTemplateFormByTemplateId" parameterType="Long" resultMap="FTemplateFormResult">
        <include refid="selectFTemplateFormVo"/>
        where template_id = #{templateId}
    </select>
        
    <insert id="insertFTemplateForm" parameterType="FTemplateForm" useGeneratedKeys="true" keyProperty="templateFormId">
        insert into f_template_form
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateId != null">template_id,</if>
            <if test="templateCode != null and templateCode != ''">template_code,</if>
            <if test="templateName != null">template_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="openImage != null">open_image,</if>
            <if test="openProperty != null">open_property,</if>
            <if test="openMultiple != null">open_multiple,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="attribute != null">attribute,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="formType != null and formType != ''">form_type,</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">scores_total_val,</if>
            <if test="dynamic != null and dynamic != ''">dynamic,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateId != null">#{templateId},</if>
            <if test="templateCode != null and templateCode != ''">#{templateCode},</if>
            <if test="templateName != null">#{templateName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="openImage != null">#{openImage},</if>
            <if test="openProperty != null">#{openProperty},</if>
            <if test="openMultiple != null">#{openMultiple},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="attribute != null">#{attribute},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="formType != null and formType != ''">#{formType},</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">#{scoresTotalVal},</if>
            <if test="dynamic != null and dynamic != ''">#{dynamic},</if>
         </trim>
    </insert>

    <update id="updateFTemplateForm" parameterType="FTemplateForm">
        update f_template_form
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="templateCode != null and templateCode != ''">template_code = #{templateCode},</if>
            <if test="templateName != null">template_name = #{templateName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="openImage != null">open_image = #{openImage},</if>
            <if test="openProperty != null">open_property = #{openProperty},</if>
            <if test="openMultiple != null">open_multiple = #{openMultiple},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="attribute != null">attribute = #{attribute},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="formType != null and formType != ''">form_type = #{formType},</if>
            <if test="scoresTotalVal != null and scoresTotalVal != ''">scores_total_val = #{scoresTotalVal},</if>
            <if test="dynamic != null and dynamic != ''">dynamic = #{dynamic},</if>
        </trim>
        where template_form_id = #{templateFormId}
    </update>

    <delete id="deleteFTemplateFormByTemplateFormId" parameterType="Long">
        delete from f_template_form where template_form_id = #{templateFormId}
    </delete>

    <delete id="deleteFTemplateFormByTemplateId" parameterType="Long">
        delete from f_template_form where template_id = #{id}
    </delete>

    <delete id="deleteFTemplateFormByTemplateFormIds" parameterType="String">
        delete from f_template_form where template_form_id in 
        <foreach item="templateFormId" collection="array" open="(" separator="," close=")">
            #{templateFormId}
        </foreach>
    </delete>

    <select id="queryTemplateFromByTemId" parameterType="Long" resultMap="FTemplateFormResult">
        <include refid="selectFTemplateFormVo"/>
        where template_id = #{templateId}
    </select>

    <update id="updateScoreByTemplateFormId">
        update f_template_form set scores_total_val=#{scoresTotalVal} where template_form_id=#{templateFormId}
    </update>

</mapper>