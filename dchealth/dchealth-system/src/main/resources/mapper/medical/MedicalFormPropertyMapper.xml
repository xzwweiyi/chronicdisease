    <select id="selectFollowPatientInfoList"
            parameterType="MedicalFormProperty"
            resultType="com.dchealth.medical.domain.MedicalFormProperty">

        SELECT c.patient_id patientId,
        c.record_id recordId,
        c.follow_id followId,
        c.research_id researchId,
        e.project_name researchName,
        c.warn_status warnStatus,
        c.lose_type loseType,
        c.lose_reason loseReason,
        c.`name` name,
        a.medical_form_id medicalFormId,
        b.medical_code medicalCode,
        b.form_type formType,
        a.property_code propertyCode,
        a.property_type propertyType,
        b.medical_name medicalName,
        b.attribute medicalAttribute,
        a.parent_id parentId,
        a.property_name propertyName,
        a.attribute propertyAttribute,
        c.create_time createTime,
        a.id propertyId,
        d.person_id personId
        FROM f_medical_property a
        left JOIN
        `f_medical_form` b on a.medical_form_id = b.medical_form_id
        left JOIN patient_record c on c.follow_id = b.follow_id
        left JOIN `patient_info` d on c.patient_id = d.patient_id
        LEFT JOIN research_info e on e.id = d.research_id
        where c.fill_status = '1' and b.form_type in ('0', '1', '3') and b.is_deleted = 0 and a.is_deleted = 0
        <if test="createTime != null">
            and c.create_time &gt;= #{createTime}
        </if>

        union all

        SELECT c.patient_id patientId,
        c.record_id recordId,
        c.follow_id followId,
        c.research_id researchId,
        e.project_name researchName,
        c.warn_status warnStatus,
        c.lose_type loseType,
        c.lose_reason loseReason,
        c.`name` name,
        a.medical_form_id medicalFormId,
        b.medical_code medicalCode,
        b.form_type formType,
        a.property_code propertyCode,
        a.property_type propertyType,
        b.medical_name medicalName,
        b.attribute medicalAttribute,
        a.parent_id parentId,
        a.property_name propertyName,
        a.attribute propertyAttribute,
        c.create_time createTime,
        a.id propertyId,
        d.person_id personId
        FROM f_medical_property a
        left JOIN
        `f_medical_form` b on a.medical_form_id = b.medical_form_id
        left JOIN patient_record c on c.follow_id = b.follow_id
        left JOIN `patient_info` d on c.patient_id = d.patient_id
        LEFT JOIN research_info e on e.id = d.research_id
        where c.fill_status = '1' and b.form_type in ('0', '1', '3') and b.is_deleted = 0 and a.is_deleted = 0
        <if test="createTime != null">
            and c.create_time &gt;= #{createTime}
        </if>
    </select>
