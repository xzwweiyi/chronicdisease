    <sql id="selectMedicalFormPropertyVo">
        select id, record_id, patient_id, research_id, follow_id, medical_form_id, medical_code, form_type, property_code, property_type, name, warn_status, lose_type, lose_reason, medical_name, medical_attribute, parent_id, property_name, property_attribute, label, value, other, property_id, create_time, update_time from medical_form_property
    </sql>

    <select id="selectMedicalFormPropertyList" parameterType="MedicalFormProperty" resultMap="MedicalFormPropertyResult">
        <include refid="selectMedicalFormPropertyVo"/>
        <where>
            <if test="recordId != null ">and record_id = #{recordId}</if>
            <if test="patientId != null ">and patient_id = #{patientId}</if>
            <if test="researchId != null ">and research_id = #{researchId}</if>
            <if test="followId != null ">and follow_id = #{followId}</if>
            <if test="medicalFormId != null ">and medical_form_id = #{medicalFormId}</if>
            <if test="medicalCode != null  and medicalCode != ''">and medical_code = #{medicalCode}</if>
            <if test="formType != null  and formType != ''">and form_type = #{formType}</if>
            <if test="propertyCode != null  and propertyCode != ''">and property_code = #{propertyCode}</if>
            <if test="propertyType != null  and propertyType != ''">and property_type = #{propertyType}</if>
            <if test="name != null  and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="warnStatus != null  and warnStatus != ''">and warn_status = #{warnStatus}</if>
            <if test="loseType != null  and loseType != ''">and lose_type = #{loseType}</if>
            <if test="loseReason != null  and loseReason != ''">and lose_reason = #{loseReason}</if>
            <if test="medicalName != null  and medicalName != ''">and medical_name like concat('%', #{medicalName},
                '%')
            </if>
            <if test="medicalAttribute != null  and medicalAttribute != ''">and medical_attribute =
                #{medicalAttribute}
            </if>
            <if test="parentId != null ">and parent_id = #{parentId}</if>
            <if test="propertyName != null  and propertyName != ''">and property_name like concat('%', #{propertyName},
                '%')
            </if>
            <if test="propertyAttribute != null  and propertyAttribute != ''">and property_attribute =
                #{propertyAttribute}
            </if>
            <if test="label != null  and label != ''">and label = #{label}</if>
            <if test="value != null  and value != ''">and value = #{value}</if>
            <if test="other != null  and other != ''">and other = #{other}</if>
            <if test="propertyId != null ">and property_id = #{propertyId}</if>
            <if test="propertyIds != null and propertyIds != ''">
                and property_id in
                <foreach item="item" index="index" collection="propertyIds" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    
    <select id="selectMedicalFormPropertyById" parameterType="Long" resultMap="MedicalFormPropertyResult">
        <include refid="selectMedicalFormPropertyVo"/>
        where id = #{id}
    </select>
        
