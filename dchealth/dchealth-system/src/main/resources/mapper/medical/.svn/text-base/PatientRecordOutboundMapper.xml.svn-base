            <if test="isDownloadSound != null">#{isDownloadSound},</if>
            <if test="localRecordUrl != null">#{localRecordUrl},</if>
        </trim>
    </insert>

    <update id="updatePatientRecordOutbound" parameterType="PatientRecordOutbound">
        update patient_record_outbound
        <trim prefix="SET" suffixOverrides=",">
            <if test="recordId != null">record_id = #{recordId},</if>
            <if test="researchId != null">research_id = #{researchId},</if>
            <if test="outboundId != null">outbound_id = #{outboundId},</if>
            <if test="speechId != null">speech_id = #{speechId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="stageNum != null">stage_num = #{stageNum},</if>
            <if test="outboundType != null">outbound_type = #{outboundType},</if>
            <if test="remindType != null">remind_type = #{remindType},</if>
            <if test="outboundTime != null">outbound_time = #{outboundTime},</if>
            <if test="planVisitTime != null">plan_visit_time = #{planVisitTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="batch != null">batch = #{batch},</if>
            <if test="taskId != null">task_Id = #{taskId},</if>
            <if test="xunfeiRecordId != null">xunfei_record_id = #{xunfeiRecordId},</if>
            <if test="xunfeiSpeechId != null">xunfei_speech_id = #{xunfeiSpeechId},</if>
            <if test="xunfeiCallTime != null">xunfei_call_time = #{xunfeiCallTime},</if>
            <if test="xunfeiTaskTime != null">xunfei_task_time = #{xunfeiTaskTime},</if>
            <if test="xunfeiPlanName != null">xunfei_plan_name = #{xunfeiPlanName},</if>
            <if test="xunfeiSpeechName != null">xunfei_speech_name = #{xunfeiSpeechName},</if>
            <if test="xunfeiCalltimeLength != null">xunfei_callTime_length = #{xunfeiCalltimeLength},</if>
            <if test="xunfeiCallResult != null">xunfei_call_result = #{xunfeiCallResult},</if>
            <if test="xunfeiResultCode != null">xunfei_result_code = #{xunfeiResultCode},</if>
            <if test="xunfeiEndNode != null">xunfei_end_node = #{xunfeiEndNode},</if>
            <if test="xunfeiRecordUrl != null">xunfei_record_url = #{xunfeiRecordUrl},</if>
            <if test="xunfeiSmsName != null">xunfei_sms_name = #{xunfeiSmsName},</if>
            <if test="xunfeiSmsContent != null">xunfei_sms_content = #{xunfeiSmsContent},</if>
            <if test="xunfeiDialog != null">xunfei_dialog = #{xunfeiDialog},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="isDownloadSound != null">is_download_sound = #{isDownloadSound},</if>
            <if test="localRecordUrl != null">local_record_url = #{localRecordUrl},</if>
        </trim>
        where id = #{id}
    </update>

    <insert id="batchInsertList">
        insert into
        patient_record_outbound(record_id,research_id,outbound_id,speech_id,name,stage_num,outbound_type,remind_type,outbound_time,plan_visit_time,status,create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.recordId},#{item.researchId},#{item.outboundId},#{item.speechId},#{item.name},#{item.stageNum},#{item.outboundType},#{item.remindType},
             #{item.outboundTime},#{item.planVisitTime},#{item.status},#{item.createTime})
        </foreach>
    </insert>

    <delete id="deletePatientRecordOutboundById" parameterType="Long">
        delete from patient_record_outbound where id = #{id}
    </delete>

    <delete id="deletePatientRecordOutboundByIds" parameterType="String">
        delete from patient_record_outbound where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByOutboundAndRemindType" resultMap="PatientRecordOutboundResult">
        <include refid="selectPatientRecordOutboundVo"/>
        where g.record_id = #{recordId} and g.outbound_type = #{outboundType} and g.remind_type = #{remindType}  limit 0,1
    </select>


    <select id="selectOne" parameterType="PatientRecordOutbound" resultMap="PatientRecordOutboundResult">
        <include refid="selectPatientRecordOutboundVo"/>
        <where>
            <if test="recordId != null "> and g.record_id = #{recordId}</if>
            <if test="researchId != null "> and g.research_id = #{researchId}</if>
            <if test="outboundId != null "> and g.outbound_id = #{outboundId}</if>
            <if test="stageNum != null "> and g.stage_num = #{stageNum}</if>
            <if test="outboundType != null  and outboundType != ''"> and g.outbound_type = #{outboundType}</if>
            <if test="remindType != null  and remindType != ''"> and g.remind_type = #{remindType}</if>
            <if test="status != null  and status != ''"> and g.status = #{status}</if>
            <if test="isDownloadSound != null  and isDownloadSound != ''"> and g.is_download_sound = #{isDownloadSound}</if>

            <if test="patientName != null  and patientName != '' "> and pi.patient_name like concat('%', #{patientName}, '%')</if>
            <if test="patientId != null  and patientId != '' "> and pi.patient_id like concat('%', #{patientId}, '%')</if>
        </where>
        limit 0,1
    </select>
    <select id="selectOneId" parameterType="PatientRecordOutbound" resultMap="PatientRecordOutboundResult">
          select g.id
        from patient_record_outbound g
        INNER JOIN patient_record pr on g.record_id=pr.record_id
        INNER JOIN patient_info pi on pi.patient_id=pr.patient_id
        INNER JOIN research_info ri on pr.research_id=ri.id and ri.del_flag=0
        <where>
            <if test="recordId != null "> and g.record_id = #{recordId}</if>
            <if test="researchId != null "> and g.research_id = #{researchId}</if>
            <if test="outboundId != null "> and g.outbound_id = #{outboundId}</if>
            <if test="stageNum != null "> and g.stage_num = #{stageNum}</if>
            <if test="outboundType != null  and outboundType != ''"> and g.outbound_type = #{outboundType}</if>
            <if test="remindType != null  and remindType != ''"> and g.remind_type = #{remindType}</if>
            <if test="status != null  and status != ''"> and g.status = #{status}</if>
            <if test="isDownloadSound != null  and isDownloadSound != ''"> and g.is_download_sound = #{isDownloadSound}</if>

            <if test="patientName != null  and patientName != '' "> and pi.patient_name like concat('%', #{patientName}, '%')</if>
            <if test="patientId != null  and patientId != '' "> and pi.patient_id like concat('%', #{patientId}, '%')</if>
        </where>
        limit 0,1
    </select>

</mapper>