<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.research.mapper.ResearchRoleDeptMapper">


    <resultMap type="ResearchRoleDept" id="ResearchRoleDeptResult">
        <result property="roleId"     column="role_id"      />
        <result property="deptId"   column="dept_id"    />
    </resultMap>

    <sql id="selectResearchRoleDeptVo">
        select role_id, dept_id from research_role_dept
    </sql>


    <delete id="deleteRoledept" parameterType="Long">
		delete from research_role_dept where role_id = #{roleId}
	</delete>

    <insert id="batchRoleDept">
        insert into research_role_dept(role_id, dept_id) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.roleId},#{item.deptId})
        </foreach>
    </insert>

    <delete id="deleteRoleDeptByRoleIds" parameterType="Long">
        delete from research_role_dept where role_id in
        <foreach collection="array" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <select id="findRoleDeptByRoleId" parameterType="Long" resultMap="ResearchRoleDeptResult">
        <include refid="selectResearchRoleDeptVo"/>
        where role_id = #{roleId}
    </select>

    <select id="findRoleDeptByRoleIds" parameterType="Long" resultMap="ResearchRoleDeptResult">
        <include refid="selectResearchRoleDeptVo"/>
        where role_id in
        <foreach collection="list" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <delete id="deleteRoleDeptByRoleIdAndDeptIds" parameterType="Long">
        delete from research_role_dept where role_id = #{roleId} and  dept_id in
        <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
            #{deptId}
        </foreach>
    </delete>

    <delete id="deleteRoleDeptByRoleIdAndDeptId" parameterType="Long">
        delete from research_role_dept where role_id = #{roleId} and  dept_id = #{deptId}
    </delete>

</mapper>