    </update>

    <update id="updateResearchOutbound2" parameterType="ResearchOutbound">
        update research_outbound
        <trim prefix="SET" suffixOverrides=",">
            follow_advance_days = #{followAdvanceDays},
            follow_advance_time = #{followAdvanceTime},
            follow_speech_id = #{followSpeechId},
            follow_replay = #{followReplay},
            follow_replay_space_minute = #{followReplaySpaceMinute},
            follow_mail_content = #{followMailContent},
            over_advance_days = #{overAdvanceDays},
