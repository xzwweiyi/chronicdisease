    </update>

    <update id="updateSetDelByResearchId" parameterType="Long">
        update research_outbound set del_flag='1' where research_id=#{researchId}
    </update>

    <delete id="deleteResearchOutboundById" parameterType="Long">
        delete from research_outbound where id = #{id}
    </delete>

    <delete id="deleteResearchOutboundByIds" parameterType="String">
        delete from research_outbound where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
