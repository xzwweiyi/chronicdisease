<mapper namespace="com.dchealth.research.mapper.ResearchOutboundMapper">
    
    <resultMap type="ResearchOutbound" id="ResearchOutboundResult">
        <result property="id"    column="id"    />
        <result property="researchId"    column="research_id"    />
        <result property="type"    column="type"    />
        <result property="followAdvanceDays"    column="follow_advance_days"    />
        <result property="followAdvanceTime"    column="follow_advance_time"    />
        <result property="followSpeechId"    column="follow_speech_id"    />
        <result property="followReplay"    column="follow_replay"    />
