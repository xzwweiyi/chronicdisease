    <sql id="selectResearchOutboundVo">
        select id, research_id, type, follow_advance_days, follow_advance_time, follow_speech_id, follow_replay, follow_replay_space_minute,
        follow_mail_content, over_advance_days, over_advance_time, over_speech_id, over_replay, over_replay_space_minute, over_mail_content,
        warn_speech_id, warn_replay, warn_replay_space_minute, del_flag, update_by, create_by, create_time, update_time
        from research_outbound
    </sql>

    <select id="selectResearchOutboundList" parameterType="ResearchOutbound" resultMap="ResearchOutboundResult">
        <include refid="selectResearchOutboundVo"/>
        <where>
            <if test="researchId != null  and researchId != ''"> and research_id = #{researchId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="followAdvanceDays != null "> and follow_advance_days = #{followAdvanceDays}</if>
            <if test="followAdvanceTime != null  and followAdvanceTime != ''"> and follow_advance_time = #{followAdvanceTime}</if>
            <if test="followSpeechId != null "> and follow_speech_id = #{followSpeechId}</if>
            <if test="followReplay != null  and followReplay != ''"> and follow_replay = #{followReplay}</if>
            <if test="followReplaySpaceMinute != null "> and follow_replay_space_minute = #{followReplaySpaceMinute}</if>
            <if test="followMailContent != null  and followMailContent != ''"> and follow_mail_content = #{followMailContent}</if>
            <if test="overAdvanceDays != null "> and over_advance_days = #{overAdvanceDays}</if>
            <if test="overAdvanceTime != null  and overAdvanceTime != ''"> and over_advance_time = #{overAdvanceTime}</if>
            <if test="overSpeechId != null "> and over_speech_id = #{overSpeechId}</if>
            <if test="overReplay != null  and overReplay != ''"> and over_replay = #{overReplay}</if>
            <if test="overReplaySpaceMinute != null "> and over_replay_space_minute = #{overReplaySpaceMinute}</if>
            <if test="overMailContent != null  and overMailContent != ''"> and over_mail_content = #{overMailContent}</if>
            <if test="warnSpeechId != null "> and warn_speech_id = #{warnSpeechId}</if>
            <if test="warnReplay != null  and warnReplay != ''"> and warn_replay = #{warnReplay}</if>
            <if test="warnReplaySpaceMinute != null "> and warn_replay_space_minute = #{warnReplaySpaceMinute}</if>
            <if test="delFlag != null "> and del_flag = #{delFlag}</if>
        </where>
    </select>
    
    <select id="selectResearchOutboundById" parameterType="Long" resultMap="ResearchOutboundResult">
        <include refid="selectResearchOutboundVo"/>
        where id = #{id}
    </select>

    <select id="selectByResearchIdAndType" resultMap="ResearchOutboundResult">
        <include refid="selectResearchOutboundVo"/>
         where research_id = #{researchId} and type = #{type} and del_flag='0' limit 1 OFFSET 0
    </select>

    <insert id="insertResearchOutbound" parameterType="ResearchOutbound" useGeneratedKeys="true" keyProperty="id">
        insert into research_outbound
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="researchId != null">research_id,</if>
            <if test="type != null">type,</if>
            <if test="followAdvanceDays != null">follow_advance_days,</if>
            <if test="followAdvanceTime != null">follow_advance_time,</if>
            <if test="followSpeechId != null">follow_speech_id,</if>
            <if test="followReplay != null">follow_replay,</if>
            <if test="followReplaySpaceMinute != null">follow_replay_space_minute,</if>
            <if test="followMailContent != null">follow_mail_content,</if>
            <if test="overAdvanceDays != null">over_advance_days,</if>
            <if test="overAdvanceTime != null">over_advance_time,</if>
            <if test="overSpeechId != null">over_speech_id,</if>
            <if test="overReplay != null">over_replay,</if>
            <if test="overReplaySpaceMinute != null">over_replay_space_minute,</if>
            <if test="overMailContent != null">over_mail_content,</if>
            <if test="warnSpeechId != null">warn_speech_id,</if>
            <if test="warnReplay != null">warn_replay,</if>
            <if test="warnReplaySpaceMinute != null">warn_replay_space_minute,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="researchId != null">#{researchId},</if>
            <if test="type != null">#{type},</if>
            <if test="followAdvanceDays != null">#{followAdvanceDays},</if>
            <if test="followAdvanceTime != null">#{followAdvanceTime},</if>
            <if test="followSpeechId != null">#{followSpeechId},</if>
            <if test="followReplay != null">#{followReplay},</if>
            <if test="followReplaySpaceMinute != null">#{followReplaySpaceMinute},</if>
            <if test="followMailContent != null">#{followMailContent},</if>
            <if test="overAdvanceDays != null">#{overAdvanceDays},</if>
            <if test="overAdvanceTime != null">#{overAdvanceTime},</if>
            <if test="overSpeechId != null">#{overSpeechId},</if>
            <if test="overReplay != null">#{overReplay},</if>
            <if test="overReplaySpaceMinute != null">#{overReplaySpaceMinute},</if>
            <if test="overMailContent != null">#{overMailContent},</if>
            <if test="warnSpeechId != null">#{warnSpeechId},</if>
            <if test="warnReplay != null">#{warnReplay},</if>
            <if test="warnReplaySpaceMinute != null">#{warnReplaySpaceMinute},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateResearchOutbound" parameterType="ResearchOutbound">
        update research_outbound
        <trim prefix="SET" suffixOverrides=",">
            <if test="researchId != null">research_id = #{researchId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="followAdvanceDays != null">follow_advance_days = #{followAdvanceDays},</if>
            <if test="followAdvanceTime != null">follow_advance_time = #{followAdvanceTime},</if>
            <if test="followSpeechId != null">follow_speech_id = #{followSpeechId},</if>
            <if test="followReplay != null">follow_replay = #{followReplay},</if>
            <if test="followReplaySpaceMinute != null">follow_replay_space_minute = #{followReplaySpaceMinute},</if>
            <if test="followMailContent != null">follow_mail_content = #{followMailContent},</if>
            <if test="overAdvanceDays != null">over_advance_days = #{overAdvanceDays},</if>
            <if test="overAdvanceTime != null">over_advance_time = #{overAdvanceTime},</if>
            <if test="overSpeechId != null">over_speech_id = #{overSpeechId},</if>
            <if test="overReplay != null">over_replay = #{overReplay},</if>
            <if test="overReplaySpaceMinute != null">over_replay_space_minute = #{overReplaySpaceMinute},</if>
