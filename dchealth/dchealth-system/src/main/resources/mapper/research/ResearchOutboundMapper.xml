            over_speech_id = #{overSpeechId},
            over_replay = #{overReplay},
            over_replay_space_minute = #{overReplaySpaceMinute},
            over_mail_content = #{overMailContent},
            warn_speech_id = #{warnSpeechId},
            warn_replay = #{warnReplay},
            warn_replay_space_minute = #{warnReplaySpaceMinute},
            del_flag = #{delFlag},
            <if test="updateBy != null">update_by = #{updateBy},</if>
