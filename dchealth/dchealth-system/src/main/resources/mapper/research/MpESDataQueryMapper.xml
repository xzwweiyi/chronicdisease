<!--        where c.result_date = #{params.startDate}-->
<!--        order by c.id asc-->
<!--        limit #{params.offset}, #{params.pageSize}-->

        SELECT
        a.id as baseId,a.person_id as patient_id ,a.person_name as name,a.marital_status , a.gender_source_value as sex, SUBSTRING(a.card_id, 7, 8) AS 'birthday',
        a.phone_number as mobile,b.diagnosis_desc ,b.diagnosis_date,'1' esDataType,b.result_date, b.visit_occurrence_id,
        a.care_site_id,c.account_id
        FROM
        mp_person a INNER JOIN mp_diagnosis b ON a.person_id = b.person_id
        left JOIN mp_patient_account c on a.person_id=c.person_id
        where b.result_date = #{params.startDate}
        order by b.id asc
