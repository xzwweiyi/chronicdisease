    <select id="queryDiagnosisInfosCount" resultType="integer">
        select count(td.id)
        from patient_base_info pbi
        inner join td_diagnosis td on pbi.patient_id = td.patient_id
        where td.result_date = #{startDate}
    </select>

    <select id="queryDiagnosisInfosCount2" resultType="integer">
        SELECT
        count(a.id)
        FROM
        mp_person a INNER JOIN mp_diagnosis b ON a.person_id = b.person_id
        left JOIN mp_patient_account c on a.person_id=c.person_id
        where b.result_date = #{startDate}
    </select>

    <select id="queryDiagnosisInfos" resultMap="TdHealthIndexMap">
        select pbi.id baseId,pbi.patient_id ,pbi.account_id ,pbi.registry_signs ,pbi.medical_record_no ,pbi.name ,pbi.birthday ,pbi.age ,pbi.sex ,pbi.marital_status ,
        pbi.nation ,pbi.id_card ,pbi.mobile ,pbi.present_address ,pbi.admission_hospital_date ,pbi.admission_hospital_date ,
        pbi.discharge_hospital_date ,pbi.dept_discharge_from ,pbi.last_visit_date ,pbi.patient_clinic_time,
        td.diagnosis_type ,td.diagnosis_no ,td.diagnosis_desc ,td.diagnosis_date,td.id,'1' esDataType
        from patient_base_info pbi
        inner join td_diagnosis td on pbi.patient_id = td.patient_id
        where td.result_date = #{startDate}
        order by td.id asc
        limit #{offset}, #{pageSize}
    </select>
