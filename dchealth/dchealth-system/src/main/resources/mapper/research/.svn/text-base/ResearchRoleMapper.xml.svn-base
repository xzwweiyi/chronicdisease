<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.research.mapper.ResearchRoleMapper">


    <resultMap type="ResearchRole" id="ResearchRoleResult">
        <id     property="roleId"             column="role_id"               />
        <result property="researchId"         column="research_id"           />
        <result property="roleName"           column="role_name"             />
        <result property="roleKey"            column="role_key"              />
        <result property="roleSort"           column="role_sort"             />
        <result property="dataScope"          column="data_scope"            />
        <result property="status"             column="status"                />
        <result property="delFlag"            column="del_flag"              />
        <result property="createBy"           column="create_by"             />
        <result property="createTime"         column="create_time"           />
        <result property="updateBy"           column="update_by"             />
        <result property="updateTime"         column="update_time"           />
        <result property="remark"             column="remark"                />
        <result property="userQuatity"             column="user_quatity"                />
    </resultMap>

    <sql id="selectResearchRoleVo">
	    select distinct r.role_id, r.research_id, r.role_name, r.role_key, r.role_sort, r.data_scope,
            r.status, r.del_flag, r.create_by, r.create_time, r.update_by, r.update_time, r.remark,
            (select count(1) from research_user_role rur where rur.role_id=r.role_id) user_quatity
        from research_role r
    </sql>

    <select id="checkRoleNameUnique" resultMap="ResearchRoleResult">
        select * from research_role where research_id = #{researchId} and del_flag = 0 and role_name = #{roleName} limit 1
    </select>

    <select id="checkRoleKeyUnique" resultMap="ResearchRoleResult">
        select * from research_role where research_id = #{researchId} and del_flag = 0  and role_key = #{roleKey} limit 1
    </select>

    <select id="selectResearchRoleList" parameterType="ResearchRole" resultMap="ResearchRoleResult">
        <include refid="selectResearchRoleVo"/>
        where r.del_flag = '0' and r.research_id = #{researchId}
        <if test="roleId != null and roleId != 0">
            AND r.role_id = #{roleId}
        </if>
        <if test="roleName != null and roleName != ''">
            AND r.role_name like concat('%', #{roleName}, '%')
        </if>
        <if test="status != null and status != ''">
            AND r.status = #{status}
        </if>
        <if test="roleKey != null and roleKey != ''">
            AND r.role_key like concat('%', #{roleKey}, '%')
        </if>
        <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
            and date_format(r.create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
        </if>
        <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
            and date_format(r.create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
        </if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
        order by r.role_sort
    </select>



    <insert id="insertResearchRole" parameterType="ResearchRole" useGeneratedKeys="true" keyProperty="roleId">
        insert into research_role
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="researchId != null">research_id,</if>
            <if test="roleName != null and roleName != '' ">role_name,</if>
            <if test="roleKey != null and roleKey != '' ">role_key,</if>
            <if test="roleSort != null">role_sort,</if>
            <if test="dataScope != null and dataScope != '' ">data_scope,</if>
            <if test="status != null and status != '' ">status,</if>
            <if test="delFlag != null and delFlag != '' ">del_flag,</if>
            <if test="createBy != null and createBy != '' ">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != '' ">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null and roleKey != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="researchId != null">#{researchId},</if>
            <if test="roleName != null and roleName != '' ">#{roleName},</if>
            <if test="roleKey != null and roleKey != '' ">#{roleKey},</if>
            <if test="roleSort != null">#{roleSort},</if>
            <if test="dataScope != null and dataScope != ''">#{dataScope},</if>
            <if test="status != null and status != '' ">#{status},</if>
            <if test="delFlag != null and delFlag != '' ">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != '' ">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateResearchRole" parameterType="ResearchRole">
        update research_role
        <trim prefix="SET" suffixOverrides=",">
            <if test="researchId != null">research_id = #{researchId},</if>
            <if test="roleName != null and roleName != '' ">role_name = #{roleName},</if>
            <if test="roleKey != null and roleKey != '' ">role_key = #{roleKey},</if>
            <if test="roleSort != null">role_sort = #{roleSort},</if>
            <if test="dataScope != null and dataScope != '' ">data_scope = #{dataScope},</if>
            <if test="status != null and status != '' ">status = #{status},</if>
            <if test="delFlag != null and delFlag != '' ">del_flag = #{delFlag},</if>
            <if test="createBy != null and createBy != '' ">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null and updateBy != '' ">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != '' ">remark = #{remark},</if>
        </trim>
        where role_id = #{roleId}
    </update>

    <select id="findResearchRoleByRoleId" parameterType="Long" resultMap="ResearchRoleResult">
        <include refid="selectResearchRoleVo"/>
        where r.role_id = #{roleId}
    </select>

    <select id="findResearchRoleByResearchId" parameterType="Long" resultMap="ResearchRoleResult">
        <include refid="selectResearchRoleVo"/>
        where r.research_id = #{researchId}
    </select>


    <delete id="deleteRoleByIds" parameterType="Long">
        update research_role set del_flag = '2' where role_id in
        <foreach collection="array" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>


    <select id="findRoleByRoleIds" parameterType="Long" resultMap="ResearchRoleResult">
        <include refid="selectResearchRoleVo"/>
        where r.role_id in
        <foreach collection="list" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

</mapper>