<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.record.DrugPrescMasterMapper">

    <resultMap type="com.dchealth.etl.domain.record.DrugPrescMaster" id="DrugPrescMasterMap">
        <result property="prescDate" column="PRESC_DATE" jdbcType="TIMESTAMP"/>
        <result property="prescNo" column="PRESC_NO" jdbcType="VARCHAR"/>
        <result property="patientId" column="PATIENT_ID" jdbcType="VARCHAR"/>
        <result property="prescType" column="PRESC_TYPE" jdbcType="INTEGER"/>
        <result property="prescSource" column="PRESC_SOURCE" jdbcType="INTEGER"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="DrugPrescMasterMap">
        select
          PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE
        from drug_presc_master
        where  PRESC_NO = #{prescNo}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="DrugPrescMasterMap">
        select
          PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE
        from drug_presc_master
        <where>
            <if test="prescDate != null">
                and PRESC_DATE = #{prescDate}
            </if>
            <if test="prescNo != null and prescNo != ''">
                and PRESC_NO = #{prescNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and PATIENT_ID = #{patientId}
            </if>
            <if test="prescType != null">
                and PRESC_TYPE = #{prescType}
            </if>
            <if test="prescSource != null">
                and PRESC_SOURCE = #{prescSource}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from drug_presc_master
        <where>
            <if test="prescDate != null">
                and PRESC_DATE = #{prescDate}
            </if>
            <if test="prescNo != null and prescNo != ''">
                and PRESC_NO = #{prescNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and PATIENT_ID = #{patientId}
            </if>
            <if test="prescType != null">
                and PRESC_TYPE = #{prescType}
            </if>
            <if test="prescSource != null">
                and PRESC_SOURCE = #{prescSource}
            </if>
        </where>
    </select>
    <select id="querySyncInfoCount" resultType="java.lang.Integer">
        select count(1)
        from drug_presc_master
        <where>
            <if test="params.recordingDate != null">
                and date_format(PRESC_DATE,'%Y-%m-%d') = #{params.recordingDate}
            </if>
        </where>
    </select>
    <select id="querySyncInfoByPage" resultMap="DrugPrescMasterMap">
        select
        PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE
        from drug_presc_master
        <where>
            <if test="drugPrescMaster.params.recordingDate != null">
                and date_format(PRESC_DATE,'%Y-%m-%d') = #{drugPrescMaster.params.recordingDate}
            </if>
        </where>
        order by PRESC_DATE asc,PATIENT_ID asc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="" useGeneratedKeys="true">
        insert into drug_presc_master(PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE)
        values (#{prescDate}, #{prescNo}, #{patientId}, #{prescType}, #{prescSource})
    </insert>

    <insert id="insertBatch" keyProperty="" useGeneratedKeys="true">
        insert into drug_presc_master(PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.prescDate}, #{entity.prescNo}, #{entity.patientId}, #{entity.prescType}, #{entity.prescSource})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="" useGeneratedKeys="true">
        insert into drug_presc_master(PRESC_DATE, PRESC_NO, PATIENT_ID, PRESC_TYPE, PRESC_SOURCE)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.prescDate}, #{entity.prescNo}, #{entity.patientId}, #{entity.prescType}, #{entity.prescSource})
        </foreach>
        on duplicate key update
        PRESC_DATE = values(PRESC_DATE),
        PRESC_NO = values(PRESC_NO),
        PATIENT_ID = values(PATIENT_ID),
        PRESC_TYPE = values(PRESC_TYPE),
        PRESC_SOURCE = values(PRESC_SOURCE)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update drug_presc_master
        <set>
            <if test="prescDate != null">
                PRESC_DATE = #{prescDate},
            </if>
            <if test="prescNo != null and prescNo != ''">
                PRESC_NO = #{prescNo},
            </if>
            <if test="patientId != null and patientId != ''">
                PATIENT_ID = #{patientId},
            </if>
            <if test="prescType != null">
                PRESC_TYPE = #{prescType},
            </if>
            <if test="prescSource != null">
                PRESC_SOURCE = #{prescSource},
            </if>
        </set>
        where PRESC_NO = #{prescNo}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from drug_presc_master where  PRESC_NO = #{prescNo}
    </delete>

</mapper>

