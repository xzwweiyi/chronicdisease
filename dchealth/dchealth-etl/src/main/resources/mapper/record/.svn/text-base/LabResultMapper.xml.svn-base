<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.record.LabResultMapper">

    <resultMap type="com.dchealth.etl.domain.record.LabResult" id="LabResultMap">
        <result property="testNo" column="TEST_NO" jdbcType="VARCHAR"/>
        <result property="itemNo" column="ITEM_NO" jdbcType="VARCHAR"/>
        <result property="printOrder" column="PRINT_ORDER" jdbcType="VARCHAR"/>
        <result property="reportItemName" column="REPORT_ITEM_NAME" jdbcType="VARCHAR"/>
        <result property="reportItemCode" column="REPORT_ITEM_CODE" jdbcType="VARCHAR"/>
        <result property="result" column="RESULT" jdbcType="VARCHAR"/>
        <result property="units" column="UNITS" jdbcType="VARCHAR"/>
        <result property="abnormalIndicator" column="ABNORMAL_INDICATOR" jdbcType="VARCHAR"/>
        <result property="instrumentId" column="INSTRUMENT_ID" jdbcType="VARCHAR"/>
        <result property="resultDateTime" column="RESULT_DATE_TIME" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="LabResultMap">
        select
          TEST_NO, ITEM_NO, PRINT_ORDER, REPORT_ITEM_NAME, REPORT_ITEM_CODE, RESULT, UNITS, ABNORMAL_INDICATOR, INSTRUMENT_ID, RESULT_DATE_TIME
        from lab_result
        where TEST_NO = #{testNo}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="LabResultMap">
        select
          TEST_NO, ITEM_NO, PRINT_ORDER, REPORT_ITEM_NAME, REPORT_ITEM_CODE, RESULT, UNITS, ABNORMAL_INDICATOR, INSTRUMENT_ID, RESULT_DATE_TIME
        from lab_result
        <where>
            <if test="testNo != null and testNo != ''">
                and TEST_NO = #{testNo}
            </if>
            <if test="itemNo != null and itemNo != ''">
                and ITEM_NO = #{itemNo}
            </if>
            <if test="printOrder != null and printOrder != ''">
                and PRINT_ORDER = #{printOrder}
            </if>
            <if test="reportItemName != null and reportItemName != ''">
                and REPORT_ITEM_NAME = #{reportItemName}
            </if>
            <if test="reportItemCode != null and reportItemCode != ''">
                and REPORT_ITEM_CODE = #{reportItemCode}
            </if>
            <if test="result != null and result != ''">
                and RESULT = #{result}
            </if>
            <if test="units != null and units != ''">
                and UNITS = #{units}
            </if>
            <if test="abnormalIndicator != null and abnormalIndicator != ''">
                and ABNORMAL_INDICATOR = #{abnormalIndicator}
            </if>
            <if test="instrumentId != null and instrumentId != ''">
                and INSTRUMENT_ID = #{instrumentId}
            </if>
            <if test="resultDateTime != null">
                and RESULT_DATE_TIME = #{resultDateTime}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from lab_result
        <where>
            <if test="testNo != null and testNo != ''">
                and TEST_NO = #{testNo}
            </if>
            <if test="itemNo != null and itemNo != ''">
                and ITEM_NO = #{itemNo}
            </if>
            <if test="printOrder != null and printOrder != ''">
                and PRINT_ORDER = #{printOrder}
            </if>
            <if test="reportItemName != null and reportItemName != ''">
                and REPORT_ITEM_NAME = #{reportItemName}
            </if>
            <if test="reportItemCode != null and reportItemCode != ''">
                and REPORT_ITEM_CODE = #{reportItemCode}
            </if>
            <if test="result != null and result != ''">
                and RESULT = #{result}
            </if>
            <if test="units != null and units != ''">
                and UNITS = #{units}
            </if>
            <if test="abnormalIndicator != null and abnormalIndicator != ''">
                and ABNORMAL_INDICATOR = #{abnormalIndicator}
            </if>
            <if test="instrumentId != null and instrumentId != ''">
                and INSTRUMENT_ID = #{instrumentId}
            </if>
            <if test="resultDateTime != null">
                and RESULT_DATE_TIME = #{resultDateTime}
            </if>
        </where>
    </select>
    <select id="querySyncInfoCount" resultType="java.lang.Integer">
        select count(1)
        from lab_result lr
        inner join lab_test_master ltm on lr.TEST_NO = ltm.TEST_NO
        <where>
            <if test="testNo != null and testNo != ''">
                and ltm.TEST_NO = #{testNo}
            </if>
            <if test="params.recordingDate != null and params.recordingDate != ''">
                and date_format(ltm.REQUESTED_DATE_TIME,'%Y-%m-%d') =#{params.recordingDate}
            </if>

        </where>
    </select>

    <select id="querySyncInfoByPage" resultMap="LabResultMap">
        select lr.TEST_NO, lr.ITEM_NO, lr.PRINT_ORDER, lr.REPORT_ITEM_NAME, lr.REPORT_ITEM_CODE, lr.RESULT,
        lr.UNITS, lr.ABNORMAL_INDICATOR, lr.INSTRUMENT_ID, lr.RESULT_DATE_TIME
        from lab_result lr
        inner join lab_test_master ltm on lr.TEST_NO = ltm.TEST_NO
        <where>
            <if test="labResult.testNo != null and labResult.testNo != ''">
                and ltm.TEST_NO = #{labResult.testNo}
            </if>
            <if test="labResult.params.recordingDate != null and labResult.params.recordingDate != ''">
                and date_format(ltm.REQUESTED_DATE_TIME,'%Y-%m-%d') =#{labResult.params.recordingDate}
            </if>
        </where>
        order by lr.test_no
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="" useGeneratedKeys="true">
        insert into lab_result(TEST_NO, ITEM_NO, PRINT_ORDER, REPORT_ITEM_NAME, REPORT_ITEM_CODE, RESULT, UNITS, ABNORMAL_INDICATOR, INSTRUMENT_ID, RESULT_DATE_TIME)
        values (#{testNo}, #{itemNo}, #{printOrder}, #{reportItemName}, #{reportItemCode}, #{result}, #{units}, #{abnormalIndicator}, #{instrumentId}, #{resultDateTime})
    </insert>

    <insert id="insertBatch" keyProperty="" useGeneratedKeys="true">
        insert into lab_result(TEST_NO, ITEM_NO, PRINT_ORDER, REPORT_ITEM_NAME, REPORT_ITEM_CODE, RESULT, UNITS, ABNORMAL_INDICATOR, INSTRUMENT_ID, RESULT_DATE_TIME)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.testNo}, #{entity.itemNo}, #{entity.printOrder}, #{entity.reportItemName}, #{entity.reportItemCode}, #{entity.result}, #{entity.units}, #{entity.abnormalIndicator}, #{entity.instrumentId}, #{entity.resultDateTime})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="" useGeneratedKeys="true">
        insert into lab_result(TEST_NO, ITEM_NO, PRINT_ORDER, REPORT_ITEM_NAME, REPORT_ITEM_CODE, RESULT, UNITS, ABNORMAL_INDICATOR, INSTRUMENT_ID, RESULT_DATE_TIME)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.testNo}, #{entity.itemNo}, #{entity.printOrder}, #{entity.reportItemName}, #{entity.reportItemCode}, #{entity.result}, #{entity.units}, #{entity.abnormalIndicator}, #{entity.instrumentId}, #{entity.resultDateTime})
        </foreach>
        on duplicate key update
        TEST_NO = values(TEST_NO),
        ITEM_NO = values(ITEM_NO),
        PRINT_ORDER = values(PRINT_ORDER),
        REPORT_ITEM_NAME = values(REPORT_ITEM_NAME),
        REPORT_ITEM_CODE = values(REPORT_ITEM_CODE),
        RESULT = values(RESULT),
        UNITS = values(UNITS),
        ABNORMAL_INDICATOR = values(ABNORMAL_INDICATOR),
        INSTRUMENT_ID = values(INSTRUMENT_ID),
        RESULT_DATE_TIME = values(RESULT_DATE_TIME)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update lab_result
        <set>
            <if test="testNo != null and testNo != ''">
                TEST_NO = #{testNo},
            </if>
            <if test="itemNo != null and itemNo != ''">
                ITEM_NO = #{itemNo},
            </if>
            <if test="printOrder != null and printOrder != ''">
                PRINT_ORDER = #{printOrder},
            </if>
            <if test="reportItemName != null and reportItemName != ''">
                REPORT_ITEM_NAME = #{reportItemName},
            </if>
            <if test="reportItemCode != null and reportItemCode != ''">
                REPORT_ITEM_CODE = #{reportItemCode},
            </if>
            <if test="result != null and result != ''">
                RESULT = #{result},
            </if>
            <if test="units != null and units != ''">
                UNITS = #{units},
            </if>
            <if test="abnormalIndicator != null and abnormalIndicator != ''">
                ABNORMAL_INDICATOR = #{abnormalIndicator},
            </if>
            <if test="instrumentId != null and instrumentId != ''">
                INSTRUMENT_ID = #{instrumentId},
            </if>
            <if test="resultDateTime != null">
                RESULT_DATE_TIME = #{resultDateTime},
            </if>
        </set>
        where TEST_NO = #{testNo}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from lab_result where TEST_NO = #{testNo}
    </delete>

</mapper>

