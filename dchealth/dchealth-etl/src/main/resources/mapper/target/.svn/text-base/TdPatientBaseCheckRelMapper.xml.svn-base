<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdPatientBaseCheckRelMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdPatientBaseCheckRel" id="TdPatientBaseCheckRelMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="idCardNo" column="id_card_no" jdbcType="VARCHAR"/>
        <result property="studyId" column="study_id" jdbcType="VARCHAR"/>
        <result property="studyDate" column="study_date" jdbcType="TIMESTAMP"/>
        <result property="examiningDoctor" column="examining_doctor" jdbcType="VARCHAR"/>
        <result property="auditCoctor" column="audit_coctor" jdbcType="VARCHAR"/>
        <result property="deptCode" column="dept_Code" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="checkDate" column="check_date" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdPatientBaseCheckRelMap">
        select
          id, id_card_no, study_id, study_date, examining_doctor, audit_coctor, dept_Code, create_time, update_time, check_date
        from td_patient_base_check_rel
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdPatientBaseCheckRelMap">
        select
          id, id_card_no, study_id, study_date, examining_doctor, audit_coctor, dept_Code, create_time, update_time, check_date
        from td_patient_base_check_rel
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="studyDate != null">
                and study_date = #{studyDate}
            </if>
            <if test="examiningDoctor != null and examiningDoctor != ''">
                and examining_doctor = #{examiningDoctor}
            </if>
            <if test="auditCoctor != null and auditCoctor != ''">
                and audit_coctor = #{auditCoctor}
            </if>
            <if test="deptCode != null and deptCode != ''">
                and dept_Code = #{deptCode}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
            <if test="checkDate != null">
                and check_date = #{checkDate}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_patient_base_check_rel
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="studyDate != null">
                and study_date = #{studyDate}
            </if>
            <if test="examiningDoctor != null and examiningDoctor != ''">
                and examining_doctor = #{examiningDoctor}
            </if>
            <if test="auditCoctor != null and auditCoctor != ''">
                and audit_coctor = #{auditCoctor}
            </if>
            <if test="deptCode != null and deptCode != ''">
                and dept_Code = #{deptCode}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
            <if test="checkDate != null">
                and check_date = #{checkDate}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_patient_base_check_rel(id_card_no, study_id, study_date, examining_doctor, audit_coctor, dept_Code, create_time, update_time, check_date)
        values (#{idCardNo}, #{studyId}, #{studyDate}, #{examiningDoctor}, #{auditCoctor}, #{deptCode}, #{createTime}, #{updateTime}, #{checkDate})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_patient_base_check_rel(id_card_no, study_id, study_date, examining_doctor, audit_coctor, dept_Code, create_time, update_time, check_date)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.idCardNo}, #{entity.studyId}, #{entity.studyDate}, #{entity.examiningDoctor}, #{entity.auditCoctor}, #{entity.deptCode}, #{entity.createTime}, #{entity.updateTime}, #{entity.checkDate})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_patient_base_check_rel(id_card_no, study_id, study_date, examining_doctor, audit_coctor, dept_Code, create_time, update_time, check_date)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.idCardNo}, #{entity.studyId}, #{entity.studyDate}, #{entity.examiningDoctor}, #{entity.auditCoctor}, #{entity.deptCode}, #{entity.createTime}, #{entity.updateTime}, #{entity.checkDate})
        </foreach>
        on duplicate key update
        id_card_no = values(id_card_no),
        study_id = values(study_id),
        study_date = values(study_date),
        examining_doctor = values(examining_doctor),
        audit_coctor = values(audit_coctor),
        dept_Code = values(dept_Code),
        create_time = values(create_time),
        update_time = values(update_time),
        check_date = values(check_date)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_patient_base_check_rel
        <set>
            <if test="idCardNo != null and idCardNo != ''">
                id_card_no = #{idCardNo},
            </if>
            <if test="studyId != null and studyId != ''">
                study_id = #{studyId},
            </if>
            <if test="studyDate != null">
                study_date = #{studyDate},
            </if>
            <if test="examiningDoctor != null and examiningDoctor != ''">
                examining_doctor = #{examiningDoctor},
            </if>
            <if test="auditCoctor != null and auditCoctor != ''">
                audit_coctor = #{auditCoctor},
            </if>
            <if test="deptCode != null and deptCode != ''">
                dept_Code = #{deptCode},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="checkDate != null">
                check_date = #{checkDate},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_patient_base_check_rel where id = #{id}
    </delete>

</mapper>

