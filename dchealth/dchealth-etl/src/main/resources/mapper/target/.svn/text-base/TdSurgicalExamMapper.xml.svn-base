<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdSurgicalExamMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdSurgicalExam" id="TdSurgicalExamMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="studyId" column="study_id" jdbcType="VARCHAR"/>
        <result property="examNo" column="exam_no" jdbcType="VARCHAR"/>
        <result property="testNo" column="test_no" jdbcType="VARCHAR"/>
        <result property="abnormalIndicatorHigh" column="abnormal_indicator_high" jdbcType="VARCHAR"/>
        <result property="abnormalIndicatorLow" column="abnormal_indicator_low" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="VARCHAR"/>
        <result property="skin" column="skin" jdbcType="VARCHAR"/>
        <result property="anus" column="anus" jdbcType="VARCHAR"/>
        <result property="superficialLymphNode" column="superficial_lymph_node" jdbcType="VARCHAR"/>
        <result property="thyroid" column="thyroid" jdbcType="VARCHAR"/>
        <result property="spine" column="spine" jdbcType="VARCHAR"/>
        <result property="articulationOfLimbs" column="articulation_of_limbs" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdSurgicalExamMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs
        from td_surgical_exam
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdSurgicalExamMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs
        from td_surgical_exam
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                and abnormal_indicator_high = #{abnormalIndicatorHigh}
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                and abnormal_indicator_low = #{abnormalIndicatorLow}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="skin != null and skin != ''">
                and skin = #{skin}
            </if>
            <if test="anus != null and anus != ''">
                and anus = #{anus}
            </if>
            <if test="superficialLymphNode != null and superficialLymphNode != ''">
                and superficial_lymph_node = #{superficialLymphNode}
            </if>
            <if test="thyroid != null and thyroid != ''">
                and thyroid = #{thyroid}
            </if>
            <if test="spine != null and spine != ''">
                and spine = #{spine}
            </if>
            <if test="articulationOfLimbs != null and articulationOfLimbs != ''">
                and articulation_of_limbs = #{articulationOfLimbs}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_surgical_exam
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                and abnormal_indicator_high = #{abnormalIndicatorHigh}
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                and abnormal_indicator_low = #{abnormalIndicatorLow}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <if test="skin != null and skin != ''">
                and skin = #{skin}
            </if>
            <if test="anus != null and anus != ''">
                and anus = #{anus}
            </if>
            <if test="superficialLymphNode != null and superficialLymphNode != ''">
                and superficial_lymph_node = #{superficialLymphNode}
            </if>
            <if test="thyroid != null and thyroid != ''">
                and thyroid = #{thyroid}
            </if>
            <if test="spine != null and spine != ''">
                and spine = #{spine}
            </if>
            <if test="articulationOfLimbs != null and articulationOfLimbs != ''">
                and articulation_of_limbs = #{articulationOfLimbs}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_surgical_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs)
        values (#{studyId}, #{examNo}, #{testNo}, #{abnormalIndicatorHigh}, #{abnormalIndicatorLow}, #{createTime}, #{updateTime}, #{skin}, #{anus}, #{superficialLymphNode}, #{thyroid}, #{spine}, #{articulationOfLimbs})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_surgical_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.skin}, #{entity.anus}, #{entity.superficialLymphNode}, #{entity.thyroid}, #{entity.spine}, #{entity.articulationOfLimbs})
        </foreach>
    </insert>

    <insert id="insertBatchByMaps" keyProperty="id" useGeneratedKeys="true">
        insert into td_surgical_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.skin}, #{entity.anus}, #{entity.superficialLymphNode}, #{entity.thyroid}, #{entity.spine}, #{entity.articulationOfLimbs})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_surgical_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, skin, anus, superficial_lymph_node, thyroid, spine, articulation_of_limbs)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.skin}, #{entity.anus}, #{entity.superficialLymphNode}, #{entity.thyroid}, #{entity.spine}, #{entity.articulationOfLimbs})
        </foreach>
        on duplicate key update
        study_id = values(study_id),
        exam_no = values(exam_no),
        test_no = values(test_no),
        abnormal_indicator_high = values(abnormal_indicator_high),
        abnormal_indicator_low = values(abnormal_indicator_low),
        create_time = values(create_time),
        update_time = values(update_time),
        skin = values(skin),
        anus = values(anus),
        superficial_lymph_node = values(superficial_lymph_node),
        thyroid = values(thyroid),
        spine = values(spine),
        articulation_of_limbs = values(articulation_of_limbs)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_surgical_exam
        <set>
            <if test="studyId != null and studyId != ''">
                study_id = #{studyId},
            </if>
            <if test="examNo != null and examNo != ''">
                exam_no = #{examNo},
            </if>
            <if test="testNo != null and testNo != ''">
                test_no = #{testNo},
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                abnormal_indicator_high = #{abnormalIndicatorHigh},
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                abnormal_indicator_low = #{abnormalIndicatorLow},
            </if>
            <if test="createTime != null and createTime != ''">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null and updateTime != ''">
                update_time = #{updateTime},
            </if>
            <if test="skin != null and skin != ''">
                skin = #{skin},
            </if>
            <if test="anus != null and anus != ''">
                anus = #{anus},
            </if>
            <if test="superficialLymphNode != null and superficialLymphNode != ''">
                superficial_lymph_node = #{superficialLymphNode},
            </if>
            <if test="thyroid != null and thyroid != ''">
                thyroid = #{thyroid},
            </if>
            <if test="spine != null and spine != ''">
                spine = #{spine},
            </if>
            <if test="articulationOfLimbs != null and articulationOfLimbs != ''">
                articulation_of_limbs = #{articulationOfLimbs},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_surgical_exam where id = #{id}
    </delete>

</mapper>

