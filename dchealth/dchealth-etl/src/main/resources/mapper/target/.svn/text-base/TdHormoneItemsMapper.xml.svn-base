<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdHormoneItemsMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdHormoneItems" id="TdHormoneItemsMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="studyId" column="study_id" jdbcType="VARCHAR"/>
        <result property="examNo" column="exam_no" jdbcType="VARCHAR"/>
        <result property="testNo" column="test_no" jdbcType="VARCHAR"/>
        <result property="abnormalIndicatorHigh" column="abnormal_indicator_high" jdbcType="VARCHAR"/>
        <result property="abnormalIndicatorLow" column="abnormal_indicator_low" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="follicleStimulatingHormone" column="follicle_stimulating_hormone" jdbcType="VARCHAR"/>
        <result property="luteinizingHormone" column="luteinizing_hormone" jdbcType="VARCHAR"/>
        <result property="estradiol" column="estradiol" jdbcType="VARCHAR"/>
        <result property="progesterone" column="progesterone" jdbcType="VARCHAR"/>
        <result property="testosterone" column="testosterone" jdbcType="VARCHAR"/>
        <result property="prolactin" column="prolactin" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdHormoneItemsMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin
        from td_hormone_items
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdHormoneItemsMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin
        from td_hormone_items
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                and abnormal_indicator_high = #{abnormalIndicatorHigh}
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                and abnormal_indicator_low = #{abnormalIndicatorLow}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
            <if test="follicleStimulatingHormone != null and follicleStimulatingHormone != ''">
                and follicle_stimulating_hormone = #{follicleStimulatingHormone}
            </if>
            <if test="luteinizingHormone != null and luteinizingHormone != ''">
                and luteinizing_hormone = #{luteinizingHormone}
            </if>
            <if test="estradiol != null and estradiol != ''">
                and estradiol = #{estradiol}
            </if>
            <if test="progesterone != null and progesterone != ''">
                and progesterone = #{progesterone}
            </if>
            <if test="testosterone != null and testosterone != ''">
                and testosterone = #{testosterone}
            </if>
            <if test="prolactin != null and prolactin != ''">
                and prolactin = #{prolactin}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_hormone_items
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                and abnormal_indicator_high = #{abnormalIndicatorHigh}
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                and abnormal_indicator_low = #{abnormalIndicatorLow}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
            <if test="follicleStimulatingHormone != null and follicleStimulatingHormone != ''">
                and follicle_stimulating_hormone = #{follicleStimulatingHormone}
            </if>
            <if test="luteinizingHormone != null and luteinizingHormone != ''">
                and luteinizing_hormone = #{luteinizingHormone}
            </if>
            <if test="estradiol != null and estradiol != ''">
                and estradiol = #{estradiol}
            </if>
            <if test="progesterone != null and progesterone != ''">
                and progesterone = #{progesterone}
            </if>
            <if test="testosterone != null and testosterone != ''">
                and testosterone = #{testosterone}
            </if>
            <if test="prolactin != null and prolactin != ''">
                and prolactin = #{prolactin}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_hormone_items(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin)
        values (#{studyId}, #{examNo}, #{testNo}, #{abnormalIndicatorHigh}, #{abnormalIndicatorLow}, #{createTime}, #{updateTime}, #{follicleStimulatingHormone}, #{luteinizingHormone}, #{estradiol}, #{progesterone}, #{testosterone}, #{prolactin})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_hormone_items(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.follicleStimulatingHormone}, #{entity.luteinizingHormone}, #{entity.estradiol}, #{entity.progesterone}, #{entity.testosterone}, #{entity.prolactin})
        </foreach>
    </insert>

    <insert id="insertBatchByMaps" keyProperty="id" useGeneratedKeys="true">
        insert into td_hormone_items(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.follicleStimulatingHormone}, #{entity.luteinizingHormone}, #{entity.estradiol}, #{entity.progesterone}, #{entity.testosterone}, #{entity.prolactin})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_hormone_items(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, follicle_stimulating_hormone, luteinizing_hormone, estradiol, progesterone, testosterone, prolactin)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.follicleStimulatingHormone}, #{entity.luteinizingHormone}, #{entity.estradiol}, #{entity.progesterone}, #{entity.testosterone}, #{entity.prolactin})
        </foreach>
        on duplicate key update
        study_id = values(study_id),
        exam_no = values(exam_no),
        test_no = values(test_no),
        abnormal_indicator_high = values(abnormal_indicator_high),
        abnormal_indicator_low = values(abnormal_indicator_low),
        create_time = values(create_time),
        update_time = values(update_time),
        follicle_stimulating_hormone = values(follicle_stimulating_hormone),
        luteinizing_hormone = values(luteinizing_hormone),
        estradiol = values(estradiol),
        progesterone = values(progesterone),
        testosterone = values(testosterone),
        prolactin = values(prolactin)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_hormone_items
        <set>
            <if test="studyId != null and studyId != ''">
                study_id = #{studyId},
            </if>
            <if test="examNo != null and examNo != ''">
                exam_no = #{examNo},
            </if>
            <if test="testNo != null and testNo != ''">
                test_no = #{testNo},
            </if>
            <if test="abnormalIndicatorHigh != null and abnormalIndicatorHigh != ''">
                abnormal_indicator_high = #{abnormalIndicatorHigh},
            </if>
            <if test="abnormalIndicatorLow != null and abnormalIndicatorLow != ''">
                abnormal_indicator_low = #{abnormalIndicatorLow},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="follicleStimulatingHormone != null and follicleStimulatingHormone != ''">
                follicle_stimulating_hormone = #{follicleStimulatingHormone},
            </if>
            <if test="luteinizingHormone != null and luteinizingHormone != ''">
                luteinizing_hormone = #{luteinizingHormone},
            </if>
            <if test="estradiol != null and estradiol != ''">
                estradiol = #{estradiol},
            </if>
            <if test="progesterone != null and progesterone != ''">
                progesterone = #{progesterone},
            </if>
            <if test="testosterone != null and testosterone != ''">
                testosterone = #{testosterone},
            </if>
            <if test="prolactin != null and prolactin != ''">
                prolactin = #{prolactin},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_hormone_items where id = #{id}
    </delete>

</mapper>

