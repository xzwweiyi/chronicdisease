<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdDrugPrescDetailMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdDrugPrescDetail" id="TdDrugPrescDetailMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="prescDate" column="presc_date" jdbcType="TIMESTAMP"/>
        <result property="prescNo" column="presc_no" jdbcType="VARCHAR"/>
        <result property="itemNo" column="item_no" jdbcType="INTEGER"/>
        <result property="drugCode" column="drug_code" jdbcType="VARCHAR"/>
        <result property="drugSpec" column="drug_spec" jdbcType="VARCHAR"/>
        <result property="drugName" column="drug_name" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdDrugPrescDetailMap">
        select
          id, presc_date, presc_no, item_no, drug_code, drug_spec, drug_name
        from td_drug_presc_detail
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdDrugPrescDetailMap">
        select
          id, presc_date, presc_no, item_no, drug_code, drug_spec, drug_name
        from td_drug_presc_detail
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="prescDate != null">
                and presc_date = #{prescDate}
            </if>
            <if test="prescNo != null and prescNo != ''">
                and presc_no = #{prescNo}
            </if>
            <if test="itemNo != null">
                and item_no = #{itemNo}
            </if>
            <if test="drugCode != null and drugCode != ''">
                and drug_code = #{drugCode}
            </if>
            <if test="drugSpec != null and drugSpec != ''">
                and drug_spec = #{drugSpec}
            </if>
            <if test="drugName != null and drugName != ''">
                and drug_name = #{drugName}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_drug_presc_detail
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="prescDate != null">
                and presc_date = #{prescDate}
            </if>
            <if test="prescNo != null and prescNo != ''">
                and presc_no = #{prescNo}
            </if>
            <if test="itemNo != null">
                and item_no = #{itemNo}
            </if>
            <if test="drugCode != null and drugCode != ''">
                and drug_code = #{drugCode}
            </if>
            <if test="drugSpec != null and drugSpec != ''">
                and drug_spec = #{drugSpec}
            </if>
            <if test="drugName != null and drugName != ''">
                and drug_name = #{drugName}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_drug_presc_detail(presc_date, presc_no, item_no, drug_code, drug_spec, drug_name)
        values (#{prescDate}, #{prescNo}, #{itemNo}, #{drugCode}, #{drugSpec}, #{drugName})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_drug_presc_detail(presc_date, presc_no, item_no, drug_code, drug_spec, drug_name)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.prescDate}, #{entity.prescNo}, #{entity.itemNo}, #{entity.drugCode}, #{entity.drugSpec}, #{entity.drugName})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_drug_presc_detail(presc_date, presc_no, item_no, drug_code, drug_spec, drug_name)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.prescDate}, #{entity.prescNo}, #{entity.itemNo}, #{entity.drugCode}, #{entity.drugSpec}, #{entity.drugName})
        </foreach>
        on duplicate key update
        presc_date = values(presc_date),
        presc_no = values(presc_no),
        item_no = values(item_no),
        drug_code = values(drug_code),
        drug_spec = values(drug_spec),
        drug_name = values(drug_name)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_drug_presc_detail
        <set>
            <if test="prescDate != null">
                presc_date = #{prescDate},
            </if>
            <if test="prescNo != null and prescNo != ''">
                presc_no = #{prescNo},
            </if>
            <if test="itemNo != null">
                item_no = #{itemNo},
            </if>
            <if test="drugCode != null and drugCode != ''">
                drug_code = #{drugCode},
            </if>
            <if test="drugSpec != null and drugSpec != ''">
                drug_spec = #{drugSpec},
            </if>
            <if test="drugName != null and drugName != ''">
                drug_name = #{drugName},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_drug_presc_detail where id = #{id}
    </delete>

</mapper>

