<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdExamMasterMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdExamMaster" id="TdExamMasterMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="idCardNo" column="id_card_no" jdbcType="VARCHAR"/>
        <result property="examNo" column="exam_no" jdbcType="VARCHAR"/>
        <result property="patientId" column="patient_id" jdbcType="VARCHAR"/>
        <result property="examDateTime" column="exam_date_time" jdbcType="TIMESTAMP"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="examDate" column="exam_date" jdbcType="TIMESTAMP"/>
        <result property="reqPhysician" column="req_physician" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdExamMasterMap">
        select
          id, id_card_no, exam_no, patient_id, exam_date_time, create_time, update_time, exam_date
        from td_exam_master
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdExamMasterMap">
        select
          id, id_card_no, exam_no, patient_id, exam_date_time, create_time, update_time, exam_date
        from td_exam_master
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and patient_id = #{patientId}
            </if>
            <if test="examDateTime != null">
                and exam_date_time = #{examDateTime}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_exam_master
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="examNo != null and examNo != ''">
                and exam_no = #{examNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and patient_id = #{patientId}
            </if>
            <if test="examDateTime != null">
                and exam_date_time = #{examDateTime}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_exam_master(id_card_no, exam_no, patient_id, exam_date_time, create_time, update_time)
        values (#{idCardNo}, #{examNo}, #{patientId}, #{examDateTime}, #{createTime}, #{updateTime})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_exam_master(id_card_no, exam_no, patient_id, exam_date_time, create_time, update_time, exam_date,req_physician)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.idCardNo}, #{entity.examNo}, #{entity.patientId}, #{entity.examDateTime}, #{entity.createTime}, #{entity.updateTime}, #{entity.examDate}, #{entity.reqPhysician})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_exam_master(id_card_no, exam_no, patient_id, exam_date_time, create_time, update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.idCardNo}, #{entity.examNo}, #{entity.patientId}, #{entity.examDateTime}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
        on duplicate key update
        id_card_no = values(id_card_no),
        exam_no = values(exam_no),
        patient_id = values(patient_id),
        exam_date_time = values(exam_date_time),
        create_time = values(create_time),
        update_time = values(update_time)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_exam_master
        <set>
            <if test="idCardNo != null and idCardNo != ''">
                id_card_no = #{idCardNo},
            </if>
            <if test="examNo != null and examNo != ''">
                exam_no = #{examNo},
            </if>
            <if test="patientId != null and patientId != ''">
                patient_id = #{patientId},
            </if>
            <if test="examDateTime != null">
                exam_date_time = #{examDateTime},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_exam_master where id = #{id}
    </delete>

</mapper>

