        <result property="eyePosition" column="eye_position" jdbcType="VARCHAR"/>
        <result property="eyeMovement" column="eye_movement" jdbcType="VARCHAR"/>
        <result property="eyelid" column="eyelid" jdbcType="VARCHAR"/>
        <result property="conjunctivaOfEyelids" column="conjunctiva_of_eyelids" jdbcType="VARCHAR"/>
        <result property="conjunctivaOfEyeball" column="conjunctiva_of_eyeball" jdbcType="VARCHAR"/>
        <result property="intraocularPressureExam" column="intraocular_pressure_exam" jdbcType="VARCHAR"/>
        <result property="slitLampExam" column="slit_lamp_exam" jdbcType="VARCHAR"/>
        <result property="fundusPhotography" column="fundus_photography" jdbcType="VARCHAR"/>
        <result property="colorVisionExam" column="color_vision_exam" jdbcType="VARCHAR"/>
        <result property="lacrimalApparatus" column="lacrimal_apparatus" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdOphthalmologicalExamMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus
        from td_ophthalmological_exam
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdOphthalmologicalExamMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus
        from td_ophthalmological_exam
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="studyId != null and studyId != ''">
                and study_id = #{studyId}
            </if>
            <if test="examNo != null and examNo != ''">
