    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_ophthalmological_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus)
        values (#{studyId}, #{examNo}, #{testNo}, #{abnormalIndicatorHigh}, #{abnormalIndicatorLow}, #{createTime}, #{updateTime}, #{visualAcuityLeft}, #{visualAcuityRight}, #{correctedVisualAcuityLeft}, #{correctedVisualAcuityRight}, #{eyePosition}, #{eyeMovement}, #{eyelid}, #{conjunctivaOfEyelids}, #{conjunctivaOfEyeball}, #{intraocularPressureExam}, #{slitLampExam}, #{fundusPhotography}, #{colorVisionExam}, #{lacrimalApparatus})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_ophthalmological_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.visualAcuityLeft}, #{entity.visualAcuityRight}, #{entity.correctedVisualAcuityLeft}, #{entity.correctedVisualAcuityRight}, #{entity.eyePosition}, #{entity.eyeMovement}, #{entity.eyelid}, #{entity.conjunctivaOfEyelids}, #{entity.conjunctivaOfEyeball}, #{entity.intraocularPressureExam}, #{entity.slitLampExam}, #{entity.fundusPhotography}, #{entity.colorVisionExam}, #{entity.lacrimalApparatus})
        </foreach>
    </insert>

    <insert id="insertBatchByMaps" keyProperty="id" useGeneratedKeys="true">
        insert into td_ophthalmological_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.visualAcuityLeft}, #{entity.visualAcuityRight}, #{entity.correctedVisualAcuityLeft}, #{entity.correctedVisualAcuityRight}, #{entity.eyePosition}, #{entity.eyeMovement}, #{entity.eyelid}, #{entity.conjunctivaOfEyelids}, #{entity.conjunctivaOfEyeball}, #{entity.intraocularPressureExam}, #{entity.slitLampExam}, #{entity.fundusPhotography}, #{entity.colorVisionExam}, #{entity.lacrimalApparatus})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_ophthalmological_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, visual_acuity_left, visual_acuity_right, corrected_visual_acuity_left, corrected_visual_acuity_right, eye_position, eye_movement, eyelid, conjunctiva_of_eyelids, conjunctiva_of_eyeball, intraocular_pressure_exam, slit_lamp_exam, fundus_photography, color_vision_exam, lacrimal_apparatus)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.studyId}, #{entity.examNo}, #{entity.testNo}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.createTime}, #{entity.updateTime}, #{entity.visualAcuityLeft}, #{entity.visualAcuityRight}, #{entity.correctedVisualAcuityLeft}, #{entity.correctedVisualAcuityRight}, #{entity.eyePosition}, #{entity.eyeMovement}, #{entity.eyelid}, #{entity.conjunctivaOfEyelids}, #{entity.conjunctivaOfEyeball}, #{entity.intraocularPressureExam}, #{entity.slitLampExam}, #{entity.fundusPhotography}, #{entity.colorVisionExam}, #{entity.lacrimalApparatus})
        </foreach>
        on duplicate key update
        study_id = values(study_id),
        exam_no = values(exam_no),
        test_no = values(test_no),
        abnormal_indicator_high = values(abnormal_indicator_high),
        abnormal_indicator_low = values(abnormal_indicator_low),
        create_time = values(create_time),
        update_time = values(update_time),
        visual_acuity_left = values(visual_acuity_left),
        visual_acuity_right = values(visual_acuity_right),
        corrected_visual_acuity_left = values(corrected_visual_acuity_left),
        corrected_visual_acuity_right = values(corrected_visual_acuity_right),
        eye_position = values(eye_position),
        eye_movement = values(eye_movement),
        eyelid = values(eyelid),
        conjunctiva_of_eyelids = values(conjunctiva_of_eyelids),
        conjunctiva_of_eyeball = values(conjunctiva_of_eyeball),
        intraocular_pressure_exam = values(intraocular_pressure_exam),
        slit_lamp_exam = values(slit_lamp_exam),
        fundus_photography = values(fundus_photography),
        color_vision_exam = values(color_vision_exam),
        lacrimal_apparatus = values(lacrimal_apparatus)
    </insert>

    <!--通过主键修改数据-->
