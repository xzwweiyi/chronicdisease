                and conjunctiva_of_eyelids = #{conjunctivaOfEyelids}
            </if>
            <if test="conjunctivaOfEyeball != null and conjunctivaOfEyeball != ''">
                and conjunctiva_of_eyeball = #{conjunctivaOfEyeball}
            </if>
            <if test="intraocularPressureExam != null and intraocularPressureExam != ''">
                and intraocular_pressure_exam = #{intraocularPressureExam}
            </if>
            <if test="slitLampExam != null and slitLampExam != ''">
