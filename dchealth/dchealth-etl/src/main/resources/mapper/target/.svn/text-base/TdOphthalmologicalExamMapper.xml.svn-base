            </if>
            <if test="fundusPhotography != null and fundusPhotography != ''">
                and fundus_photography = #{fundusPhotography}
            </if>
            <if test="colorVisionExam != null and colorVisionExam != ''">
                and color_vision_exam = #{colorVisionExam}
            </if>
            <if test="lacrimalApparatus != null and lacrimalApparatus != ''">
                and lacrimal_apparatus = #{lacrimalApparatus}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
