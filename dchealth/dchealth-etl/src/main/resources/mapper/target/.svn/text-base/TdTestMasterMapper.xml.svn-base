<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.target.TdTestMasterMapper">

    <resultMap type="com.dchealth.etl.domain.target.TdTestMaster" id="TdTestMasterMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="idCardNo" column="id_card_no" jdbcType="VARCHAR"/>
        <result property="testNo" column="test_no" jdbcType="VARCHAR"/>
        <result property="patientId" column="patient_id" jdbcType="VARCHAR"/>
        <result property="testDateTime" column="test_date_time" jdbcType="TIMESTAMP"/>
        <result property="testDate" column="test_date" jdbcType="TIMESTAMP"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="orderingProvider" column="ordering_provider" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="TdTestMasterMap">
        select
          id, id_card_no, test_no, patient_id, test_date_time,test_date, create_time, update_time
        from td_test_master
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdTestMasterMap">
        select
          id, id_card_no, test_no, patient_id, test_date_time, create_time, update_time
        from td_test_master
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and patient_id = #{patientId}
            </if>
            <if test="testDateTime != null">
                and test_date_time = #{testDateTime}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from td_test_master
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="idCardNo != null and idCardNo != ''">
                and id_card_no = #{idCardNo}
            </if>
            <if test="testNo != null and testNo != ''">
                and test_no = #{testNo}
            </if>
            <if test="patientId != null and patientId != ''">
                and patient_id = #{patientId}
            </if>
            <if test="testDateTime != null">
                and test_date_time = #{testDateTime}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_test_master(id_card_no, test_no, patient_id, test_date_time, create_time, update_time)
        values (#{idCardNo}, #{testNo}, #{patientId}, #{testDateTime}, #{createTime}, #{updateTime})
    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_test_master(id_card_no, test_no, patient_id, test_date_time,test_date, create_time, update_time,ordering_provider)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.idCardNo}, #{entity.testNo}, #{entity.patientId}, #{entity.testDateTime},#{entity.testDate}, #{entity.createTime}, #{entity.updateTime}, #{entity.orderingProvider})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_test_master(id_card_no, test_no, patient_id, test_date_time, create_time, update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.idCardNo}, #{entity.testNo}, #{entity.patientId}, #{entity.testDateTime}, #{entity.createTime}, #{entity.updateTime})
        </foreach>
        on duplicate key update
        id_card_no = values(id_card_no),
        test_no = values(test_no),
        patient_id = values(patient_id),
        test_date_time = values(test_date_time),
        create_time = values(create_time),
        update_time = values(update_time)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update td_test_master
        <set>
            <if test="idCardNo != null and idCardNo != ''">
                id_card_no = #{idCardNo},
            </if>
            <if test="testNo != null and testNo != ''">
                test_no = #{testNo},
            </if>
            <if test="patientId != null and patientId != ''">
                patient_id = #{patientId},
            </if>
            <if test="testDateTime != null">
                test_date_time = #{testDateTime},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from td_test_master where id = #{id}
    </delete>

</mapper>

