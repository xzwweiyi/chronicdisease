    <!--新增所有列-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into td_tumor_screening_items(study_id, patient_id, exam_no, test_no, create_time, update_time, result_time, abnormal_indicator_high, abnormal_indicator_low, alpha_fetoprotein, carcinoembryonic_antigen, carbohydrate_antigen199, carbohydrate_antigen125, carbohydrate_antigen242, carbohydrate_antigen153, neuron_specific_enolase, carbohydrate_antigen724, cytokeratin19_fragment, carbohydrate_antigen50, free_psm_antigen, psm_antigen, ft, squ_cell_carcinoma_antigen, vegf, hcg, human_pididymis_rotein, aberrant_glycosylation_protein)
