    </insert>

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_tumor_screening_items(study_id, patient_id, exam_no, test_no, create_time, update_time, result_time, abnormal_indicator_high, abnormal_indicator_low, alpha_fetoprotein, carcinoembryonic_antigen, carbohydrate_antigen199, carbohydrate_antigen125, carbohydrate_antigen242, carbohydrate_antigen153, neuron_specific_enolase, carbohydrate_antigen724, cytokeratin19_fragment, carbohydrate_antigen50, free_psm_antigen, psm_antigen, ft, squ_cell_carcinoma_antigen, vegf, hcg, human_pididymis_rotein, aberrant_glycosylation_protein,ferritin)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyId}, #{entity.patientId}, #{entity.examNo}, #{entity.testNo}, #{entity.createTime}, #{entity.updateTime}, #{entity.resultTime}, #{entity.abnormalIndicatorHigh}, #{entity.abnormalIndicatorLow}, #{entity.alphaFetoprotein}, #{entity.carcinoembryonicAntigen}, #{entity.carbohydrateAntigen199}, #{entity.carbohydrateAntigen125}, #{entity.carbohydrateAntigen242}, #{entity.carbohydrateAntigen153}, #{entity.neuronSpecificEnolase}, #{entity.carbohydrateAntigen724}, #{entity.cytokeratin19Fragment}, #{entity.carbohydrateAntigen50}, #{entity.freePsmAntigen}, #{entity.psmAntigen}, #{entity.ft}, #{entity.squCellCarcinomaAntigen}, #{entity.vegf}, #{entity.hcg}, #{entity.humanPididymisRotein}, #{entity.aberrantGlycosylationProtein}, #{entity.ferritin})
