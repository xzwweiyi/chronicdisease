    <!--查询单个-->
    <select id="queryById" resultMap="TdInternalMedicineExamMap">
        select
          id, study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, chest_contour, chest_palpation, chest_percussion, cardiac_border, pulmonary_auscultation, heart_sound, cardiac_rhythm, cardiac_murmur, hepatic_palpation, splenic_palpation, abdominal_contour, abdominal_tenderness, abdominal_percussion
        from td_internal_medicine_exam
        where id = #{id}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="TdInternalMedicineExamMap">
