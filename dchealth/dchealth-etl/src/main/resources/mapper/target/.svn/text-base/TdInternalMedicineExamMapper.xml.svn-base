    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into td_internal_medicine_exam(study_id, exam_no, test_no, abnormal_indicator_high, abnormal_indicator_low, create_time, update_time, chest_contour, chest_palpation, chest_percussion, cardiac_border, pulmonary_auscultation, heart_sound, cardiac_rhythm, cardiac_murmur, hepatic_palpation, splenic_palpation, abdominal_contour, abdominal_tenderness, abdominal_percussion)
        values
        <foreach collection="entities" item="entity" separator=",">
