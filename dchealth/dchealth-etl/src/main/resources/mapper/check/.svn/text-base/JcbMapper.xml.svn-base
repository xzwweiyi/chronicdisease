<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dchealth.etl.dao.check.JcbMapper">

    <resultMap type="com.dchealth.etl.domain.check.Jcb" id="JcbResult">
        <result property="studyid" column="StudyID" jdbcType="VARCHAR"/>
        <result property="studydate" column="StudyDate" jdbcType="VARCHAR"/>
        <result property="xxdm" column="XXDM" jdbcType="VARCHAR"/>
        <result property="cvalue" column="CValue" jdbcType="VARCHAR"/>
        <result property="nvalue" column="NValue" jdbcType="VARCHAR"/>
        <result property="doctor" column="Doctor" jdbcType="VARCHAR"/>
        <result property="shdoctor" column="SHDoctor" jdbcType="VARCHAR"/>
        <result property="deptcode" column="DeptCode" jdbcType="VARCHAR"/>
        <result property="id" column="ID" jdbcType="INTEGER"/>
        <result property="dvalue" column="DValue" jdbcType="VARCHAR"/>
        <result property="mvalue" column="MValue" jdbcType="VARCHAR"/>
        <result property="doctordm" column="DoctorDM" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="JcbResult">
        select
          StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue, DoctorDM
        from jcb
        where  StudyID= #{studyId}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="JcbResult">
        select
          StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue, DoctorDM
        from jcb
        <where>
            <if test="studyid != null and studyid != ''">
                and StudyID = #{studyid}
            </if>
            <if test="studydate != null and studydate != ''">
                and StudyDate = #{studydate}
            </if>
            <if test="xxdm != null and xxdm != ''">
                and XXDM = #{xxdm}
            </if>
            <if test="cvalue != null and cvalue != ''">
                and CValue = #{cvalue}
            </if>
            <if test="nvalue != null and nvalue != ''">
                and NValue = #{nvalue}
            </if>
            <if test="doctor != null and doctor != ''">
                and Doctor = #{doctor}
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                and SHDoctor = #{shdoctor}
            </if>
            <if test="deptcode != null and deptcode != ''">
                and DeptCode = #{deptcode}
            </if>
            <if test="id != null">
                and ID = #{id}
            </if>
            <if test="dvalue != null and dvalue != ''">
                and DValue = #{dvalue}
            </if>
            <if test="mvalue != null and mvalue != ''">
                and MValue = #{mvalue}
            </if>
            <if test="doctordm != null and doctordm != ''">
                and DoctorDM = #{doctordm}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from jcb
        <where>
            <if test="studyid != null and studyid != ''">
                and StudyID = #{studyid}
            </if>
            <if test="studydate != null and studydate != ''">
                and StudyDate = #{studydate}
            </if>
            <if test="xxdm != null and xxdm != ''">
                and XXDM = #{xxdm}
            </if>
            <if test="cvalue != null and cvalue != ''">
                and CValue = #{cvalue}
            </if>
            <if test="nvalue != null and nvalue != ''">
                and NValue = #{nvalue}
            </if>
            <if test="doctor != null and doctor != ''">
                and Doctor = #{doctor}
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                and SHDoctor = #{shdoctor}
            </if>
            <if test="deptcode != null and deptcode != ''">
                and DeptCode = #{deptcode}
            </if>
            <if test="id != null">
                and ID = #{id}
            </if>
            <if test="dvalue != null and dvalue != ''">
                and DValue = #{dvalue}
            </if>
            <if test="mvalue != null and mvalue != ''">
                and MValue = #{mvalue}
            </if>
            <if test="doctordm != null and doctordm != ''">
                and DoctorDM = #{doctordm}
            </if>
        </where>
    </select>
    <select id="querySyncInfoCount" resultType="java.lang.Long">
        select count(1)
        from jcb
        <where>
            <if test="studyid != null and studyid != ''">
                and StudyID = #{studyid}
            </if>
            <if test="params.recordingDate != null and params.recordingDate != ''">
                and date_format(StudyDate,'%Y-%m-%d') = #{params.recordingDate}
            </if>
        </where>

    </select>
    <select id="querySyncInfoByPage" resultMap="JcbResult">
        select
          StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue
        from jcb
        <where>
            <if test="jcb.studyid != null and jcb.studyid != ''">
                and StudyID = #{jcb.studyid}
            </if>
            <if test="jcb.params.recordingDate != null and jcb.params.recordingDate != ''">
                and date_format(StudyDate,'%Y-%m-%d') = #{jcb.params.recordingDate}
            </if>
        </where>
        order by StudyDate
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="" useGeneratedKeys="true">
        insert into jcb(StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue, DoctorDM)
        values (#{studyid}, #{studydate}, #{xxdm}, #{cvalue}, #{nvalue}, #{doctor}, #{shdoctor}, #{deptcode}, #{id}, #{dvalue}, #{mvalue}, #{doctordm})
    </insert>

    <insert id="insertBatch" keyProperty="" useGeneratedKeys="true">
        insert into jcb(StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue, DoctorDM)
        values
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.studyid}, #{entity.studydate}, #{entity.xxdm}, #{entity.cvalue}, #{entity.nvalue}, #{entity.doctor}, #{entity.shdoctor}, #{entity.deptcode}, #{entity.id}, #{entity.dvalue}, #{entity.mvalue}, #{entity.doctordm})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="" useGeneratedKeys="true">
        insert into jcb(StudyID, StudyDate, XXDM, CValue, NValue, Doctor, SHDoctor, DeptCode, ID, DValue, MValue, DoctorDM)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.studyid}, #{entity.studydate}, #{entity.xxdm}, #{entity.cvalue}, #{entity.nvalue}, #{entity.doctor}, #{entity.shdoctor}, #{entity.deptcode}, #{entity.id}, #{entity.dvalue}, #{entity.mvalue}, #{entity.doctordm})
        </foreach>
        on duplicate key update
        StudyID = values(StudyID),
        StudyDate = values(StudyDate),
        XXDM = values(XXDM),
        CValue = values(CValue),
        NValue = values(NValue),
        Doctor = values(Doctor),
        SHDoctor = values(SHDoctor),
        DeptCode = values(DeptCode),
        ID = values(ID),
        DValue = values(DValue),
        MValue = values(MValue),
        DoctorDM = values(DoctorDM)
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update jcb
        <set>
            <if test="studyid != null and studyid != ''">
                StudyID = #{studyid},
            </if>
            <if test="studydate != null and studydate != ''">
                StudyDate = #{studydate},
            </if>
            <if test="xxdm != null and xxdm != ''">
                XXDM = #{xxdm},
            </if>
            <if test="cvalue != null and cvalue != ''">
                CValue = #{cvalue},
            </if>
            <if test="nvalue != null and nvalue != ''">
                NValue = #{nvalue},
            </if>
            <if test="doctor != null and doctor != ''">
                Doctor = #{doctor},
            </if>
            <if test="shdoctor != null and shdoctor != ''">
                SHDoctor = #{shdoctor},
            </if>
            <if test="deptcode != null and deptcode != ''">
                DeptCode = #{deptcode},
            </if>
            <if test="id != null">
                ID = #{id},
            </if>
            <if test="dvalue != null and dvalue != ''">
                DValue = #{dvalue},
            </if>
            <if test="mvalue != null and mvalue != ''">
                MValue = #{mvalue},
            </if>
            <if test="doctordm != null and doctordm != ''">
                DoctorDM = #{doctordm},
            </if>
        </set>
        where  StudyID = #{studyid}
    </update>


</mapper>

