package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 肝功能项目表(TdLiverFunctionItems)实体类
 *
 * @author makejava
 * @since 2023-04-10 17:05:03
 */
public class TdLiverFunctionItems implements Serializable {
    private static final long serialVersionUID = -68570881662766670L;
    /**
     * 自增住建
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 结果正常标志 高，字段以，分割保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以，分割保存
     */
    private String abnormalIndicatorLow;
    /**
     * 总胆汁酸
     */
    private String totalBileAcid;
    /**
     * 白球比
     */
    private String whiteBallRatio;
    /**
     * AST/ALT比值
     */
    private String astAltRatio;
    /**
     * 间接胆红素
     */
    private String indirectBilirubin;
    /**
     * 丙氨酸氨基转移酶
     */
    private String alanineAminotransferase;
    /**
     * 天冬氨酸氨基转移酶
     */
    private String aspartateAminotransferase;
    /**
     * 总蛋白
     */
    private String totalProtein;
    /**
     * 白蛋白
     */
    private String albumin;
    /**
     * 球蛋白
     */
    private String globulin;
    /**
     * 总胆红素
     */
    private String totalBilirubin;
    /**
     * 直接胆红素
     */
    private String directBilirubin;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public String getTotalBileAcid() {
        return totalBileAcid;
    }

    public void setTotalBileAcid(String totalBileAcid) {
        this.totalBileAcid = totalBileAcid;
    }

    public String getWhiteBallRatio() {
        return whiteBallRatio;
    }

    public void setWhiteBallRatio(String whiteBallRatio) {
        this.whiteBallRatio = whiteBallRatio;
    }

    public String getAstAltRatio() {
        return astAltRatio;
    }

    public void setAstAltRatio(String astAltRatio) {
        this.astAltRatio = astAltRatio;
    }

    public String getIndirectBilirubin() {
        return indirectBilirubin;
    }

    public void setIndirectBilirubin(String indirectBilirubin) {
        this.indirectBilirubin = indirectBilirubin;
    }

    public String getAlanineAminotransferase() {
        return alanineAminotransferase;
    }

    public void setAlanineAminotransferase(String alanineAminotransferase) {
        this.alanineAminotransferase = alanineAminotransferase;
    }

    public String getAspartateAminotransferase() {
        return aspartateAminotransferase;
    }

    public void setAspartateAminotransferase(String aspartateAminotransferase) {
        this.aspartateAminotransferase = aspartateAminotransferase;
    }

    public String getTotalProtein() {
        return totalProtein;
    }

    public void setTotalProtein(String totalProtein) {
        this.totalProtein = totalProtein;
    }

    public String getAlbumin() {
        return albumin;
    }

    public void setAlbumin(String albumin) {
        this.albumin = albumin;
    }

    public String getGlobulin() {
        return globulin;
    }

    public void setGlobulin(String globulin) {
        this.globulin = globulin;
    }

    public String getTotalBilirubin() {
        return totalBilirubin;
    }

    public void setTotalBilirubin(String totalBilirubin) {
        this.totalBilirubin = totalBilirubin;
    }

    public String getDirectBilirubin() {
        return directBilirubin;
    }

    public void setDirectBilirubin(String directBilirubin) {
        this.directBilirubin = directBilirubin;
    }

}

