package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 内科检查表(TdInternalMedicineExam)实体类
 *
 * @author makejava
 * @since 2023-04-07 14:08:44
 */
public class TdInternalMedicineExam implements Serializable {
    private static final long serialVersionUID = 375101124834499762L;
    
    private String id;
    /**
     * 体检Id
     */
    private String studyId;
    /**
     * 检查序号
     */
    private String examNo;
    /**
     * 检验序号
     */
    private String testNo;
    /**
     * 结果正常标志 高，字段以逗号分隔保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以逗号分隔保存
     */
    private String abnormalIndicatorLow;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 更新时间
     */
    private Date updateTime;
    /**
     * 胸部外形
     */
    private String chestContour;
    /**
     * 胸部触诊
     */
    private String chestPalpation;
    /**
     * 胸部叩诊
     */
    private String chestPercussion;
    /**
     * 心界
     */
    private String cardiacBorder;
    /**
     * 肺部听诊
     */
    private String pulmonaryAuscultation;
    /**
     * 心音
     */
    private String heartSound;
    /**
     * 心律
     */
    private String cardiacRhythm;
    /**
     * 心脏杂音
     */
    private String cardiacMurmur;
    /**
     * 肝脏触诊
     */
    private String hepaticPalpation;
    /**
     * 脾脏触诊
     */
    private String splenicPalpation;
    /**
     * 腹部外形
     */
    private String abdominalContour;
    /**
     * 腹部压痛
     */
    private String abdominalTenderness;
    /**
     * 腹部叩诊
     */
    private String abdominalPercussion;


    public String getId() {
        return id;
    }

    public void setId(String id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public String getChestContour() {
        return chestContour;
    }

    public void setChestContour(String chestContour) {
        this.chestContour = chestContour;
    }

    public String getChestPalpation() {
        return chestPalpation;
    }

    public void setChestPalpation(String chestPalpation) {
        this.chestPalpation = chestPalpation;
    }

    public String getChestPercussion() {
        return chestPercussion;
    }

    public void setChestPercussion(String chestPercussion) {
        this.chestPercussion = chestPercussion;
    }

    public String getCardiacBorder() {
        return cardiacBorder;
    }

    public void setCardiacBorder(String cardiacBorder) {
        this.cardiacBorder = cardiacBorder;
    }

    public String getPulmonaryAuscultation() {
        return pulmonaryAuscultation;
    }

    public void setPulmonaryAuscultation(String pulmonaryAuscultation) {
        this.pulmonaryAuscultation = pulmonaryAuscultation;
    }

    public String getHeartSound() {
        return heartSound;
    }

    public void setHeartSound(String heartSound) {
        this.heartSound = heartSound;
    }

    public String getCardiacRhythm() {
        return cardiacRhythm;
    }

    public void setCardiacRhythm(String cardiacRhythm) {
        this.cardiacRhythm = cardiacRhythm;
    }

    public String getCardiacMurmur() {
        return cardiacMurmur;
    }

    public void setCardiacMurmur(String cardiacMurmur) {
        this.cardiacMurmur = cardiacMurmur;
    }

    public String getHepaticPalpation() {
        return hepaticPalpation;
    }

    public void setHepaticPalpation(String hepaticPalpation) {
        this.hepaticPalpation = hepaticPalpation;
    }

    public String getSplenicPalpation() {
        return splenicPalpation;
    }

    public void setSplenicPalpation(String splenicPalpation) {
        this.splenicPalpation = splenicPalpation;
    }

    public String getAbdominalContour() {
        return abdominalContour;
    }

    public void setAbdominalContour(String abdominalContour) {
        this.abdominalContour = abdominalContour;
    }

    public String getAbdominalTenderness() {
        return abdominalTenderness;
    }

    public void setAbdominalTenderness(String abdominalTenderness) {
        this.abdominalTenderness = abdominalTenderness;
    }

    public String getAbdominalPercussion() {
        return abdominalPercussion;
    }

    public void setAbdominalPercussion(String abdominalPercussion) {
        this.abdominalPercussion = abdominalPercussion;
    }

}

