package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 凝血项目表(TdCoagulationItems)实体类
 *
 * @author makejava
 * @since 2023-04-10 17:11:42
 */
public class TdCoagulationItems implements Serializable {
    private static final long serialVersionUID = -32961569854459848L;
    /**
     * 自增住建
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 结果正常标志 高，字段以，分割保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以，分割保存
     */
    private String abnormalIndicatorLow;
    /**
     * 凝血酶原时间
     */
    private String prothrombinTime;
    /**
     * 活化部分凝血活酶时间
     */
    private String aptt;
    /**
     * 凝血酶时间
     */
    private String thrombinTime;
    /**
     * 纤维蛋白原含量
     */
    private String fibrinogen;
    /**
     * 纤维蛋白(原)降解产物
     */
    private String fdp;
    /**
     * D-二聚体定量
     */
    private String dDimerQuantitativeTest;
    /**
     * 国际标准化比值
     */
    private String internationalNormRatio;
    /**
     * 凝血酶原活动度
     */
    private String prothrombinActivity;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public String getProthrombinTime() {
        return prothrombinTime;
    }

    public void setProthrombinTime(String prothrombinTime) {
        this.prothrombinTime = prothrombinTime;
    }

    public String getAptt() {
        return aptt;
    }

    public void setAptt(String aptt) {
        this.aptt = aptt;
    }

    public String getThrombinTime() {
        return thrombinTime;
    }

    public void setThrombinTime(String thrombinTime) {
        this.thrombinTime = thrombinTime;
    }

    public String getFibrinogen() {
        return fibrinogen;
    }

    public void setFibrinogen(String fibrinogen) {
        this.fibrinogen = fibrinogen;
    }

    public String getFdp() {
        return fdp;
    }

    public void setFdp(String fdp) {
        this.fdp = fdp;
    }

    public String getDDimerQuantitativeTest() {
        return dDimerQuantitativeTest;
    }

    public void setDDimerQuantitativeTest(String dDimerQuantitativeTest) {
        this.dDimerQuantitativeTest = dDimerQuantitativeTest;
    }

    public String getInternationalNormRatio() {
        return internationalNormRatio;
    }

    public void setInternationalNormRatio(String internationalNormRatio) {
        this.internationalNormRatio = internationalNormRatio;
    }

    public String getProthrombinActivity() {
        return prothrombinActivity;
    }

    public void setProthrombinActivity(String prothrombinActivity) {
        this.prothrombinActivity = prothrombinActivity;
    }

}

