package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 唐都-耳鼻喉相关表(TdOtolaryngology)实体类
 *
 * @author makejava
 * @since 2023-04-07 14:32:35
 */
public class TdOtolaryngology implements Serializable {
    private static final long serialVersionUID = 273889101545081902L;
    /**
     * 自增主键
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 听力 
     */
    private String hearing;
    /**
     * 耳廓
     */
    private String auricle;
    /**
     * 外耳道
     */
    private String externalAuditoryMeatus;
    /**
     * 鼓膜
     */
    private String tympanicMembrane;
    /**
     * 外鼻
     */
    private String externalNose;
    /**
     * 鼻腔
     */
    private String nasalCavity;
    /**
     * 口咽
     */
    private String oralPharynx;
    /**
     * 喉咽
     */
    private String laryngopharynx;
    /**
     * 扁桃体
     */
    private String tonsil;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getHearing() {
        return hearing;
    }

    public void setHearing(String hearing) {
        this.hearing = hearing;
    }

    public String getAuricle() {
        return auricle;
    }

    public void setAuricle(String auricle) {
        this.auricle = auricle;
    }

    public String getExternalAuditoryMeatus() {
        return externalAuditoryMeatus;
    }

    public void setExternalAuditoryMeatus(String externalAuditoryMeatus) {
        this.externalAuditoryMeatus = externalAuditoryMeatus;
    }

    public String getTympanicMembrane() {
        return tympanicMembrane;
    }

    public void setTympanicMembrane(String tympanicMembrane) {
        this.tympanicMembrane = tympanicMembrane;
    }

    public String getExternalNose() {
        return externalNose;
    }

    public void setExternalNose(String externalNose) {
        this.externalNose = externalNose;
    }

    public String getNasalCavity() {
        return nasalCavity;
    }

    public void setNasalCavity(String nasalCavity) {
        this.nasalCavity = nasalCavity;
    }

    public String getOralPharynx() {
        return oralPharynx;
    }

    public void setOralPharynx(String oralPharynx) {
        this.oralPharynx = oralPharynx;
    }

    public String getLaryngopharynx() {
        return laryngopharynx;
    }

    public void setLaryngopharynx(String laryngopharynx) {
        this.laryngopharynx = laryngopharynx;
    }

    public String getTonsil() {
        return tonsil;
    }

    public void setTonsil(String tonsil) {
        this.tonsil = tonsil;
    }

}

