package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 唐都-体检检验表(TdCheckTest)实体类
 *
 * @author makejava
 * @since 2023-04-11 14:24:24
 */
public class TdCheckTest implements Serializable {
    private static final long serialVersionUID = -66637262055346942L;
    /**
     * 自增主键
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 结果正常标志 高，字段以，分割保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以，分割保存
     */
    private String abnormalIndicatorLow;
    /**
     * 淀粉酶测定
     */
    private String amylase;
    /**
     * 空腹血糖
     */
    private String fpg;
    /**
     * 餐后2小时血糖
     */
    private String pbg;
    /**
     * 弓形虫
     */
    private String tox;
    /**
     * 巨细胞病毒
     */
    private String cytomegalovirus;
    /**
     * 单纯疱疹病毒
     */
    private String herpesSimplexVirus;
    /**
     * 风疹病毒
     */
    private String rubellaVirus;
    /**
     * 抗“O”检测 
     */
    private String aso;
    /**
     * 类风湿因子
     */
    private String rheumatoidFactor;
    /**
     * C-反应蛋白
     */
    private String cReactiveProtein;
    /**
     * 新冠病毒核酸
     */
    private String covid19NucleicAcid;
    /**
     * 幽门螺旋杆菌尿素酶抗体测定
     */
    private String helicobacterPylori;
    /**
     * 人乳头瘤病毒（HPV）DNA基因分型检测
     */
    private String humanPapillomavirusHpv;
    /**
     * (他汀类)化学药物用药指导基因检测
     */
    private String statinsMgTest;
    /**
     * (硝酸甘油、酒精)化学药物用药指导基因检测
     */
    private String nitroglycerinMgTest;
    /**
     * (叶酸、甲氨喋呤)化学药物用药指导基因检测
     */
    private String folicMgTest;
    /**
     * 载脂蛋白E基因多态性检测
     */
    private String apoeTest;
    /**
     * 钙
     */
    private String calcium;
    /**
     * 镁
     */
    private String magnesium;
    /**
     * 铅
     */
    private String pb;
    /**
     * 铜
     */
    private String copper;
    /**
     * 锌
     */
    private String zinc;
    /**
     * 铁
     */
    private String iron;
    /**
     * 正位脊柱 L1-L4 骨密度
     */
    private String boneDensityAnterior;
    /**
     * 股骨骨密度
     */
    private String boneDensityOfFemur;
    /**
     * 前臂 桡骨33% 骨密度
     */
    private String boneDensityForearmRadius;

    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public String getAmylase() {
        return amylase;
    }

    public void setAmylase(String amylase) {
        this.amylase = amylase;
    }

    public String getFpg() {
        return fpg;
    }

    public void setFpg(String fpg) {
        this.fpg = fpg;
    }

    public String getPbg() {
        return pbg;
    }

    public void setPbg(String pbg) {
        this.pbg = pbg;
    }

    public String getTox() {
        return tox;
    }

    public void setTox(String tox) {
        this.tox = tox;
    }

    public String getCytomegalovirus() {
        return cytomegalovirus;
    }

    public void setCytomegalovirus(String cytomegalovirus) {
        this.cytomegalovirus = cytomegalovirus;
    }

    public String getHerpesSimplexVirus() {
        return herpesSimplexVirus;
    }

    public void setHerpesSimplexVirus(String herpesSimplexVirus) {
        this.herpesSimplexVirus = herpesSimplexVirus;
    }

    public String getRubellaVirus() {
        return rubellaVirus;
    }

    public void setRubellaVirus(String rubellaVirus) {
        this.rubellaVirus = rubellaVirus;
    }

    public String getAso() {
        return aso;
    }

    public void setAso(String aso) {
        this.aso = aso;
    }

    public String getRheumatoidFactor() {
        return rheumatoidFactor;
    }

    public void setRheumatoidFactor(String rheumatoidFactor) {
        this.rheumatoidFactor = rheumatoidFactor;
    }

    public String getCReactiveProtein() {
        return cReactiveProtein;
    }

    public void setCReactiveProtein(String cReactiveProtein) {
        this.cReactiveProtein = cReactiveProtein;
    }

    public String getCovid19NucleicAcid() {
        return covid19NucleicAcid;
    }

    public void setCovid19NucleicAcid(String covid19NucleicAcid) {
        this.covid19NucleicAcid = covid19NucleicAcid;
    }

    public String getHelicobacterPylori() {
        return helicobacterPylori;
    }

    public void setHelicobacterPylori(String helicobacterPylori) {
        this.helicobacterPylori = helicobacterPylori;
    }

    public String getHumanPapillomavirusHpv() {
        return humanPapillomavirusHpv;
    }

    public void setHumanPapillomavirusHpv(String humanPapillomavirusHpv) {
        this.humanPapillomavirusHpv = humanPapillomavirusHpv;
    }

    public String getStatinsMgTest() {
        return statinsMgTest;
    }

    public void setStatinsMgTest(String statinsMgTest) {
        this.statinsMgTest = statinsMgTest;
    }

    public String getNitroglycerinMgTest() {
        return nitroglycerinMgTest;
    }

    public void setNitroglycerinMgTest(String nitroglycerinMgTest) {
        this.nitroglycerinMgTest = nitroglycerinMgTest;
    }

    public String getFolicMgTest() {
        return folicMgTest;
    }

    public void setFolicMgTest(String folicMgTest) {
        this.folicMgTest = folicMgTest;
    }

    public String getApoeTest() {
        return apoeTest;
    }

    public void setApoeTest(String apoeTest) {
        this.apoeTest = apoeTest;
    }

    public String getCalcium() {
        return calcium;
    }

    public void setCalcium(String calcium) {
        this.calcium = calcium;
    }

    public String getMagnesium() {
        return magnesium;
    }

    public void setMagnesium(String magnesium) {
        this.magnesium = magnesium;
    }

    public String getPb() {
        return pb;
    }

    public void setPb(String pb) {
        this.pb = pb;
    }

    public String getCopper() {
        return copper;
    }

    public void setCopper(String copper) {
        this.copper = copper;
    }

    public String getZinc() {
        return zinc;
    }

    public void setZinc(String zinc) {
        this.zinc = zinc;
    }

    public String getIron() {
        return iron;
    }

    public void setIron(String iron) {
        this.iron = iron;
    }

    public String getBoneDensityAnterior() {
        return boneDensityAnterior;
    }

    public void setBoneDensityAnterior(String boneDensityAnterior) {
        this.boneDensityAnterior = boneDensityAnterior;
    }

    public String getBoneDensityOfFemur() {
        return boneDensityOfFemur;
    }

    public void setBoneDensityOfFemur(String boneDensityOfFemur) {
        this.boneDensityOfFemur = boneDensityOfFemur;
    }

    public String getBoneDensityForearmRadius() {
        return boneDensityForearmRadius;
    }

    public void setBoneDensityForearmRadius(String boneDensityForearmRadius) {
        this.boneDensityForearmRadius = boneDensityForearmRadius;
