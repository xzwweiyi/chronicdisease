package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 唐都-口腔科相关表(TdOral)实体类
 *
 * @author makejava
 * @since 2023-04-07 14:56:03
 */
public class TdOral implements Serializable {
    private static final long serialVersionUID = 910866247130937758L;
    /**
     * 自增主键
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 牙体组织疾病 
     */
    private String dentalCaries;
    /**
     * 牙周组织疾病
     */
    private String periodontalDisease;
    /**
     * 口腔黏膜疾病
     */
    private String oralMucosalDisease;
    /**
     * 口腔颌面外科疾病
     */
    private String oralMaxillofacialSurgery;
    /**
     * 口腔修复科
     */
    private String oralRestoration;
    /**
     * 正畸科
     */
    private String orthodontics;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getDentalCaries() {
        return dentalCaries;
    }

    public void setDentalCaries(String dentalCaries) {
        this.dentalCaries = dentalCaries;
    }

    public String getPeriodontalDisease() {
        return periodontalDisease;
    }

    public void setPeriodontalDisease(String periodontalDisease) {
        this.periodontalDisease = periodontalDisease;
    }

    public String getOralMucosalDisease() {
        return oralMucosalDisease;
    }

    public void setOralMucosalDisease(String oralMucosalDisease) {
        this.oralMucosalDisease = oralMucosalDisease;
    }

    public String getOralMaxillofacialSurgery() {
        return oralMaxillofacialSurgery;
    }

    public void setOralMaxillofacialSurgery(String oralMaxillofacialSurgery) {
        this.oralMaxillofacialSurgery = oralMaxillofacialSurgery;
    }

    public String getOralRestoration() {
        return oralRestoration;
    }

    public void setOralRestoration(String oralRestoration) {
        this.oralRestoration = oralRestoration;
    }

    public String getOrthodontics() {
        return orthodontics;
    }

    public void setOrthodontics(String orthodontics) {
        this.orthodontics = orthodontics;
    }

}

