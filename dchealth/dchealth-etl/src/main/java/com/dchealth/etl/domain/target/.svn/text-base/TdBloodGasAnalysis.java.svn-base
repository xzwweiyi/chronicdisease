package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 血气分析(TdBloodGasAnalysis)实体类
 *
 * @author makejava
 * @since 2023-04-25 18:01:13
 */
public class TdBloodGasAnalysis implements Serializable {
    private static final long serialVersionUID = -65393538107128176L;
    /**
     * 自增住建
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 结果正常标志 高，字段以，分割保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以，分割保存
     */
    private String abnormalIndicatorLow;
    /**
     * ph值
     */
    private String bloodGasPh;
    /**
     * 二氧化碳分压
     */
    private String pco2;
    /**
     * 氧分压
     */
    private String po2;
    /**
     * 红细胞压积
     */
    private String hct;
    /**
     * 血红蛋白
     */
    private String hb;
    /**
     * 剩余碱
     */
    private String be;
    /**
     * 标准碳酸根
     */
    private String chco3;
    /**
     * 实际碳酸根
     */
    private String actco3;
    /**
     * 总二氧化碳
     */
    private String tco2;
    /**
     * 氧饱和度50%时氧分压
     */
    private String p50act;
    /**
     * 血氧饱和度
     */
    private String so2;
    /**
     * 氧含量
     */
    private String cto2;
    /**
     * 氧容量
     */
    private String bo2;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public String getBloodGasPh() {
        return bloodGasPh;
    }

    public void setBloodGasPh(String bloodGasPh) {
        this.bloodGasPh = bloodGasPh;
    }

    public String getPco2() {
        return pco2;
    }

    public void setPco2(String pco2) {
        this.pco2 = pco2;
    }

    public String getPo2() {
        return po2;
    }

    public void setPo2(String po2) {
        this.po2 = po2;
    }

    public String getHct() {
        return hct;
    }

    public void setHct(String hct) {
        this.hct = hct;
    }

    public String getHb() {
        return hb;
    }

    public void setHb(String hb) {
        this.hb = hb;
    }

    public String getBe() {
        return be;
    }

    public void setBe(String be) {
        this.be = be;
    }

    public String getChco3() {
        return chco3;
    }

    public void setChco3(String chco3) {
        this.chco3 = chco3;
    }

    public String getActco3() {
        return actco3;
    }

    public void setActco3(String actco3) {
        this.actco3 = actco3;
    }

    public String getTco2() {
        return tco2;
    }

    public void setTco2(String tco2) {
        this.tco2 = tco2;
    }

    public String getP50act() {
        return p50act;
    }

    public void setP50act(String p50act) {
        this.p50act = p50act;
    }

    public String getSo2() {
        return so2;
    }

    public void setSo2(String so2) {
        this.so2 = so2;
    }

    public String getCto2() {
        return cto2;
    }

    public void setCto2(String cto2) {
        this.cto2 = cto2;
    }

    public String getBo2() {
        return bo2;
    }

    public void setBo2(String bo2) {
        this.bo2 = bo2;
    }

}

