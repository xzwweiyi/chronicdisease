package com.dchealth.etl.domain.target;

import com.dchealth.etl.domain.BaseEntity;

import java.util.Date;
import java.io.Serializable;

/**
 * 激素项目表(TdHormoneItems)实体类
 *
 * @author makejava
 * @since 2023-04-03 09:39:03
 */
public class TdHormoneItems extends BaseEntity implements Serializable {
    private static final long serialVersionUID = -86151350841265157L;
    
    private Integer id;
    /**
     * 体检Id
     */
    private String studyId;
    /**
     * 检查序号
     */
    private String examNo;
    /**
     * 检验序号
     */
    private String testNo;
    /**
     * 结果正常标志 高，字段以逗号分隔保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以逗号分隔保存
     */
    private String abnormalIndicatorLow;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 更新时间
     */
    private Date updateTime;
    /**
     * 卵泡刺激素（FSH）
     */
    private String follicleStimulatingHormone;
    /**
     * 黄体生成素（LH）
     */
    private String luteinizingHormone;
    /**
     * 雌二醇（E2）
     */
    private String estradiol;
    /**
     * 孕酮（P）
     */
    private String progesterone;
    /**
     * 睾酮（T）
     */
    private String testosterone;
    /**
     * 催乳素（PRL）
     */
    private String prolactin;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public String getFollicleStimulatingHormone() {
        return follicleStimulatingHormone;
    }

    public void setFollicleStimulatingHormone(String follicleStimulatingHormone) {
        this.follicleStimulatingHormone = follicleStimulatingHormone;
    }

    public String getLuteinizingHormone() {
        return luteinizingHormone;
    }

    public void setLuteinizingHormone(String luteinizingHormone) {
        this.luteinizingHormone = luteinizingHormone;
    }

    public String getEstradiol() {
        return estradiol;
    }

    public void setEstradiol(String estradiol) {
        this.estradiol = estradiol;
    }

    public String getProgesterone() {
        return progesterone;
    }

    public void setProgesterone(String progesterone) {
        this.progesterone = progesterone;
    }

    public String getTestosterone() {
        return testosterone;
    }

    public void setTestosterone(String testosterone) {
        this.testosterone = testosterone;
    }

    public String getProlactin() {
        return prolactin;
    }

    public void setProlactin(String prolactin) {
        this.prolactin = prolactin;
    }

}

