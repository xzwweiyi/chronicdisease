package com.dchealth.etl.domain.check;

import com.dchealth.etl.domain.BaseEntity;

import java.io.Serializable;
import java.util.Date;

/**
 * 检查结果(ViewJcb)实体类
 *
 * @author makejava
 * @since 2023-06-06 11:34:37
 */
public class ViewJcb extends BaseEntity implements Serializable {
    private static final long serialVersionUID = 129912959616549252L;
    /**
     * 预约id
     */
    private String studyid;
    /**
     * 检查日期
     */
    private Date checkdate;
    /**
     * 结论日期
     */
    private Date resultdate;
    /**
     * 科室
     */
    private String deptname;
    /**
     * 细项代码
     */
    private String xxdm;
    /**
     * 细项名称
     */
    private String xxmc;
    /**
     * 检查结果
     */
    private String result;
    /**
     * 数字型值
     */
    private String nvalue;
    /**
     * 字符型值
     */
    private String cvalue;
    /**
     * 文本型值
     */
    private String mvalue;
    /**
     * 检查医生
     */
    private String doctor;
    /**
     * 部门编码
     */
    private String deptcode;
    /**
     * 医生代码
     */
    private String doctordm;


    public String getStudyid() {
        return studyid;
    }

    public void setStudyid(String studyid) {
        this.studyid = studyid;
    }

    public Date getCheckdate() {
        return checkdate;
    }

    public void setCheckdate(Date checkdate) {
        this.checkdate = checkdate;
    }

    public Date getResultdate() {
        return resultdate;
    }

    public void setResultdate(Date resultdate) {
        this.resultdate = resultdate;
    }

    public String getDeptname() {
        return deptname;
    }

    public void setDeptname(String deptname) {
        this.deptname = deptname;
    }

    public String getXxdm() {
        return xxdm;
    }

    public void setXxdm(String xxdm) {
        this.xxdm = xxdm;
    }

    public String getXxmc() {
        return xxmc;
    }

    public void setXxmc(String xxmc) {
        this.xxmc = xxmc;
    }

    public String getResult() {
        return result;
    }

    public void setResult(String result) {
        this.result = result;
    }

    public String getNvalue() {
        return nvalue;
    }

    public void setNvalue(String nvalue) {
        this.nvalue = nvalue;
    }

    public String getCvalue() {
        return cvalue;
    }

    public void setCvalue(String cvalue) {
        this.cvalue = cvalue;
    }

    public String getMvalue() {
        return mvalue;
    }

    public void setMvalue(String mvalue) {
        this.mvalue = mvalue;
    }

    public String getDoctor() {
        return doctor;
    }

    public void setDoctor(String doctor) {
        this.doctor = doctor;
    }

    public String getDeptcode() {
        return deptcode;
    }

    public void setDeptcode(String deptcode) {
        this.deptcode = deptcode;
    }

    public String getDoctordm() {
        return doctordm;
    }

    public void setDoctordm(String doctordm) {
        this.doctordm = doctordm;
    }

}

