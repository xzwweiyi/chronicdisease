package com.dchealth.etl.domain.target;

import com.dchealth.etl.domain.BaseEntity;

import java.util.Date;
import java.io.Serializable;

/**
 * 唐都-辅助检查-心电图等其他项目表(TdAuxiliaryExaminationOther)实体类
 *
 * @author makejava
 * @since 2023-03-29 16:20:11
 */
public class TdAuxiliaryExaminationOther extends BaseEntity implements Serializable {
    private static final long serialVersionUID = 916565745551845266L;
    /**
     * 自增主键
     */
    private Integer id;
    /**
     * 体检申请id
     */
    private String studyId;
    /**
     * 病人标识id
     */
    private String patientId;
    /**
     * 健康档案检查申请号
     */
    private String examNo;
    /**
     * 健康档案检验申请号
     */
    private String testNo;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 修改时间
     */
    private Date updateTime;
    /**
     * 报告时间
     */
    private Date resultTime;
    /**
     * 心电图
     */
    private String ecg;
    /**
     * 普通肠镜
     */
    private String conventionalEnteroscope;
    /**
     * 无痛胃镜
     */
    private String painlessGastroscope;
    /**
     * 无痛胃肠镜
     */
    private String painlessGastroenteroscopy;

    /**
     * 浅表器官（包块）
     */
    private String superficialOrgan;
    /**
     * 骨密度测定（全身骨密）
     */
    private String boneMineralDensity;
    /**
     * C13呼气试验检测
     */
    private String c13BreathTest;
    /**
     * 普通胃镜
     */
    private String generalGastroscope;
    /**
     * 无痛肠镜
     */
    private String painlessColonoscopy;
    /**
     * 无痛胃肠镜加
     */
    private String painlessGastroscopyPlus;

    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getPatientId() {
        return patientId;
    }

    public void setPatientId(String patientId) {
        this.patientId = patientId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public Date getResultTime() {
        return resultTime;
    }

    public void setResultTime(Date resultTime) {
        this.resultTime = resultTime;
    }

    public String getEcg() {
        return ecg;
    }

    public void setEcg(String ecg) {
        this.ecg = ecg;
    }

    public String getConventionalEnteroscope() {
        return conventionalEnteroscope;
    }

    public void setConventionalEnteroscope(String conventionalEnteroscope) {
        this.conventionalEnteroscope = conventionalEnteroscope;
    }

    public String getPainlessGastroscope() {
        return painlessGastroscope;
    }

    public void setPainlessGastroscope(String painlessGastroscope) {
        this.painlessGastroscope = painlessGastroscope;
    }

    public String getPainlessGastroenteroscopy() {
        return painlessGastroenteroscopy;
    }

    public void setPainlessGastroenteroscopy(String painlessGastroenteroscopy) {
        this.painlessGastroenteroscopy = painlessGastroenteroscopy;
    }

    public String getSuperficialOrgan() {
        return superficialOrgan;
    }

    public void setSuperficialOrgan(String superficialOrgan) {
        this.superficialOrgan = superficialOrgan;
    }

    public String getBoneMineralDensity() {
        return boneMineralDensity;
    }

    public void setBoneMineralDensity(String boneMineralDensity) {
        this.boneMineralDensity = boneMineralDensity;
    }

    public String getC13BreathTest() {
        return c13BreathTest;
    }

    public void setC13BreathTest(String c13BreathTest) {
        this.c13BreathTest = c13BreathTest;
    }

    public String getGeneralGastroscope() {
        return generalGastroscope;
    }

    public void setGeneralGastroscope(String generalGastroscope) {
        this.generalGastroscope = generalGastroscope;
    }

    public String getPainlessColonoscopy() {
        return painlessColonoscopy;
    }

    public void setPainlessColonoscopy(String painlessColonoscopy) {
        this.painlessColonoscopy = painlessColonoscopy;
    }

    public String getPainlessGastroscopyPlus() {
        return painlessGastroscopyPlus;
    }

    public void setPainlessGastroscopyPlus(String painlessGastroscopyPlus) {
        this.painlessGastroscopyPlus = painlessGastroscopyPlus;
    }
}

