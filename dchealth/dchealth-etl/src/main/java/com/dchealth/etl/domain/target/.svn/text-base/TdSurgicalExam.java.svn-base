package com.dchealth.etl.domain.target;

import java.io.Serializable;

/**
 * 外科检查表(TdSurgicalExam)实体类
 *
 * @author makejava
 * @since 2023-04-07 14:31:50
 */
public class TdSurgicalExam implements Serializable {
    private static final long serialVersionUID = 143181577213697586L;
    
    private Integer id;
    /**
     * 体检Id
     */
    private String studyId;
    /**
     * 检查序号
     */
    private String examNo;
    /**
     * 检验序号
     */
    private String testNo;
    /**
     * 结果正常标志 高，字段以逗号分隔保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 高，字段以逗号分隔保存
     */
    private String abnormalIndicatorLow;
    /**
     * 创建时间
     */
    private String createTime;
    /**
     * 更新时间
     */
    private String updateTime;
    /**
     * 皮肤
     */
    private String skin;
    /**
     * 肛门
     */
    private String anus;
    /**
     * 表浅淋巴结
     */
    private String superficialLymphNode;
    /**
     * 甲状腺
     */
    private String thyroid;
    /**
     * 脊柱
     */
    private String spine;
    /**
     * 四肢关节
     */
    private String articulationOfLimbs;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public String getCreateTime() {
        return createTime;
    }

    public void setCreateTime(String createTime) {
        this.createTime = createTime;
    }

    public String getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(String updateTime) {
        this.updateTime = updateTime;
    }

    public String getSkin() {
        return skin;
    }

    public void setSkin(String skin) {
        this.skin = skin;
    }

    public String getAnus() {
        return anus;
    }

    public void setAnus(String anus) {
        this.anus = anus;
    }

    public String getSuperficialLymphNode() {
        return superficialLymphNode;
    }

    public void setSuperficialLymphNode(String superficialLymphNode) {
        this.superficialLymphNode = superficialLymphNode;
    }

    public String getThyroid() {
        return thyroid;
    }

    public void setThyroid(String thyroid) {
        this.thyroid = thyroid;
    }

    public String getSpine() {
        return spine;
    }

    public void setSpine(String spine) {
        this.spine = spine;
    }

    public String getArticulationOfLimbs() {
        return articulationOfLimbs;
    }

    public void setArticulationOfLimbs(String articulationOfLimbs) {
        this.articulationOfLimbs = articulationOfLimbs;
    }

}

