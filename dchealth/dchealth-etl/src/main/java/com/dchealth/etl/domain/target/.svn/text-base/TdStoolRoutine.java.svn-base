package com.dchealth.etl.domain.target;

import java.util.Date;
import java.io.Serializable;

/**
 * 便常规(TdStoolRoutine)实体类
 *
 * @author makejava
 * @since 2023-04-04 10:42:39
 */
public class TdStoolRoutine implements Serializable {
    private static final long serialVersionUID = 697170060529635534L;
    
    private Integer id;
    /**
     * 体检Id
     */
    private String studyId;
    /**
     * 检查序号
     */
    private String examNo;
    /**
     * 检验序号
     */
    private String testNo;
    /**
     * 结果正常标志 高，字段以逗号分隔保存
     */
    private String abnormalIndicatorHigh;
    /**
     * 结果正常标志 低，字段以逗号分隔保存
     */
    private String abnormalIndicatorLow;
    /**
     * 创建时间
     */
    private Date createTime;
    /**
     * 更新时间
     */
    private Date updateTime;
    /**
     * 便颜色
     */
    private String stoolColor;
    /**
     * 便性状
     */
    private String stoolConsistency;
    /**
     * 便红细胞
     */
    private String stoolRedCells;
    /**
     * 便白细胞
     */
    private String stoolWhiteCells;
    /**
     * 蛔虫卵
     */
    private String stoolParasiteEgg;
    /**
     * 鞭虫卵
     */
    private String stoolParasiteEggB;
    /**
     * 蛲虫卵
     */
    private String stoolParasiteEggR;
    /**
     * 绦虫卵
     */
    private String stoolParasiteEggT;


    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getStudyId() {
        return studyId;
    }

    public void setStudyId(String studyId) {
        this.studyId = studyId;
    }

    public String getExamNo() {
        return examNo;
    }

    public void setExamNo(String examNo) {
        this.examNo = examNo;
    }

    public String getTestNo() {
        return testNo;
    }

    public void setTestNo(String testNo) {
        this.testNo = testNo;
    }

    public String getAbnormalIndicatorHigh() {
        return abnormalIndicatorHigh;
    }

    public void setAbnormalIndicatorHigh(String abnormalIndicatorHigh) {
        this.abnormalIndicatorHigh = abnormalIndicatorHigh;
    }

    public String getAbnormalIndicatorLow() {
        return abnormalIndicatorLow;
    }

    public void setAbnormalIndicatorLow(String abnormalIndicatorLow) {
        this.abnormalIndicatorLow = abnormalIndicatorLow;
    }

    public Date getCreateTime() {
        return createTime;
    }

    public void setCreateTime(Date createTime) {
        this.createTime = createTime;
    }

    public Date getUpdateTime() {
        return updateTime;
    }

    public void setUpdateTime(Date updateTime) {
        this.updateTime = updateTime;
    }

    public String getStoolColor() {
        return stoolColor;
    }

    public void setStoolColor(String stoolColor) {
        this.stoolColor = stoolColor;
    }

    public String getStoolConsistency() {
        return stoolConsistency;
    }

    public void setStoolConsistency(String stoolConsistency) {
        this.stoolConsistency = stoolConsistency;
    }

    public String getStoolRedCells() {
        return stoolRedCells;
    }

    public void setStoolRedCells(String stoolRedCells) {
        this.stoolRedCells = stoolRedCells;
    }

    public String getStoolWhiteCells() {
        return stoolWhiteCells;
    }

    public void setStoolWhiteCells(String stoolWhiteCells) {
        this.stoolWhiteCells = stoolWhiteCells;
    }

    public String getStoolParasiteEgg() {
        return stoolParasiteEgg;
    }

    public void setStoolParasiteEgg(String stoolParasiteEgg) {
        this.stoolParasiteEgg = stoolParasiteEgg;
    }

    public String getStoolParasiteEggB() {
        return stoolParasiteEggB;
    }

    public void setStoolParasiteEggB(String stoolParasiteEggB) {
        this.stoolParasiteEggB = stoolParasiteEggB;
    }

    public String getStoolParasiteEggR() {
        return stoolParasiteEggR;
    }

    public void setStoolParasiteEggR(String stoolParasiteEggR) {
        this.stoolParasiteEggR = stoolParasiteEggR;
    }

    public String getStoolParasiteEggT() {
        return stoolParasiteEggT;
    }

    public void setStoolParasiteEggT(String stoolParasiteEggT) {
        this.stoolParasiteEggT = stoolParasiteEggT;
    }

}

