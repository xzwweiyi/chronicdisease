import request from '@/utils/request'

// 查询【病种】列表  --分页
export function listDiseasesGroupsPages(query) {
    return request ({
        url: '/diseases/groups/listPage',
        method: 'get',
        params: query,
    })
}

// 查询【病种】列表
export function listDiseasesGroups(data) {
    return request ({
        url: '/diseases/groups/list',
        method: 'post',
        data: data,
    })
}

// 添加【病种】接口
export function addDiseasesGroups(data) {
    return request ({
        url: '/diseases/groups/add',
        method: 'post',
        data: data,
    })
}

// 修改【病种】接口
export function updateDiseasesGroups(data) {
    return request ({
        url: '/diseases/groups/update',
        method: 'post',
        data: data,
    })
}

// 删除【病种】接口
export function delDiseasesGroups(data) {
    return request ({
        url: '/diseases/groups/delete',
        method: 'post',
        data: data,
    })
}